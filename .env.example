# website-designer environment-specific settings
# Copy to `.env` and fill for THIS machine. Never commit `.env`.

# Optional: absolute path to this repo (default = auto-detect from scripts/)
# WEB_DESIGNER_ROOT=/path/to/website-designer

# Host used in preview / report URLs (Tailscale MagicDNS name or Tailscale IP)
WEB_DESIGNER_PREVIEW_HOST=127.0.0.1
WEB_DESIGNER_PREVIEW_SCHEME=http
WEB_DESIGNER_PREVIEW_PORT=4321
WEB_DESIGNER_REPORT_PORT=8766

# Optional full base overrides (win over host+port composition)
# WEB_DESIGNER_PREVIEW_BASE=http://mac-mini.tailXXXX.ts.net:4321
# WEB_DESIGNER_REPORT_BASE=http://mac-mini.tailXXXX.ts.net:8766

# 実装に使うモデル一覧 CSV（既定 `a,b` = ディレクション2案）
WEB_DESIGNER_MODELS=a,b
