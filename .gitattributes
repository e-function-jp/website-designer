# 改行コード: シェルスクリプトは LF 固定 (CRLF 改行での shebang 実行を防ぐ)
*.sh text eol=lf

# ソース・設定・ドキュメント系も LF 推奨 (チェックアウト時の CRLF 化を防ぐ)
