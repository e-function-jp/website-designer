*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.py text eol=lf
*.toml text eol=lf
*.csv text eol=lf
*.svg text eol=lf
*.txt text eol=lf
*.env text eol=lf
*.gitignore text eol=lf
*.gitattributes text eol=lf

