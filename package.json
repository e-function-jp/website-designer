{
  "name": "website-designer",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check:web": "npm run build && node scripts/web-quality-check.mjs",
    "check:web:strict": "npm run build && node scripts/web-quality-check.mjs --strict",
    "check:catalog": "node scripts/web-check-component-catalog.mjs",
    "next:run": "python3 scripts/web-learning-next.py",
    "archive:fetch": "python3 site_archive/fetch_site_archive.py",
    "urls": "python3 scripts/web-preview-urls.py --discover --json",
    "check:render": "node scripts/web-render-check.mjs",
    "check:all": "npm run check:web && npm run check:render && npm run check:catalog"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.4",
    "@tailwindcss/vite": "4.2.2",
    "astro": "6.0.8",
    "daisyui": "5.5.19",
    "gsap": "^3.15.0",
    "tailwindcss": "4.2.2"
  },
  "devDependencies": {
    "playwright": "^1.61.1"
  },
  "overrides": {
    "vite": "^7.3.1"
  }
}
