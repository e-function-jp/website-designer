---
/**
 * Marquee.astro
 *
 * 無限スクロールマーキー (ロゴ列・テキスト列用)。
 * 純粋な CSS アニメーションで動作 (JS 不要)。
 * Awwwards では賞ロゴ・パートナー表示・キャッチコピーなどで頻出。
 *
 * 使用例:
 *   <Marquee speed={30} pauseOnHover>
 *     <img src="/logo1.svg" />
 *     <img src="/logo2.svg" />
 *     <img src="/logo3.svg" />
 *   </Marquee>
 *
 *   <Marquee reverse direction="vertical" speed={20}>
 *     <span>アイテム 1</span>
 *     <span>アイテム 2</span>
 *   </Marquee>
 *
 * props:
 *   speed: 1 周する秒数 (default: 30) - 小さいほど速い
 *   direction: 'horizontal' (default) | 'vertical'
 *   reverse: true で逆方向
 *   pauseOnHover: ホバーで一時停止
 *   gap: アイテム間隔 px (default: 48)
 *   mask: true で両端フェードマスク (default: true)
 *   as: 出力タグ (default: 'div')
 *   class: 追加クラス
 */

interface Props {
  speed?: number;
  direction?: 'horizontal' | 'vertical';
  reverse?: boolean;
  pauseOnHover?: boolean;
  gap?: number;
  mask?: boolean;
  /** vertical 時のコンテナ高さ (px)。指定しなければ 300px */
  height?: number;
  as?: string;
  class?: string;
  id?: string;
}

const {
  speed = 30,
  direction = 'horizontal',
  reverse = false,
  pauseOnHover = false,
  gap = 48,
  mask = true,
  height,
  as: Tag = 'div',
  class: className = '',
  id,
} = Astro.props;

const styleAttr = [
  '--marquee-duration: ' + speed + 's',
  '--marquee-gap: ' + gap + 'px',
  '--marquee-direction: ' + (reverse ? 'reverse' : 'normal'),
  height ? '--marquee-height: ' + height + 'px' : '',
].filter(Boolean).join('; ');
---

<Tag
  class:list={[
    'lp-marquee',
    `lp-marquee--${direction}`,
    reverse && 'lp-marquee--reverse',
    pauseOnHover && 'lp-marquee--pause-hover',
    mask && 'lp-marquee--mask',
    className,
  ]}
  style={styleAttr}
  id={id}
>
  <div class="lp-marquee__track">
    <div class="lp-marquee__group">
      <slot />
    </div>
    <!-- 重複側は aria-hidden + inert で重複 a11y/タブ順を完全に避ける -->
    <div class="lp-marquee__group" aria-hidden="true" inert>
      <slot />
    </div>
  </div>
</Tag>

<style>
  .lp-marquee {
    --marquee-duration: 30s;
    --marquee-gap: 48px;
    --marquee-direction: normal;
    overflow: hidden;
    position: relative;
  }

  /* 両端フェードマスク (横方向デフォルト) */
  .lp-marquee--mask::before,
  .lp-marquee--mask::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 80px;
    pointer-events: none;
    z-index: 1;
  }
  .lp-marquee--mask::before {
    left: 0;
    background: linear-gradient(to right, var(--color-base-100, white), transparent);
  }
  .lp-marquee--mask::after {
    right: 0;
    background: linear-gradient(to left, var(--color-base-100, white), transparent);
  }

  /* 縦方向用マスク (上下フェード) */
  .lp-marquee--vertical.lp-marquee--mask::before,
  .lp-marquee--vertical.lp-marquee--mask::after {
    top: 0;
    bottom: auto;
    left: 0;
    right: 0;
    width: 100%;
    height: 80px;
  }
  .lp-marquee--vertical.lp-marquee--mask::before {
    top: 0;
    background: linear-gradient(to bottom, var(--color-base-100, white), transparent);
  }
  .lp-marquee--vertical.lp-marquee--mask::after {
    bottom: 0;
    top: auto;
    background: linear-gradient(to top, var(--color-base-100, white), transparent);
  }

  .lp-marquee__track {
    display: flex;
    width: max-content;
    animation: lp-marquee-scroll var(--marquee-duration) linear infinite;
    animation-direction: var(--marquee-direction);
  }

  /* 縦方向: コンテナに明示的高さが必要 (デフォルト 300px) */
  .lp-marquee--vertical {
    height: var(--marquee-height, 300px);
  }
  .lp-marquee--vertical .lp-marquee__track {
    flex-direction: column;
    width: 100%;
    height: max-content;
  }
  @keyframes lp-marquee-scroll {
    from { transform: translateX(0); }
    to { transform: translateX(-50%); }
  }
  .lp-marquee--vertical @keyframes lp-marquee-scroll {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  .lp-marquee--vertical .lp-marquee__track {
    animation-name: lp-marquee-scroll-v;
  }
  @keyframes lp-marquee-scroll-v {
    from { transform: translateY(0); }
    to { transform: translateY(-50%); }
  }

  .lp-marquee__group {
    display: flex;
    align-items: center;
    gap: var(--marquee-gap);
    padding-right: var(--marquee-gap);
    flex-shrink: 0;
  }

  .lp-marquee--vertical .lp-marquee__group {
    flex-direction: column;
    padding-right: 0;
    padding-bottom: var(--marquee-gap);
  }

  /* ホバーで一時停止 */
  .lp-marquee--pause-hover:hover .lp-marquee__track {
    animation-play-state: paused;
  }

  /* reduced-motion: 完全停止 */
  @media (prefers-reduced-motion: reduce) {
    .lp-marquee__track {
      animation: none !important;
    }
  }
</style>
