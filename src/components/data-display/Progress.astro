---
interface Props { value?: number; max?: number; variant?: 'primary' | 'secondary' | 'accent' | 'info' | 'success' | 'warning' | 'error'; class?: string }
const { value = 0, max = 100, variant = 'primary', class: className = '' } = Astro.props;
---
<progress class={`progress progress-${variant} ${className}`} value={value} max={max}></progress>
