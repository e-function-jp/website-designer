---
interface Props { days?: number; hours?: number; minutes?: number; seconds?: number; class?: string }
const { days = 0, hours = 0, minutes = 0, seconds = 0, class: className = '' } = Astro.props;
---
<div class={`grid grid-flow-col gap-5 text-center auto-cols-max ${className}`}>
  {days > 0 && <div class="flex flex-col"><span class="countdown font-mono text-5xl"><span style={`--value:${days};`}></span></span>日</div>}
  <div class="flex flex-col"><span class="countdown font-mono text-5xl"><span style={`--value:${hours};`}></span></span>時間</div>
  <div class="flex flex-col"><span class="countdown font-mono text-5xl"><span style={`--value:${minutes};`}></span></span>分</div>
  <div class="flex flex-col"><span class="countdown font-mono text-5xl"><span style={`--value:${seconds};`}></span></span>秒</div>
</div>
