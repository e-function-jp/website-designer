---
/**
 * サイト共通ヘッダー。全ページで同一の nav を描画する。
 *
 * website の品質は「全ページで同じグローバルナビが出ているか」「現在地が
 * 分かるか」に強く依存する。ページごとに手書きすると必ずズレるので、
 * ここ 1 箇所で描画し、現在地は `path` から自動判定する。
 *
 * ## カプセル変種
 *
 * theme === 'kido-corporate' のときは中央固定のカプセル型に切り替える。
 * これは sample-site 固有の意匠であり、SiteHeader 内にテーマ分岐として持つ
 * （テーマ範囲限定の追加であり、DaisyUI 共通クラスの上書きではない）。
 * 他のテーマの挙動は変えない。
 */
import type { SiteConfig } from '../../lib/site';
import { url } from '../../lib/site';
import Marquee from '../animations/Marquee.astro';

interface Props {
  site: SiteConfig;
  /** 現在ページの base 相対パス */
  path?: string;
  variant?: 'default' | 'capsule';
}
const { site, path = '/', variant } = Astro.props;

// スクロール時の挙動はサイト定義で 1 箇所に持つ。
// 参照サイトの実測（web-analyze-reference-motion.mjs の header_behavior）を写す。
const headerMotion = site.motion?.header ?? 'none';

// theme === 'kido-corporate' のときだけ中央固定カプセルを使う。
const useCapsule = variant === 'capsule' || site.theme === 'kido-corporate';

const norm = (p: string) => ('/' + p.replace(/^\//, '').replace(/\/$/, '')).replace(/^\/$/, '/');
const current = norm(path);
const isCurrent = (href: string) => {
  const h = norm(href);
  return h === '/' ? current === '/' : current === h || current.startsWith(h + '/');
};

// 商号を2行に分割（モバイルの指示: 「軌道セールス設計」「株式会社」）
const [nameMain, nameSuffix] = site.name.includes('株式会社')
  ? [site.name.replace(/株式会社$/, ''), '株式会社']
  : [site.name, ''];
---

{useCapsule ? (
  <header
    class:list={[
      'kido-capsule-header',
      headerMotion === 'solid' && 'kido-capsule-header--solid',
    ]}
    data-header-motion={headerMotion}
    data-capsule="1"
  >
    <div class="kido-capsule-header__bar" role="navigation" aria-label="グローバルナビゲーション（カプセル）">
      <a
        href={url(site, '/')}
        class="kido-capsule-header__brand"
        aria-current={current === '/' ? 'page' : undefined}
      >
        <span class="kido-capsule-header__brand-main">{nameMain}</span>
        {nameSuffix && <span class="kido-capsule-header__brand-suffix">{nameSuffix}</span>}
      </a>

      <details class="kido-capsule-header__menu">
        <summary class="kido-capsule-header__menu-toggle" aria-label="メニューを開く">
          <span class="kido-capsule-header__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
          </span>
          <span class="kido-capsule-header__menu-label">メニュー</span>
        </summary>
        <nav class="kido-capsule-header__panel" aria-label="ナビゲーション">
          <ul>
            {site.nav.map((item) => (
              <li>
                <a
                  href={url(site, item.href)}
                  class:list={[isCurrent(item.href) && 'is-current']}
                  aria-current={isCurrent(item.href) ? 'page' : undefined}
                >
                  {item.label}
                </a>
              </li>
            ))}
            {site.primaryCta && (
              <li class="kido-capsule-header__cta-item">
                <a href={url(site, site.primaryCta.href)} class="kido-capsule-header__panel-cta">
                  {site.primaryCta.label}
                </a>
              </li>
            )}
          </ul>
        </nav>
      </details>

      {site.primaryCta && (
        <a href={url(site, site.primaryCta.href)} class="kido-capsule-header__cta">
          {site.primaryCta.label}
        </a>
      )}
    </div>
  </header>
) : (
  <>
  {site.theme === 'shirosumi-calm' && (
    <div class="shirosumi-announcement" aria-label="クリニックからのお知らせ">
      <Marquee speed={30} gap={56} mask={false}><span>港区のメディカル美容と予防ウェルネス — 白澄メディウェル</span><span aria-hidden="true">・</span></Marquee>
    </div>
  )}
  <header
    class:list={[
      'site-header sticky top-0 z-40 border-b border-base-300',
      headerMotion === 'solid' ? 'site-header--solid' : 'bg-base-100/95 backdrop-blur',
      headerMotion === 'shrink' && 'site-header--shrink',
      headerMotion === 'hide' && 'site-header--hide',
    ]}
    data-header-motion={headerMotion}
  >
    <div class="max-w-7xl mx-auto px-4 h-16 flex items-center gap-4">
      <a
        href={url(site, '/')}
        class="font-bold text-lg tracking-tight shrink-0"
        aria-current={current === '/' ? 'page' : undefined}
      >{site.name}</a>

      <nav class="hidden lg:flex items-center gap-1 ml-auto" aria-label="グローバルナビゲーション">
        {site.nav.map((item) => (
          <a
            href={url(site, item.href)}
            class:list={['px-3 py-2 text-sm rounded-lg hover:bg-base-200 transition-colors', isCurrent(item.href) && 'font-bold text-primary']}
            aria-current={isCurrent(item.href) ? 'page' : undefined}
          >
            {item.label}
          </a>
        ))}
      </nav>

      {site.primaryCta && (
        <>
          {site.theme === 'noxray-corporate' && (
            <a href={url(site, '/download/#company')} class="btn btn-outline btn-sm hidden lg:inline-flex">
              会社資料を見る
            </a>
          )}
          <a href={url(site, site.primaryCta.href)} class="btn btn-primary btn-sm hidden lg:inline-flex">
            {site.primaryCta.label}
          </a>
        </>
      )}

      <!-- モバイル: details/summary の CSS-only ドロワー。JS を足さない -->
      <details class="dropdown dropdown-end lg:hidden ml-auto">
        <summary class="btn btn-ghost btn-square" aria-label="メニューを開く">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </summary>
        <nav class="dropdown-content mt-2 w-64 bg-base-100 rounded-box shadow-xl border border-base-300 p-2" aria-label="モバイルナビゲーション">
          {site.nav.map((item) => (
            <a
              href={url(site, item.href)}
              class:list={['block px-3 py-2 rounded-lg hover:bg-base-200', isCurrent(item.href) && 'font-bold text-primary']}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
          ))}
          {site.primaryCta && (
            <a href={url(site, site.primaryCta.href)} class="btn btn-primary btn-sm w-full mt-2">
              {site.primaryCta.label}
            </a>
          )}
        </nav>
      </details>
    </div>
  </header>
  </>
)}

<style>
  .site-header { transition: height .3s ease, background-color .3s ease, transform .3s ease, box-shadow .3s ease; }
  .shirosumi-announcement { height:24px; overflow:hidden; background:#efe6dc; color:#3d2a22; font-size:13px; line-height:24px; }

  /* solid: 最上部では透過、スクロールすると背景を敷く */
  .site-header--solid { background-color: transparent; }
  .site-header--solid.is-scrolled {
    background-color: color-mix(in oklab, var(--color-base-100) 95%, transparent);
    backdrop-filter: blur(8px);
    box-shadow: 0 1px 12px rgb(0 0 0 / 6%);
  }

  /* shrink: スクロールすると高さを詰める */
  .site-header--shrink > :global(div) { transition: height .3s ease; }
  .site-header--shrink.is-scrolled > :global(div) { height: 3.25rem; }

  /* hide: 下方向スクロールで隠し、上方向で戻す */
  .site-header--hide.is-hidden { transform: translateY(-100%); }

  @media (prefers-reduced-motion: reduce) {
    .site-header, .site-header > :global(div) { transition: none; }
    .site-header--hide.is-hidden { transform: none; }
  }

  /* ===== Capsule header（kido-corporate のみ） ============================ */

  .kido-capsule-header {
    position: fixed;
    top: 16px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 40;
    width: min(680px, calc(100% - 40px));
    max-width: calc(100% - 40px);
    pointer-events: none;
  }
  .kido-capsule-header__bar {
    pointer-events: auto;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 12px;
    height: 64px;
    padding: 0 20px 0 24px;
    background: var(--color-base-100);
    color: var(--color-base-content);
    border-radius: 32px;
    box-shadow: 0 8px 24px rgb(15 30 50 / 12%), 0 2px 6px rgb(15 30 50 / 6%);
  }

  .kido-capsule-header__brand {
    display: flex;
    flex-direction: column;
    justify-content: center;
    line-height: 1.15;
    color: var(--color-primary);
    text-decoration: none;
    min-width: 0;
  }
  .kido-capsule-header__brand-main {
    font-size: 15px;
    font-weight: 700;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .kido-capsule-header__brand-suffix {
    font-size: 11px;
    font-weight: 700;
    color: var(--color-base-content);
    opacity: 0.65;
    margin-top: 1px;
  }

  .kido-capsule-header__menu {
    position: relative;
  }
  .kido-capsule-header__menu-toggle {
    list-style: none;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 14px;
    cursor: pointer;
    border-radius: 999px;
    color: var(--color-base-content);
    user-select: none;
    font-size: 13px;
    font-weight: 600;
  }
  .kido-capsule-header__menu-toggle::-webkit-details-marker { display: none; }
  .kido-capsule-header__menu-toggle:hover { background: var(--color-base-200); }
  .kido-capsule-header__menu-icon {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 18px;
    height: 18px;
  }
  .kido-capsule-header__menu-icon span {
    display: block;
    height: 2px;
    background: currentColor;
    border-radius: 2px;
  }

  .kido-capsule-header__panel {
    position: absolute;
    top: calc(100% + 8px);
    left: 50%;
    transform: translateX(-50%);
    width: min(680px, calc(100vw - 40px));
    background: var(--color-base-100);
    border-radius: 16px;
    box-shadow: 0 16px 32px rgb(15 30 50 / 14%);
    padding: 8px 0;
    z-index: 41;
  }
  .kido-capsule-header__panel ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .kido-capsule-header__panel a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
    padding: 0 24px;
    color: var(--color-base-content);
    text-decoration: none;
    font-size: 15px;
    border-bottom: 1px solid var(--color-base-200);
  }
  .kido-capsule-header__panel li:last-child a { border-bottom: none; }
  .kido-capsule-header__panel a:hover { background: var(--color-base-200); }
  .kido-capsule-header__panel a.is-current {
    color: var(--color-primary);
    font-weight: 700;
  }
  .kido-capsule-header__panel-cta {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    margin: 8px 24px 0;
    background: var(--color-secondary);
    color: var(--color-secondary-content);
    border-radius: 8px;
    font-weight: 700;
    text-decoration: none;
  }
  .kido-capsule-header__panel-cta:hover { opacity: 0.92; }

  .kido-capsule-header__cta {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;
    gap: 8px;
    padding: 0 18px;
    height: 40px;
    background: var(--color-secondary);
    color: var(--color-secondary-content);
    border-radius: 999px;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .kido-capsule-header__cta:hover { opacity: 0.92; }

  /* モバイル: 右の主要CTAは隠す。下部の固定帯へ移す */
  @media (max-width: 767px) {
    .kido-capsule-header {
      width: calc(100% - 40px);
      max-width: 350px;
      top: 16px;
    }
    .kido-capsule-header__bar {
      grid-template-columns: 1fr auto;
      gap: 8px;
      padding: 0 8px 0 16px;
      height: 64px;
    }
    .kido-capsule-header__brand-main {
      font-size: 14px;
    }
    .kido-capsule-header__brand-suffix {
      font-size: 10px;
    }
    .kido-capsule-header__cta {
      display: none;
    }
    .kido-capsule-header__menu-toggle {
      min-width: 48px;
      height: 48px;
      padding: 0;
      justify-content: center;
    }
    .kido-capsule-header__menu-label {
      position: absolute;
      width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden;
      clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
    }
    .kido-capsule-header__panel {
      width: calc(100vw - 32px);
      max-height: calc(100dvh - 112px);
      overflow-y: auto;
    }
  }

  /* reduced-motion: 変形・トランジションを切る */
  @media (prefers-reduced-motion: reduce) {
    .kido-capsule-header,
    .kido-capsule-header > * {
      transition: none !important;
      animation: none !important;
    }
  }
</style>

<script>
  const initHeader = () => {
    const el = document.querySelector<HTMLElement>('.site-header');
    if (!el || el.dataset.headerMotion === 'none' || el.dataset.headerReady) return;
    el.dataset.headerReady = '1';
    let lastY = window.scrollY;
    const onScroll = () => {
      const y = window.scrollY;
      el.classList.toggle('is-scrolled', y > 8);
      if (el.dataset.headerMotion === 'hide') {
        // 上方向へのスクロールと、最上部付近では必ず出す
        el.classList.toggle('is-hidden', y > lastY && y > 160);
      }
      lastY = y;
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  };
  initHeader();
  document.addEventListener('astro:page-load', initHeader);

  // カプセルヘッダー: メニュー外側クリック・Esc・リンク選択で閉じる。
  const initCapsule = () => {
    const detailsList = document.querySelectorAll<HTMLDetailsElement>('.kido-capsule-header__menu');
    detailsList.forEach((details) => {
      if (details.dataset.capsuleReady) return;
      details.dataset.capsuleReady = '1';
      const toggle = details.querySelector<HTMLElement>('summary');
      const panel = details.querySelector<HTMLElement>('.kido-capsule-header__panel');
      const close = () => {
        details.open = false;
        toggle?.setAttribute('aria-expanded', 'false');
      };
      const open = () => {
        details.open = true;
        toggle?.setAttribute('aria-expanded', 'true');
      };
      toggle?.addEventListener('click', (e) => {
        e.preventDefault();
        if (details.open) close(); else open();
      });
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.setAttribute('aria-haspopup', 'menu');
      toggle?.setAttribute('role', 'button');
      toggle?.setAttribute('tabindex', '0');

      // パネル内リンクを選択したら閉じる
      panel?.querySelectorAll('a').forEach((a) => {
        a.addEventListener('click', () => {
          setTimeout(() => {
            details.open = false;
            toggle?.focus();
          }, 0);
        });
      });

      // Esc で閉じてトリガーにフォーカス戻す
      details.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && details.open) {
          e.preventDefault();
          close();
          toggle?.focus();
        }
      });

      // 外側クリックで閉じる
      document.addEventListener('click', (e) => {
        if (!details.open) return;
        if (!details.contains(e.target as Node)) close();
      });
    });
  };
  initCapsule();
  document.addEventListener('astro:page-load', initCapsule);
</script>
