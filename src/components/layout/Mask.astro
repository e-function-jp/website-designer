---
interface Props { type?: 'squircle' | 'heart' | 'hexagon' | 'hexagon-2' | 'decagon' | 'pentagon' | 'diamond' | 'square' | 'circle' | 'parallelogram' | 'parallelogram-2' | 'parallelogram-3' | 'parallelogram-4' | 'star' | 'star-2' | 'triangle' | 'triangle-2' | 'triangle-3' | 'triangle-4'; class?: string }
const { type = 'squircle', class: className = '' } = Astro.props;
---
<div class={`mask mask-${type} ${className}`.trim()}>
  <slot />
</div>
