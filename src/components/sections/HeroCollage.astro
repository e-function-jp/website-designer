---
/**
 * HeroCollage — 冒険路線 b 案のファーストビュー。
 *
 * 注意: 右カラムは写真の上ではなく **ページ背景（base-100）の上** に載る。
 * ここに text-base-100 を当てると白地に白文字になり、キャッチと CTA が
 * コントラスト比 1.00 で完全に消える（実測で発生し、独立judge に
 * 「FVに事業内容が無い」と指摘されるまで気づけなかった）。
 * 文字色は base-content 系を使うこと。
 *
 * 画面 100% × 100vh、12 カラム分割、左 7 カラム＝写真 4 枚コラージュ、
 * 右 5 カラム＝和文キャッチ + 欧字 + ボタン。
 *
 * 写真コラージュの立ち上げは clip-up 700ms を左上→右上→左下→右下の
 * 順で stagger 90ms。キャッチは 400ms 遅延で fade 700ms。
 * 3 秒ごとのクロスフェードは行わない（a 案と差別化し、写真を静的に見せる）。
 *
 * reduced-motion: reduce では clip-path を初期 inset(0) に固定、stagger を 0、
 * キャッチは初期表示。
 */
import type { SiteConfig } from '../../lib/site';
import { url } from '../../lib/site';

interface HeroImage {
  src: string;
  alt: string;
  /** portrait / landscape / square — 各セルで aspect を意図的に変える */
  aspect: 'portrait' | 'landscape' | 'square';
}

interface Props {
  site: SiteConfig;
  images: HeroImage[];
  /** 和文キャッチ */
  catchCopy: string;
  /** 右半分の縦書き数字（例: "01 / 04"） */
  indexLabel?: string;
  duration?: number;
  stagger?: number;
}

const {
  site,
  images,
  catchCopy,
  indexLabel = '01 / 04',
  duration = 700,
  stagger = 90,
} = Astro.props;

const aspectClass: Record<HeroImage['aspect'], string> = {
  portrait: 'aspect-[2/3]',
  landscape: 'aspect-[3/2]',
  square: 'aspect-square',
};

// 4 枚前提。左上 portrait / 右上 square / 左下 landscape / 右下 portrait
// 仕様: 2 行 × 2 列、各セル間に 8px の雪白スリット
const layoutOrder: Array<'portrait' | 'square' | 'landscape' | 'portrait'> = [
  'portrait',
  'square',
  'landscape',
  'portrait',
];
---

<section class="hero-collage relative w-full min-h-[100vh] overflow-hidden" data-hc-stagger={stagger} data-hc-duration={duration}>
  <div class="hero-collage__grid relative grid grid-cols-1 lg:grid-cols-[7fr_5fr] gap-y-6 lg:gap-y-0 lg:gap-x-0 px-4 lg:px-12 py-16 lg:py-24 min-h-[100vh]">

    <!-- 左 7 カラム：写真 4 枚コラージュ（2 行 × 2 列） -->
    <div class="hero-collage__collage relative grid grid-cols-2 grid-rows-2 gap-2 lg:h-full self-stretch">
      {images.slice(0, 4).map((img, i) => (
        <figure
          class:list={[
            'hero-collage__cell relative overflow-hidden bg-base-300',
            aspectClass[layoutOrder[i] ?? img.aspect],
          ]}
          data-hc-cell={i}
          style={`--hc-delay: ${i * stagger}ms;`}
        >
          <img
            src={img.src}
            alt={img.alt}
            loading={i === 0 ? 'eager' : 'lazy'}
            width={i === 0 || layoutOrder[i] === 'landscape' ? 1200 : 800}
            height={i === 0 || layoutOrder[i] === 'landscape' ? 800 : 1200}
            class="absolute inset-0 w-full h-full object-cover"
          />
        </figure>
      ))}
    </div>

    <!-- 右 5 カラム：和文キャッチ + 欧字 + ボタン -->
    <div class="hero-collage__catch relative flex flex-col justify-center px-2 lg:pl-16 text-base-content">
      <p class="hero-collage__catch-eyebrow text-xs lg:text-sm tracking-[0.18em] uppercase opacity-90 mb-6" style="transition: opacity 700ms ease, transform 700ms ease;">
        EST. 2015 ／ HOKKAIDO ASAHIKAWA
      </p>
      <h1
        class="hero-collage__catch-title font-medium leading-[1.3] text-3xl md:text-5xl lg:text-[5.5rem]"
        style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif; letter-spacing: 0.02em;"
      >
        {catchCopy}
      </h1>
      <div class="hero-collage__catch-cta mt-10 flex items-center gap-4">
        {site.primaryCta && (
          <a
            href={url(site, site.primaryCta.href)}
            class="btn btn-primary btn-lg"
          >
            {site.primaryCta.label}
          </a>
        )}
      </div>
      <p
        class="hero-collage__catch-index absolute right-4 bottom-4 lg:right-8 lg:bottom-8 text-secondary text-sm font-bold tabular-nums opacity-90"
        style="writing-mode: vertical-rl;"
        aria-hidden="true"
      >
        {indexLabel}
      </p>
    </div>

  </div>
</section>

<style>
  /* ヒーロー写真コラージュ：clip-up で 4 枚を左上→右上→左下→右下の順に立ち上げ */
  .hero-collage__cell {
    clip-path: inset(100% 0 0 0);
    opacity: 0;
    transition:
      clip-path var(--hc-duration, 700ms) cubic-bezier(0.165, 0.84, 0.44, 1) var(--hc-delay, 0ms),
      opacity var(--hc-duration, 700ms) cubic-bezier(0.165, 0.84, 0.44, 1) var(--hc-delay, 0ms);
  }
  .hero-collage.is-ready .hero-collage__cell {
    clip-path: inset(0 0 0 0);
    opacity: 1;
  }

  /* キャッチ：400ms 遅延で fade 700ms */
  .hero-collage__catch-eyebrow,
  .hero-collage__catch-title,
  .hero-collage__catch-cta,
  .hero-collage__catch-index {
    opacity: 0;
    transform: translateY(16px);
  }
  .hero-collage.is-ready .hero-collage__catch-eyebrow {
    opacity: 0.9;
    transform: none;
    transition: opacity 700ms ease 400ms, transform 700ms ease 400ms;
  }
  .hero-collage.is-ready .hero-collage__catch-title {
    opacity: 1;
    transform: none;
    transition: opacity 700ms ease 500ms, transform 700ms ease 500ms;
  }
  .hero-collage.is-ready .hero-collage__catch-cta {
    opacity: 1;
    transform: none;
    transition: opacity 700ms ease 700ms, transform 700ms ease 700ms;
  }
  .hero-collage.is-ready .hero-collage__catch-index {
    opacity: 0.9;
    transform: none;
    transition: opacity 700ms ease 800ms;
  }

  /* reduced-motion: 初期表示のまま（clip-path / opacity を初期状態へ固定） */
  @media (prefers-reduced-motion: reduce) {
    .hero-collage__cell {
      clip-path: inset(0 0 0 0) !important;
      opacity: 1 !important;
      transition: none !important;
    }
    .hero-collage__catch-eyebrow,
    .hero-collage__catch-title,
    .hero-collage__catch-cta,
    .hero-collage__catch-index {
      opacity: 1 !important;
      transform: none !important;
      transition: none !important;
    }
    .hero-collage__catch-eyebrow { opacity: 0.9 !important; }
    .hero-collage__catch-index { opacity: 0.9 !important; }
  }
</style>

<script>
  const init = () => {
    const root = document.querySelector<HTMLElement>('.hero-collage:not([data-hc-ready])');
    if (!root) return;
    root.setAttribute('data-hc-ready', '1');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('is-ready');
      return;
    }
    // 初期描画：レイアウト確定後に clip-path を解放する
    requestAnimationFrame(() => {
      requestAnimationFrame(() => {
        root.classList.add('is-ready');
      });
    });
  };
  init();
  document.addEventListener('astro:page-load', init);
</script>
