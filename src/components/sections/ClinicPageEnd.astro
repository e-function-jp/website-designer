---
/**
 * ClinicPageEnd — 全ページ末尾の共通セクション。
 *
 * ディレクションの指示:
 *   1. 相談帯: 青い全幅面。PC 高 300px、左 55% に「歯並み〜」、右 45% に CTA。
 *      /contact/ のみ主ボタン「予約受付状況を確認する」→/contact/#reservation。
 *   2. 医院情報: 白背景、max-width 1100px。Table で医院名/所在地/設立。右にベージュ案内枠。
 *   3. サンプル注記: フッター末尾 14px。
 *
 * 既存 SiteFooter は SiteLayout 側で描画するので、ここでは
 * 「相談帯」「医院情報」「サンプル注記」の 3 つを返す。
 * SiteFooter 標準の主 CTA はこのセクションが引き受ける（重複を避ける）。
 */
import type { SiteConfig } from '../../lib/site';
import { url } from '../../lib/site';
import ScrollReveal from '../ui/ScrollReveal.astro';
import Table from '../data-display/Table.astro';

interface Props {
  site: SiteConfig;
  /** ページが /contact/ のときは true。主ボタンのラベル/遷移先が変わる */
  isContactPage?: boolean;
}

const { site, isContactPage = false } = Astro.props;

const profile = [
  { k: '医院名', v: site.organization?.legalName ?? site.name },
  { k: '所在地', v: site.organization?.address ?? '静岡県藤枝市' },
  { k: '設立', v: site.organization?.founded ? `${site.organization.founded}年` : '2011年' },
];
---
<!-- 1. 相談帯 -->
<ScrollReveal animation="fade-up" duration={site.motion?.durationMs ?? 900}>
  <section class="clinic-consult-band relative bg-primary text-primary-content overflow-hidden">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-10 py-16 lg:py-24 grid lg:grid-cols-[55%_45%] gap-10 lg:gap-16 items-center">
      <div>
        <h2 class="text-2xl lg:text-[2rem] font-medium leading-snug mb-5 tracking-[0.04em]">
          歯並びのこと、まずは相談から。
        </h2>
        <p class="text-sm lg:text-base leading-loose text-primary-content/90 max-w-[36em]">
          お子さまの歯並びも、大人の噛み合わせも。気になることを整理するところから、初診相談が始まります。
        </p>
      </div>
      <div class="flex flex-col gap-3 lg:items-start">
        <a
          href={isContactPage ? url(site, '/contact/#reservation') : url(site, '/contact/')}
          class="clinic-consult-band__btn btn btn-lg w-full lg:w-[240px] bg-base-100 text-primary border-0 hover:bg-base-200"
        >
          {isContactPage ? '予約受付状況を確認する' : '初診相談を予約する'}
        </a>
        <a
          href={url(site, '/new-patients/')}
          class="clinic-consult-band__btn btn btn-outline btn-lg w-full lg:w-[240px] border-primary-content/70 text-primary-content hover:bg-primary-content/10 hover:border-primary-content"
        >
          相談の流れを見る
        </a>
      </div>
    </div>

    <svg
      class="clinic-consult-band__wave block w-full h-6"
      viewBox="0 0 1440 24"
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <path
        d="M0,12 C240,24 480,0 720,12 C960,24 1200,0 1440,12 L1440,24 L0,24 Z"
        fill="var(--color-primary)"
      />
    </svg>
  </section>
</ScrollReveal>

<!-- 2. 医院情報 -->
<section class="clinic-info bg-base-100">
  <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-12 lg:py-18 grid lg:grid-cols-2 gap-10 lg:gap-16">
    <div>
      <p class="text-sm font-bold tracking-[0.06em] text-primary mb-5">来院前にご確認ください</p>
      <Table>
        <tbody>
          {profile.map((row) => (
            <tr>
              <th class="w-28 whitespace-nowrap align-top text-primary font-bold">{row.k}</th>
              <td class="text-sm lg:text-base">{row.v}</td>
            </tr>
          ))}
        </tbody>
      </Table>
    </div>
    <aside class="bg-secondary text-base-content rounded-lg p-6 lg:p-8">
      <p class="font-bold mb-3">所在地の詳細と診療日時について</p>
      <p class="text-sm leading-loose mb-5">
        このサンプルサイトには、番地・診療時間・休診日を掲載していません。地図と診療カレンダーも表示していません。
      </p>
      <a
        href={url(site, '/about/#profile')}
        class="inline-flex items-center gap-1 text-sm font-medium border-b border-base-content/40 hover:border-base-content pb-0.5"
      >
        医院概要を見る
        <span aria-hidden="true">→</span>
      </a>
    </aside>
  </div>
</section>

<!-- 3. サンプル注記（SiteFooter の著作権行の前に置く） -->
<aside class="clinic-sample-note bg-base-100 border-t border-base-300">
  <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-4 text-xs leading-relaxed text-base-content/70">
    このサイトは架空の医院を紹介するサンプルです。写真はイメージであり、実際の医師・患者・設備を示すものではありません。実際の予約は受け付けていません。
  </div>
</aside>

<style>
  @media (prefers-reduced-motion: reduce) {
    .clinic-consult-band__btn { transition: none !important; }
  }
</style>