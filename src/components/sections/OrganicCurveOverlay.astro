---
interface Props { count?: number; class?: string; }
const { count = 5, class: className = '' } = Astro.props;
const paths = ['M-20 330C160 120 260 430 460 170S760 80 900 260', 'M120 430C280 180 430 520 600 210S930 80 1100 290', 'M350 440C460 190 630 430 790 160S1050 100 1250 270', 'M560 460C690 230 800 470 980 190S1240 100 1450 300', 'M740 470C870 220 1030 480 1190 170S1420 120 1650 280', 'M910 460C1060 250 1160 430 1350 190S1570 140 1770 270'];
---
<svg class={`organic-curves ${className}`} viewBox="0 0 1600 600" preserveAspectRatio="none" aria-hidden="true">
  {paths.slice(0, count).map((d, i) => <path d={d} style={`animation-delay:${400 + i * 35}ms`} />)}
</svg>
<style>
  .organic-curves { position:absolute; inset:0; width:100%; height:100%; overflow:hidden; pointer-events:none; }
  path { fill:none; stroke:#a89078; stroke-width:1.3; opacity:0; animation:curve-appear 300ms ease forwards; }
  @keyframes curve-appear { to { opacity:.9; } }
  @media (prefers-reduced-motion: reduce) { path { animation:none; opacity:.9; } }
</style>
