---
---
<form id="consultation-form" class="consultation-form" novalidate data-kabukido-form>
  <div class="summary" hidden aria-live="assertive"></div>
  <fieldset><legend>相談種別（必須）</legend><div class="options">
    <label><input type="radio" name="type" value="new-build" required /> 新築注文住宅</label>
    <label><input type="radio" name="type" value="renovation" /> 全面リノベーション</label>
    <label><input type="radio" name="type" value="visit" /> モデルハウス見学</label>
    <label><input type="radio" name="type" value="undecided" /> まだ決めていない</label>
    <label><input type="radio" name="type" value="recruit" /> 採用について</label>
  </div></fieldset>
  <label>お名前（必須）<input name="name" required autocomplete="name" /></label>
  <label>メールアドレス（必須）<input name="email" type="email" required autocomplete="email" /></label>
  <label>電話番号（任意）<input name="tel" type="tel" autocomplete="tel" /></label>
  <label>希望日（任意）<input name="date" type="date" /></label>
  <label>見学人数（任意）<input name="people" inputmode="numeric" /></label>
  <label>相談内容（必須）<textarea name="message" rows="7" required></textarea><small>分かる範囲で、ご希望や確認したいことをご記入ください。</small></label>
  <label class="agree"><input name="privacy" type="checkbox" required /> <span><a href="/sites/corporate/b-20260919-0500/privacy/">個人情報の取り扱い</a>を確認しました（必須）</span></label>
  <button type="submit">入力内容を確認する</button>
</form>
<script>
  document.querySelectorAll<HTMLFormElement>('[data-kabukido-form]').forEach((form) => {
    const selected = new URLSearchParams(location.search).get('type');
    const option = selected && form.querySelector<HTMLInputElement>(`input[value="${selected}"]`);
    if (option) option.checked = true;
    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const summary = form.querySelector<HTMLElement>('.summary');
      if (!form.checkValidity()) {
        if (summary) { summary.hidden = false; summary.textContent = '入力内容をご確認ください。'; }
        form.querySelector<HTMLElement>(':invalid')?.focus();
        return;
      }
      const values = new FormData(form);
      const panel = document.createElement('section');
      panel.tabIndex = -1;
      panel.innerHTML = `<h3>入力内容の確認</h3><p>ご入力いただいた内容は、以下のとおりです。修正する場合は「入力に戻る」を選んでください。</p><p>このサイトは架空の企業のサンプルです。入力内容は送信されず、予約は成立しません。</p><dl>${[...values.entries()].filter(([, value]) => value).map(([key, value]) => `<div><dt>${key}</dt><dd>${String(value)}</dd></div>`).join('')}</dl><button type="button">入力に戻る</button></section>`;
      form.hidden = true; form.after(panel); panel.focus();
      panel.querySelector('button')?.addEventListener('click', () => { panel.remove(); form.hidden = false; form.querySelector<HTMLElement>('button[type="submit"]')?.focus(); });
    });
  });
</script>
<style>
  .consultation-form { display:grid; gap:24px; } label,fieldset { display:grid; gap:8px; font-size:16px; line-height:1.7; } input,textarea { min-height:56px; padding:12px; border:1px solid var(--color-base-300); background:var(--color-base-100); color:inherit; font:inherit; } textarea { min-height:180px; } fieldset { padding:0; border:0; } legend { margin-bottom:12px; } .options { display:grid; gap:12px; } .options label,.agree { display:flex; align-items:center; } .options input,.agree input { min-height:auto; width:20px; height:20px; } button { min-height:56px; padding:0 32px; border:0; border-radius:999px; background:var(--color-primary); color:var(--color-primary-content); font:inherit; } .summary { padding:16px; background:var(--color-base-200); } small { font-size:14px; } @media(min-width:768px) { .options { grid-template-columns:1fr 1fr; } }
</style>
