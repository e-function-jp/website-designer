---
/**
 * PageHeaderHero — 冒険路線 b 案の下層ページ共通ヘッダ。
 *
 * 背景 #0E2A47（深い藍）、文字 #F4F6F4（雪白）。H1 は左 6 カラムに
 * 和文（明朝 75px）、右 6 カラムに欧字（Cormorant Garamond 48px、
 * tracking 0.04em）。直下に 1 段落のリード（18px、行高 1.95）。
 * 上下 9rem のパディング。ドットグリッドは #F4F6F4 透明度 0.06 の 6×6px。
 *
 * H1 を fade-up 700ms、欧字を 100ms 遅延で fade 700ms、
 * リードを 200ms 遅延で fade-up 700ms。
 * reduced-motion: reduce では初期表示。
 */
import ScrollReveal from '../ui/ScrollReveal.astro';

interface Props {
  /** 和文 H1（明朝 75px） */
  title: string;
  /** 欧字サブタイトル（Cormorant Garamond 48px） */
  englishTitle: string;
  /** リード文 */
  lead: string;
}

const { title, englishTitle, lead } = Astro.props;
---

<section class="page-header-hero relative bg-primary text-primary-content overflow-hidden">
  <div class="page-header-hero__grid absolute inset-0 opacity-[0.06] pointer-events-none" aria-hidden="true"></div>

  <div class="relative max-w-7xl mx-auto px-4 py-24 lg:py-40">
    <div class="grid gap-10 lg:gap-12 lg:grid-cols-2 items-end">
      <div>
        <ScrollReveal animation="fade-up" duration={700}>
          <h1
            class="text-4xl md:text-5xl lg:text-[4.75rem] font-medium leading-[1.1] tracking-[0.02em]"
            style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
          >
            {title}
          </h1>
        </ScrollReveal>
      </div>
      <div>
        <ScrollReveal animation="fade" duration={700} delay={100}>
          <p
            class="text-2xl md:text-3xl lg:text-[3rem] font-normal leading-tight tracking-[0.04em]"
            style="font-family: 'Cormorant Garamond', 'Playfair Display', 'Times New Roman', serif;"
          >
            {englishTitle}
          </p>
        </ScrollReveal>
      </div>
    </div>

    <div class="mt-10 lg:mt-12 max-w-3xl">
      <ScrollReveal animation="fade-up" duration={700} delay={200}>
        <p class="text-base lg:text-lg leading-[1.95]">
          {lead}
        </p>
      </ScrollReveal>
    </div>
  </div>
</section>

<style>
  .page-header-hero__grid {
    background-image:
      radial-gradient(circle at center, currentColor 1px, transparent 1.5px);
    background-size: 6px 6px;
    color: var(--color-primary-content);
  }
</style>
