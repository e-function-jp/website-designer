---
interface Item { question: string; answer: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<dl class="questions">{items.map((item)=><div><dt><span>問</span>{item.question}</dt><dd>{item.answer}</dd></div>)}</dl>
<style>.questions{margin:0;border-top:1px solid #cbd1ce}.questions div{padding:2rem 0 2.5rem;border-bottom:1px solid #cbd1ce}.questions dt{display:flex;gap:1rem;font:400 1.125rem/1.8 "Yu Mincho",serif}.questions dt span{font:400 .875rem/2.4 "Yu Gothic",sans-serif}.questions dd{margin:1rem 0 0;line-height:1.9}</style>
