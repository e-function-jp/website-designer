---
interface Props {
  image: string;
  alt: string;
  title: string;
  nav?: string;
  cta?: string;
  ratio?: 'landscape' | 'portrait' | 'wide';
  eager?: boolean;
}
const { image, alt, title, nav = '', cta = '', ratio = 'landscape', eager = false } = Astro.props;
const ratios = { landscape: 'aspect-[3/2]', portrait: 'aspect-[4/5]', wide: 'aspect-video' };
---

<div class:list={['work-screen', ratios[ratio]]}>
  <img src={image} alt={alt || '制作イメージ'} width="1200" height="800" loading={eager ? 'eager' : 'lazy'} />
  <div class="work-screen__veil"></div>
  <div class="work-screen__content">
    {nav && <span class="work-screen__nav">{nav}</span>}
    <strong>{title}</strong>
    {cta && <span class="work-screen__cta">{cta}</span>}
  </div>
</div>

<style>
  .work-screen { position: relative; overflow: hidden; background: var(--color-neutral); color: var(--color-neutral-content); }
  .work-screen img { width: 100%; height: 100%; object-fit: cover; }
  .work-screen__veil { position: absolute; inset: 0; background: linear-gradient(110deg, rgb(20 35 38 / .78), rgb(20 35 38 / .12)); }
  .work-screen__content { position: absolute; inset: auto 8% 9%; display: grid; gap: .75rem; max-width: 78%; }
  .work-screen strong { font-size: clamp(1.15rem, 3vw, 2rem); line-height: 1.45; }
  .work-screen__nav, .work-screen__cta { font-size: .75rem; letter-spacing: .08em; }
  .work-screen__cta { border: 1px solid currentColor; padding: .4rem .65rem; width: fit-content; }
</style>
