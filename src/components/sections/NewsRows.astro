---
import { url, type SiteConfig } from '../../lib/site';
interface Item { date: string; title: string; text: string; href: string }
interface Props { site: SiteConfig; items: Item[] }
const { site, items } = Astro.props;
---
<div class="rows">{items.map((item) => <article><time>{item.date}</time><div><h2><a href={url(site,item.href)}>{item.title}</a></h2><p>{item.text}</p></div></article>)}</div>
<style>.rows{max-width:80rem;margin:auto;padding:0 1.25rem}.rows article{display:grid;gap:1rem;min-height:9.5rem;padding:1.5rem 0;border-top:1px solid #cbd1ce}.rows article:last-child{border-bottom:1px solid #cbd1ce}.rows time,.rows p{font-size:.875rem;line-height:1.65}.rows h2{font:400 1.125rem/1.8 "Yu Mincho",serif;margin:0}.rows a{color:inherit;text-underline-offset:5px}.rows p{margin:.5rem 0 0}@media(min-width:768px){.rows{padding:0 5rem 0 30%}.rows article{grid-template-columns:7.5rem 1fr}}</style>
