---
import { url, type SiteConfig } from '../../lib/site';
interface Link { label?: string; title?: string; description?: string; text?: string; href: string }
interface Props { site: SiteConfig; links?: Link[]; items?: Link[] }
const { site, links, items } = Astro.props;
const entries = links ?? items ?? [];
---
<nav class="related" aria-label="関連ページ">
  {entries.map((link) => <a href={url(site, link.href)}><strong>{link.label ?? link.title}</strong>{(link.description ?? link.text) && <span>{link.description ?? link.text}</span>}<b aria-hidden="true">→</b></a>)}
</nav>
<style>
  .related{max-width:80rem;margin:6rem auto 0;padding:2rem 1.25rem;border-top:1px solid #cbd1ce;display:grid;gap:0}.related a{min-height:6rem;padding:1rem 0;color:inherit;text-decoration:underline;text-underline-offset:5px;border-bottom:1px solid #cbd1ce;display:grid;grid-template-columns:1fr auto;align-content:center;gap:.25rem}.related strong{font:400 1.125rem/1.8 "Yu Mincho","Hiragino Mincho ProN",serif}.related span{font-size:.875rem;line-height:1.65}.related b{grid-column:2;grid-row:1/3;font-weight:400}@media(min-width:768px){.related{grid-template-columns:1fr 1fr;gap:2rem;padding:2rem 5rem}.related a{border-top:0}}
</style>
