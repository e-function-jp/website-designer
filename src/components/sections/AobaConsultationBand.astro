---
/**
 * AobaConsultationBand — あおば矯正歯科クリニック向け共通相談帯。
 *
 * direction-b.html #shell の指示に基づく。
 *   - 青背景、PC左7列に「気になることから、お聞かせください。」、
 *     右5列に白いCTA。
 *   - 本文「子どもの歯並びから、大人の噛み合わせまで。初診相談から
 *     治療計画、経過のフォローへつなぎます。」
 *   - CTA下に架空医院・予約非受付の注意文。
 *   - PC上下72px、モバイル48px。
 *   - /contact/ のみCTAを「相談内容の入力へ戻る」に変え、
 *     同ページ#consultationへ戻す。
 */
import type { SiteConfig } from '../../lib/site';
import { url } from '../../lib/site';

interface Props {
  site: SiteConfig;
  /** /contact/ のとき true。CTA 文言と遷移先が変わる */
  isContactPage?: boolean;
}

const { site, isContactPage = false } = Astro.props;
const ctaHref = isContactPage ? url(site, '/contact/#consultation') : url(site, '/contact/');
const ctaLabel = isContactPage ? '相談内容の入力へ戻る' : '初診相談を予約する';
---
<section class="aoba-band bg-primary text-primary-content">
  <div class="max-w-[1400px] mx-auto px-5 lg:px-18 py-12 lg:py-[72px] grid lg:grid-cols-12 gap-8 lg:gap-16 items-center">
    <div class="lg:col-span-7">
      <h2 class="text-2xl lg:text-[2rem] font-medium leading-snug tracking-[0.02em] mb-4 lg:mb-5">
        気になることから、お聞かせください。
      </h2>
      <p class="text-sm lg:text-base leading-[1.9] text-primary-content/90 max-w-[36em]">
        子どもの歯並びから、大人の噛み合わせまで。初診相談から治療計画、経過のフォローへつなぎます。
      </p>
    </div>
    <div class="lg:col-span-5 flex flex-col gap-3">
      <a
        href={ctaHref}
        class="aoba-band__cta"
      >
        {ctaLabel}
      </a>
      <p class="text-xs lg:text-sm text-primary-content/75">
        架空医院のサンプルです。実際の予約は受け付けていません。
      </p>
    </div>
  </div>
</section>

<style>
  .aoba-band__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 56px;
    padding: 0 24px;
    background: var(--color-base-100);
    color: var(--color-primary);
    border-radius: 999px;
    font-weight: 700;
    font-size: 15px;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }
  .aoba-band__cta:hover {
    opacity: 0.92;
  }
  .aoba-band__cta:focus-visible {
    outline: 3px solid var(--color-base-100);
    outline-offset: 3px;
  }
  @media (min-width: 1024px) {
    .aoba-band > div {
      padding-left: 72px;
      padding-right: 72px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .aoba-band__cta { transition: none !important; }
  }
</style>
