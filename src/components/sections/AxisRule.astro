---
interface Props {
  direction?: 'horizontal' | 'vertical';
  class?: string;
}
const { direction = 'horizontal', class: className = '' } = Astro.props;
---

<div class:list={['axis-rule', `axis-rule--${direction}`, className]} aria-hidden="true"></div>

<style>
  .axis-rule { background: currentColor; opacity: .45; transform-origin: left center; animation: axis-rule-grow 2400ms ease both; }
  .axis-rule--horizontal { width: 100%; height: 1px; }
  .axis-rule--vertical { width: 1px; height: 100%; transform-origin: center top; animation-name: axis-rule-grow-y; }
  @keyframes axis-rule-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes axis-rule-grow-y { from { transform: scaleY(0); } to { transform: scaleY(1); } }
  @media (prefers-reduced-motion: reduce) {
    .axis-rule { animation: none; transform: none; }
  }
</style>
