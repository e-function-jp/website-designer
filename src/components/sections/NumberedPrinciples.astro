---
interface Item { title: string; text: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<ol class="principles">{items.map((item,i)=><li><span>{String(i+1).padStart(2,'0')}</span><div><h2>{item.title}</h2><p>{item.text}</p></div></li>)}</ol>
<style>.principles{padding:0;margin:0;list-style:none;border-top:1px solid #cbd1ce}.principles li{display:grid;grid-template-columns:3rem 1fr;gap:1rem;padding:2rem 0;border-bottom:1px solid #cbd1ce}.principles span{font-size:.875rem}.principles h2{font:400 1.125rem/1.8 "Yu Mincho",serif;margin:0}.principles p{margin:.5rem 0 0;line-height:1.9}</style>
