---
interface Props {
  tip: string;
  position?: 'top' | 'bottom' | 'left' | 'right';
  variant?: 'primary' | 'secondary' | 'accent' | 'info' | 'success' | 'warning' | 'error';
  class?: string;
}
const { tip, position = 'top', variant, class: className = '' } = Astro.props;
const posClass = position !== 'top' ? `tooltip-${position}` : '';
const variantClass = variant ? `tooltip-${variant}` : '';
---
<div class={`tooltip ${posClass} ${variantClass} ${className}`.trim()} data-tip={tip}>
  <slot />
</div>
