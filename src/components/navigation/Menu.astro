---
interface Props { direction?: 'vertical' | 'horizontal'; size?: 'xs' | 'sm' | 'md' | 'lg'; class?: string }
const { direction = 'vertical', size = 'md', class: className = '' } = Astro.props;
const dirClass = direction === 'horizontal' ? 'menu-horizontal' : '';
const sizeClass = size !== 'md' ? `menu-${size}` : '';
---
<ul class={`menu ${dirClass} ${sizeClass} bg-base-200 rounded-box ${className}`.trim()}>
  <slot />
</ul>
