---
interface Props { variant?: 'primary' | 'secondary' | 'accent' | 'ghost'; size?: 'xs' | 'sm' | 'md' | 'lg'; bordered?: boolean; class?: string }
const { variant, size = 'md', bordered = true, class: className = '' } = Astro.props;
const variantClass = variant ? `select-${variant}` : '';
const sizeClass = size !== 'md' ? `select-${size}` : '';
---
<select class={`select ${variantClass} ${sizeClass} ${bordered ? 'select-bordered' : ''} ${className}`.trim()}>
  <slot />
</select>
