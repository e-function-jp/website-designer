---
interface Props { value?: number; max?: number; size?: 'xs' | 'sm' | 'md' | 'lg'; half?: boolean; name?: string; class?: string }
const { value = 0, max = 5, size = 'md', half = false, name = 'rating', class: className = '' } = Astro.props;
const sizeClass = size !== 'md' ? `rating-${size}` : '';
---
<div class={`rating ${sizeClass} ${half ? 'rating-half' : ''} ${className}`.trim()}>
  {Array.from({ length: max }, (_, i) => (
    <input type="radio" name={name} class={`mask mask-star-2 bg-orange-400`} checked={i + 1 === value} />
  ))}
</div>
