---
interface Props { variant?: 'primary' | 'secondary' | 'accent' | 'ghost'; size?: 'xs' | 'sm' | 'md' | 'lg'; bordered?: boolean; class?: string }
const { variant, size = 'md', bordered = true, class: className = '' } = Astro.props;
const variantClass = variant ? `file-input-${variant}` : '';
const sizeClass = size !== 'md' ? `file-input-${size}` : '';
---
<input type="file" class={`file-input ${variantClass} ${sizeClass} ${bordered ? 'file-input-bordered' : ''} ${className}`.trim()} />
