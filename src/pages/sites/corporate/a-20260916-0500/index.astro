---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { site } from './_site';
import { url } from '../../../../lib/site';
import ScrollReveal from '../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../components/ui/SectionTitle.astro';
import Alert from '../../../../components/data-display/Alert.astro';
import CorporateSalesHero from '../../../../components/sections/CorporateSalesHero.astro';
import SalesSupportOverview from '../../../../components/sections/SalesSupportOverview.astro';
import BusinessPhotoText from '../../../../components/sections/BusinessPhotoText.astro';
import SalesResultsStrip from '../../../../components/sections/SalesResultsStrip.astro';
import SiteEndLinks from '../../../../components/site/SiteEndLinks.astro';
import FloatingCta from '../../../../components/site/FloatingCta.astro';

const SHARED = '/sites/corporate/_shared/20260916-0500';
const heroImage = {
  src: `${SHARED}/img-a-01.jpg`,
  alt: '商談資料を囲んで検討する人たちのイメージ',
};
const workshopImage = {
  src: `${SHARED}/img-a-02.jpg`,
  alt: '現場の状況について話し合う担当者たちのイメージ',
};

const programItems = [
  {
    number: '01',
    title: '商談設計',
    body: '顧客との対話で何を確かめ、次にどう進むか。商談の判断を共有できる形にします。',
  },
  {
    number: '02',
    title: 'パイプライン可視化',
    body: '案件の状況と次の行動を捉え、チームで進捗を確認できる状態を目指します。',
  },
  {
    number: '03',
    title: '現場定着',
    body: '設計した進め方をプレイブックに整理し、現場での活用につなげます。',
  },
];

const metrics = [
  { value: '1.6倍', title: '支援企業の平均受注率', period: '14か月で改善' },
  { value: '92%', title: '導入後12か月の定着率', period: '対象：支援企業' },
  { value: '210以上', title: '累計支援チーム数', period: '2026年8月時点' },
];
---

<SiteLayout
  site={site}
  title="受注の型を、現場に残す"
  description="中堅製造業とSaaS企業の営業変革を、伴走型の組織診断とプレイブック整備で支援する軌道セールス設計株式会社のコーポレートサイトです。"
  path="/"
  isHome
>
  <CorporateSalesHero site={site} heroImage={heroImage} />

  <!-- 2. 企業姿勢（濃紺ヘルパー帯の直後に、中央寄せで濃紺背景を連続） -->
  <section class="corp-stance bg-primary text-primary-content">
    <div class="max-w-[760px] mx-auto px-5 lg:px-0 py-16 lg:py-24 text-center">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <h2 class="corp-stance__heading">成果を、組織の力として残す。</h2>
        <div class="corp-stance__body">
          <p>商談が進んだ理由を、次の商談でも使える形にする。</p>
          <p>案件の状況を、チームで同じ視点から捉えられるようにする。</p>
          <p>そして、整えた型を、日々の営業活動に定着させる。</p>
          <p class="corp-stance__closing">私たちは、診断から設計、現場での活用までを一体で支援します。</p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- 3. 営業変革プログラムへの入口 -->
  <SalesSupportOverview
    site={site}
    heading="営業の課題を、つながったプロセスで解く。"
    intro="商談の進め方、案件の見え方、日々の運用。分断しがちな課題を、一つの受注プロセスとして整えます。"
    items={programItems}
    figureCaption="診断から現場定着までの流れ"
    detailLink={{ label: '営業変革プログラムを詳しく見る', href: '/service/' }}
  />

  <!-- 4. 支援方針への入口 -->
  <BusinessPhotoText
    site={site}
    image={workshopImage}
    photoPosition="left"
    background="subtle"
  >
    <SectionTitle title="現場とともに、受注の型をつくる。" align="left" class="bpt__section-title" />
    <div class="bpt__text">
      <p>営業の変革は、設計だけでは完結しません。現場の状況を捉える組織診断と、日々の判断を支えるプレイブック。その両方を軸に、再現性のある受注プロセスを構築します。</p>
      <p class="bpt__link-row">
        <a href={url(site, '/about/')} class="bpt__link">
          私たちの支援方針を読む
          <span aria-hidden="true">→</span>
        </a>
      </p>
    </div>
  </BusinessPhotoText>

  <!-- 5. 支援実績への入口 -->
  <SalesResultsStrip
    site={site}
    heading="数字で見る、営業変革の実績。"
    body="1.6倍 — 支援企業の平均受注率を14か月で改善 ／ 92% — 導入後12か月の定着率 ／ 210以上 — 累計支援チーム数。各指標の対象・期間を含めて、支援実績をご確認ください。"
    metrics={metrics}
    detailLink={{ label: '支援実績を見る', href: '/case/' }}
  />

  <!-- 6. 採用への入口（濃紺全幅帯） -->
  <section class="corp-recruit bg-primary text-primary-content">
    <div class="max-w-[760px] mx-auto px-5 lg:px-0 py-16 lg:py-24 text-center">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <h2 class="corp-recruit__heading">営業の変革を、現場から支える。</h2>
        <div class="corp-recruit__body">
          <p>組織診断、商談設計、プレイブック整備。私たちが向き合う仕事と、採用に関する掲載情報をご案内します。</p>
          <p class="corp-recruit__link-row">
            <a href={url(site, '/recruit/')} class="corp-recruit__link">
              採用について見る
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- 7. お知らせへの入口 -->
  <section class="corp-news bg-base-200">
    <div class="max-w-[1140px] mx-auto px-5 lg:px-10 py-16 lg:py-24 grid lg:grid-cols-12 gap-8 lg:gap-16 items-center">
      <div class="lg:col-span-4">
        <SectionTitle title="お知らせ" align="left" />
      </div>
      <div class="lg:col-span-8">
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
          <Alert variant="info">
            <p>現在、このサイトに掲載しているお知らせはありません。</p>
          </Alert>
          <p class="corp-news__link-row">
            <a href={url(site, '/news/')} class="corp-news__link">
              お知らせ一覧を見る
              <span aria-hidden="true">→</span>
            </a>
          </p>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- 8. 共通末尾（会社概要・支援実績 + 主要CTA） -->
  <SiteEndLinks site={site} currentPath="/" />

  <FloatingCta site={site} />
</SiteLayout>

<style>
  .corp-stance__heading {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 48px;
    letter-spacing: 0.025em;
  }
  .corp-stance__body p {
    font-size: 16px;
    line-height: 1.95;
    margin: 0 0 24px;
  }
  .corp-stance__body p:last-child { margin-bottom: 0; }
  .corp-stance__closing {
    margin-top: 24px !important;
    opacity: 0.9;
  }

  .bpt__section-title { margin-bottom: 24px; }
  .bpt__text p {
    font-size: 16px;
    line-height: 1.85;
    margin: 0 0 24px;
  }
  .bpt__link-row { margin-top: 32px; }
  .bpt__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 4px;
    font-weight: 700;
    font-size: 15px;
  }
  .bpt__link:hover { color: var(--color-secondary); border-bottom-color: var(--color-secondary); }

  .corp-recruit__heading {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 48px;
    letter-spacing: 0.025em;
  }
  .corp-recruit__body p {
    font-size: 16px;
    line-height: 1.95;
    margin: 0 0 24px;
    opacity: 0.92;
  }
  .corp-recruit__link-row { margin-top: 32px; }
  .corp-recruit__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary-content);
    text-decoration: underline;
    text-underline-offset: 4px;
    font-weight: 700;
    font-size: 15px;
  }

  .corp-news__link-row { margin-top: 24px; text-align: right; }
  .corp-news__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 4px;
    font-weight: 700;
    font-size: 15px;
  }
  .corp-news__link:hover { color: var(--color-secondary); border-bottom-color: var(--color-secondary); }

  @media (prefers-reduced-motion: reduce) {
    .bpt__link, .corp-news__link, .corp-recruit__link { transition: none; }
  }
</style>
