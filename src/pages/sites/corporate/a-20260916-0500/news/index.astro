---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Alert from '../../../../../components/data-display/Alert.astro';
import Card from '../../../../../components/data-display/Card.astro';
import CorporatePageHeader from '../../../../../components/sections/CorporatePageHeader.astro';
import SiteEndLinks from '../../../../../components/site/SiteEndLinks.astro';
import FloatingCta from '../../../../../components/site/FloatingCta.astro';

const relatedLinks = [
  {
    title: '営業変革プログラム',
    body: '支援内容と進め方をご確認いただけます。',
    href: '/service/',
  },
  {
    title: '会社概要',
    body: '商号、設立、所在地などの基本情報をご確認いただけます。',
    href: '/company/',
  },
];
---

<SiteLayout
  site={site}
  title="お知らせ"
  description="軌道セールス設計株式会社からのお知らせを掲載するページです。現在掲載中のお知らせはありません。"
  path="/news/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: 'お知らせ' }]}
>
  <CorporatePageHeader
    title="お知らせ"
    intro="軌道セールス設計からのお知らせを掲載するページです。"
  />

  <!-- news-list: 一覧の空状態 -->
  <section class="news-list bg-base-100">
    <div class="max-w-[1140px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <div class="news-list__inner">
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
          <h2 class="news-list__heading">掲載中のお知らせ</h2>
          <Alert variant="info">
            <p>現在、このサイトに掲載しているお知らせはありません。</p>
          </Alert>
          <p class="news-list__note">営業変革プログラムや会社の基本情報は、各ページでご覧いただけます。</p>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- related: 次の閲覧先 -->
  <section class="news-related bg-base-100">
    <div class="max-w-[1140px] mx-auto px-5 lg:px-10 pb-16 lg:pb-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <h2 class="news-related__heading">お探しの情報へ</h2>
        <ul class="news-related__list">
          {relatedLinks.map((l) => (
            <li>
              <a href={url(site, l.href)} class="news-related__card">
                <div>
                  <p class="news-related__title">{l.title}</p>
                  <p class="news-related__body">{l.body}</p>
                </div>
                <span class="news-related__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </ScrollReveal>
    </div>
  </section>

  <SiteEndLinks site={site} currentPath="/news/" />
  <FloatingCta site={site} />
</SiteLayout>

<style>
  .news-list__inner {
    border-top: 1px solid var(--color-base-300);
    border-bottom: 1px solid var(--color-base-300);
    padding: 32px 0;
  }
  .news-list__heading {
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 24px;
    letter-spacing: 0.025em;
    text-align: left;
  }
  .news-list__note {
    font-size: 15px;
    line-height: 1.85;
    color: var(--color-base-content);
    margin: 24px 0 0;
  }

  .news-related__heading {
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 32px;
    letter-spacing: 0.025em;
    text-align: left;
  }
  .news-related__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .news-related__card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    background: var(--color-base-100);
    border: 1px solid var(--color-base-300);
    padding: 24px;
    text-decoration: none;
    color: var(--color-base-content);
    min-height: 160px;
  }
  .news-related__card:hover { border-color: var(--color-primary); }
  .news-related__title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 4px;
  }
  .news-related__body {
    font-size: 14px;
    line-height: 1.7;
    color: var(--color-base-content);
    opacity: 0.8;
    margin: 0;
  }
  .news-related__arrow {
    font-size: 20px;
    font-weight: 700;
    color: var(--color-primary);
  }
  .news-related__card:hover .news-related__arrow {
    color: var(--color-secondary);
  }

  @media (min-width: 768px) {
    .news-related__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .news-related__card, .news-related__arrow { transition: none; }
  }
</style>
