---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Alert from '../../../../../components/data-display/Alert.astro';
import CorporatePageHeader from '../../../../../components/sections/CorporatePageHeader.astro';
import SiteEndLinks from '../../../../../components/site/SiteEndLinks.astro';
import FloatingCta from '../../../../../components/site/FloatingCta.astro';
---

<SiteLayout
  site={site}
  title="個人情報の取り扱い"
  description="軌道セールス設計株式会社のサンプルサイトにおける、フォーム入力情報の扱いをご案内します。送信・保存は行いません。"
  path="/privacy/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '個人情報の取り扱い' }]}
>
  <CorporatePageHeader
    title="個人情報の取り扱い"
    intro="このサンプルサイトにおける、フォーム入力情報の扱いをご案内します。"
  />

  <!-- handling: 入力情報の扱い -->
  <section class="privacy-handling bg-base-100">
    <div class="max-w-[760px] mx-auto px-5 lg:px-0 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <h2 class="privacy-handling__heading">フォームの入力情報について</h2>

        <div class="privacy-handling__block">
          <h3 class="privacy-handling__sub">1. サイトの位置づけ</h3>
          <p>このサイトは架空の企業「軌道セールス設計株式会社」のサンプルです。実際のお申し込みの受け付けは行っていません。</p>
        </div>

        <div class="privacy-handling__block">
          <h3 class="privacy-handling__sub">2. 入力内容の利用</h3>
          <p>フォームに入力した内容は、この画面内の確認表示にのみ使用します。フォームから外部へ送信せず、ブラウザーの保存領域にも記録しません。</p>
        </div>

        <div class="privacy-handling__block">
          <h3 class="privacy-handling__sub">3. 入力時のお願い</h3>
          <p>動作を確認する際は、実在する個人情報や機密情報を入力しないでください。</p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- return: 入力画面への戻り先 -->
  <section class="privacy-return bg-base-200">
    <div class="max-w-[760px] mx-auto px-5 lg:px-10 py-12 lg:py-16">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <h2 class="privacy-return__heading">入力画面の動作を確認する方へ</h2>
        <Alert variant="info">
          <p>フォームでは入力内容の確認までをお試しいただけます。送信は行われません。</p>
        </Alert>
        <p class="privacy-return__link-row">
          <a href={url(site, '/contact/')} class="privacy-return__link">
            無料組織診断のお申し込み画面へ
            <span aria-hidden="true">→</span>
          </a>
        </p>
      </ScrollReveal>
    </div>
  </section>

  <SiteEndLinks site={site} currentPath="/privacy/" />
  <FloatingCta site={site} />
</SiteLayout>

<style>
  .privacy-handling__heading {
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 24px;
    letter-spacing: 0.025em;
    text-align: left;
  }
  .privacy-handling__block {
    margin-top: 40px;
  }
  .privacy-handling__block:first-of-type {
    margin-top: 16px;
  }
  .privacy-handling__sub {
    font-size: 18px;
    font-weight: 700;
    color: var(--color-primary);
    margin: 0 0 12px;
  }
  .privacy-handling__block p {
    font-size: 16px;
    line-height: 1.85;
    color: var(--color-base-content);
    margin: 0;
  }

  .privacy-return__heading {
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 24px;
    letter-spacing: 0.025em;
    text-align: left;
  }
  .privacy-return__link-row { margin-top: 32px; }
  .privacy-return__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--color-primary);
    text-decoration: none;
    border-bottom: 2px solid var(--color-primary);
    padding-bottom: 4px;
    font-weight: 700;
    font-size: 15px;
  }
  .privacy-return__link:hover { color: var(--color-secondary); border-bottom-color: var(--color-secondary); }

  @media (prefers-reduced-motion: reduce) {
    .privacy-return__link { transition: none; }
  }
</style>
