---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Alert from '../../../../../components/data-display/Alert.astro';
import CorporatePageHeader from '../../../../../components/sections/CorporatePageHeader.astro';
import OrganizationDiagnosisForm from '../../../../../components/sections/OrganizationDiagnosisForm.astro';
import SiteEndLinks from '../../../../../components/site/SiteEndLinks.astro';
import FloatingCta from '../../../../../components/site/FloatingCta.astro';
---

<SiteLayout
  site={site}
  title="無料組織診断のお申し込み"
  description="軌道セールス設計の無料組織診断のお申し込みページです。商談の進め方、案件の見え方、現場での運用について、現在の営業組織の課題をお聞かせください。"
  path="/contact/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '無料組織診断のお申し込み' }]}
>
  <CorporatePageHeader
    title="無料組織診断のお申し込み"
    intro="商談の進め方、案件の見え方、現場での運用。現在の営業組織で課題に感じていることをお聞かせください。"
  />

  <!-- guidance: 入力前の案内 -->
  <section class="contact-guidance bg-base-100">
    <div class="max-w-[760px] mx-auto px-5 lg:px-0 py-12 lg:py-16">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <h2 class="contact-guidance__heading">分かる範囲から、お聞かせください。</h2>
        <div class="contact-guidance__body">
          <p>会社名、ご担当者名、ご連絡先と、現在の課題をご入力ください。整理しきれていない場合も、気になっていることをそのままご記入いただけます。</p>
        </div>
        <Alert variant="warning" class="contact-guidance__alert">
          <p>このサイトは架空企業のサンプルです。入力内容は送信・保存されません。実在の個人情報や機密情報は入力しないでください。</p>
        </Alert>
      </ScrollReveal>
    </div>
  </section>

  <!-- form: OrganizationDiagnosisForm を使う -->
  <OrganizationDiagnosisForm site={site} />

  <SiteEndLinks site={site} currentPath="/contact/" showCta={false} />
  <!-- /contact/ は主要CTAを SiteEndLinks / FloatingCta に出さない（フォーム内ボタンを使う） -->
  <FloatingCta site={site} hidden={true} />
</SiteLayout>

<style>
  .contact-guidance__heading {
    font-size: clamp(24px, 3.5vw, 40px);
    font-weight: 700;
    line-height: 1.4;
    margin: 0 0 24px;
    letter-spacing: 0.025em;
    text-align: left;
  }
  .contact-guidance__body {
    margin: 0 0 24px;
  }
  .contact-guidance__body p {
    font-size: 16px;
    line-height: 1.85;
    margin: 0;
  }
  .contact-guidance__alert {
    margin-top: 16px;
  }
</style>
