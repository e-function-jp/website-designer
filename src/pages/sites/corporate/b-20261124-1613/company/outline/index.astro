---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro';
import { site } from '../../_site';
import JunroHeader from '../../../../../../components/site/JunroHeader.astro';
import JunroFooter from '../../../../../../components/site/JunroFooter.astro';
import JunroPageHeading from '../../../../../../components/sections/JunroPageHeading.astro';
import JunroProfileTable from '../../../../../../components/sections/JunroProfileTable.astro';
const profile = [
  {label:'会社名',value:'巡路知能株式会社'},{label:'よみ',value:'じゅんろちのう'},{label:'所在地',value:'福岡県福岡市'},{label:'設立',value:'2018年'},{label:'従業員数',value:'86名'},{label:'事業内容',value:'上下水道や公共施設の設備点検を記録・分析するクラウドサービスの開発・提供'},{label:'提供先',value:'自治体、インフラ運営会社'}
];
const scope = [{label:'対象設備',value:'上下水道、公共施設'},{label:'提供するもの',value:'設備点検を記録・分析するクラウドサービス'},{label:'主な利用者',value:'自治体の施設管理担当者、インフラ運営会社の設備管理責任者'}];
---
<SiteLayout site={site} title="会社概要・組織" description="巡路知能株式会社の所在地、設立、事業内容、提供先と、設備点検の記録・分析を支える組織の役割をご案内します。" path="/company/outline/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'企業情報',href:'/company/'},{label:'会社概要・組織'}]}>
  <Fragment slot="head"><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" /><link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;800&display=swap" rel="stylesheet" /></Fragment>
  <Fragment slot="header"><JunroHeader site={site} path="/company/outline/" /></Fragment>
  <div class="junro"><JunroPageHeading english="Profile & Team" japanese="会社概要・組織" /><div class="junro-content">
    <div class="junro-photo-placeholder junro-photo-placeholder--portrait" data-photo style="--photo:url(/sites/corporate/_shared/20261124-1613/img-a-10.jpg);width:260px;height:390px" role="img" aria-label="机に置かれた点検記録と鉛筆"></div>
    <section class="junro-split"><h2>会社概要</h2><JunroProfileTable rows={profile} /></section>
    <section class="junro-split"><h2>事業を支える組織</h2><div><div class="junro-two-column"><div><div class="junro-photo-placeholder junro-photo-placeholder--portrait" data-photo style="--photo:url(/sites/corporate/_shared/20261124-1613/img-a-01.jpg);max-width:260px;height:390px" role="img" aria-label="自治体施設を点検する担当者"></div><p>自治体の施設管理担当者に向き合う仕事。</p></div><div><div class="junro-photo-placeholder junro-photo-placeholder--portrait" data-photo style="--photo:url(/sites/corporate/_shared/20261124-1613/img-a-09.jpg);max-width:260px;height:390px" role="img" aria-label="現場で記録を受け渡す手元"></div><p>インフラ運営会社の設備管理責任者に向き合う仕事。</p></div></div><p>いずれも、点検の記録と分析を使える情報にするための仕事です。</p></div></section>
    <section class="junro-split"><h2>提供領域</h2><JunroProfileTable rows={scope} /></section>
  </div></div>
  <Fragment slot="footer"><JunroFooter site={site} path="/company/outline/" label="会社概要・組織" /></Fragment>
</SiteLayout>
