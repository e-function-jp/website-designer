---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import NoxrayPageIntro from '../../../../../components/sections/NoxrayPageIntro.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="私たちについて" description="ノクスレイが中堅BtoB企業の事業価値を判断できる情報へ変え、公開後の改善まで支援する考え方と会社情報をご紹介します。" path="/about/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'私たちについて'}]}>
<NoxrayPageIntro eyebrow="私たちについて" english="ABOUT" title="事業の価値を、／相手が判断できる情報へ。" description="ノクスレイは、中堅BtoB企業に向けて、ブランドサイト・採用サイト・キャンペーンLPの企画設計からUI制作、公開後の改善運用までを一貫して提供します。" dark><AxisRule /></NoxrayPageIntro>
<section id="values" class="section"><AxisRule /><h2>成果につながる、3つの設計。</h2><ScrollReveal animation="fade" duration={820}><DesignNotes notes={[{title:'情報を設計する',body:'業種ごとの検討の流れを踏まえ、訪問者が必要とする情報を整理します。事業の強みと、知りたいことが出会う順序をつくります。'},{title:'接点を設計する',body:'情報の優先順位を、画面の大きさ、文字の強弱、導線の位置に落とし込みます。PCでもスマートフォンでも、次の行動を選べるUIをつくります。'},{title:'改善を設計する',body:'公開後に何を確かめるかを、制作の段階から考えます。問い合わせと採用応募につながる動きを計測し、改善の判断につなげます。'}]} /></ScrollReveal></section>
<section id="commitment" class="section dark"><AxisRule /><h2>公開の先まで、考える。</h2><p>サイトを訪れる方の判断と、事業の成果。その間にある情報の不足や迷いを、設計で減らしていきたいと考えています。</p><p>企画、UI制作、改善運用を別々の作業にせず、同じ目的からつなげる。問い合わせ獲得や採用応募のために何が必要かを問い続ける。それが、ノクスレイの制作に向き合う姿勢です。</p><strong>株式会社<br />ノクスレイ</strong></section>
<section id="company-profile" class="section"><AxisRule /><h2>会社概要</h2><table><tbody>{[['商号','株式会社ノクスレイ'],['よみ','のくすれい'],['設立','2014年'],['従業員数','48名'],['所在地','東京都渋谷区'],['業種','広告・Web制作'],['事業内容','中堅BtoB企業向けのブランドサイト・採用サイト・キャンペーンLPの企画設計、UI制作、公開後の改善運用']].map(([key,value])=><tr><th scope="row">{key}</th><td>{value}</td></tr>)}</tbody></table><TextArrowLink site={site} href="/contact/" label="ご相談：無料相談・見積もり" /></section>
<section id="track-record" class="section"><AxisRule /><h2>制作と改善を、積み重ねる。</h2><p>累計制作240件超。公開後90日の問い合わせ平均1.8倍。取引継続率87%。企画から公開後までをつなぐ支援の積み重ねです。</p><TextArrowLink site={site} href="/works/" label="制作実績を見る" /><small>数値は本サンプルの企業設定に基づきます。</small></section><ConsultationRows site={site} /></SiteLayout>
<style>.section{padding:80px 20px}.section>*{max-width:900px;margin-left:auto;margin-right:auto}.section h2{font-size:clamp(28px,4vw,40px)}.section p{line-height:1.9}.dark{background:#142326;color:#f4f3ee}.dark strong{display:block;text-align:right;font-size:clamp(40px,8vw,96px);line-height:1.1;margin-top:64px}table{border-collapse:collapse;width:100%;margin:32px auto}th,td{padding:24px 0;border-bottom:1px solid #bbc4bf;text-align:left;vertical-align:top}th{width:160px}@media(min-width:768px){.section{padding:120px 32px}} </style>
