---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import PageIntro from '../../../../../components/sections/PageIntro.astro'; import SectionTitle from '../../../../../components/ui/SectionTitle.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro';
---
<SiteLayout site={site} title="資料・検討ガイド" description="対応範囲と進め方を社内で比較・検討するための会社資料と、Web刷新・採用強化に向けた確認項目をまとめた資料・検討ガイドです。" path="/download/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'資料・検討ガイド'}]}>
<section id="hero"><PageIntro title="資料・検討ガイド" description="対応範囲と進め方を、社内での比較・検討に。会社資料は入力不要で保存できます。Web刷新と採用強化の確認項目も、このページでご覧いただけます。" /><div class="mx-auto flex max-w-6xl flex-wrap gap-6 px-5 pb-12 lg:px-8"><TextArrowLink site={site} href="#company" label="会社資料" /><TextArrowLink site={site} href="#web" label="Web刷新の検討ガイド" /><TextArrowLink site={site} href="#recruitment" label="採用強化の検討ガイド" /></div></section>
<section id="company" class="bg-base-200 px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[35%_55%]"><ScrollReveal animation="fade-up" duration={820}><article class="aspect-[1/1.414] bg-base-100 p-8 shadow-sm"><p class="text-sm">COMPANY PROFILE</p><AxisRule class="mt-16" /><h2 class="mt-8 text-3xl">株式会社<br />ノクスレイ</h2><p class="mt-8">伝わる設計で、成果を積む。</p></article></ScrollReveal><div><SectionTitle title="会社資料" align="left" /><p class="leading-9">ノクスレイの対応範囲と制作の進め方を、ひとつの資料にまとめました。</p><p class="mt-6 leading-8">収録内容：会社概要 / 対応するサイト / 制作の進め方 / 実績数値</p><a href="/sites/corporate/a-20260920-1616/assets/noxray-company.html" download class="btn btn-primary mt-8">会社資料を保存する（HTML）</a><p class="mt-4 text-sm">入力不要。ブラウザーで開いて印刷できます。</p></div></div></section>
<section id="web" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[25%_65%]"><SectionTitle title="Web刷新の前に、判断軸をそろえる。" align="left" /><div><DesignNotes numbered notes={[{title:'目的を言葉にする',body:'問い合わせを増やしたい、事業を正しく伝えたい。今回の刷新で変えたいことを整理し、何を優先するかを社内でそろえます。'},{title:'訪問者と情報を整理する',body:'誰がサイトを訪れ、何を知って判断するのか。現在のページで不足している情報や、探しにくい情報を書き出します。'},{title:'公開後の確認方法を考える',body:'問い合わせ数だけでなく、詳細ページへの移動や入力までの行動も確認対象にします。どの変化を成果として捉えるかを、制作前に考えます。'}]} /><TextArrowLink site={site} href="/contact/" label="整理した内容を相談する" class="mt-7" /></div></div></section>
<section id="recruitment" class="bg-neutral px-5 py-20 text-neutral-content lg:px-8 lg:py-28"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[25%_65%]"><SectionTitle title="採用サイトで、何を伝えるか。" align="left" /><div><DesignNotes numbered dark notes={[{title:'仕事の姿を具体化する',body:'仕事内容と役割、事業との関係を整理します。候補者が入社後の自分を考えられる情報があるかを確認します。'},{title:'判断に必要な情報をそろえる',body:'働く環境、募集内容、応募までの流れを確認します。魅力を伝える情報と、条件を確かめる情報の両方を用意します。'},{title:'応募までの迷いを減らす',body:'仕事紹介から募集情報、入力へ進む導線を確認します。スマートフォンで読んだときにも、必要な情報を見つけられるかを確かめます。'}]} /><TextArrowLink site={site} href="/contact/" label="採用サイトについて相談する" class="mt-7" /></div></div></section><ConsultationRows site={site} downloadHref="/download/#company" />
</SiteLayout>
