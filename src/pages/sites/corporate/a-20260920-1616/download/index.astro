---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import NoxrayPageIntro from '../../../../../components/sections/NoxrayPageIntro.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="資料・検討ガイド" description="会社資料を入力不要で保存でき、Web刷新と採用強化に向けて社内で整理したい判断項目を確認できる資料・検討ガイドです。" path="/download/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'資料・検討ガイド'}]}><NoxrayPageIntro eyebrow="資料・検討ガイド" english="DOWNLOAD" title="対応範囲と進め方を、社内での比較・検討に。" description="会社資料は入力不要で保存できます。Web刷新と採用強化の確認項目も、このページでご覧いただけます。"><AxisRule /><div class="links"><a href="#company">会社資料</a><a href="#web">Web刷新の検討ガイド</a><a href="#recruitment">採用強化の検討ガイド</a></div></NoxrayPageIntro><section id="company" class="pale"><AxisRule /><div class="doc"><div class="cover"><strong>株式会社<br />ノクスレイ</strong><span>伝わる設計で、成果を積む。</span></div><div><h2>会社資料</h2><p>ノクスレイの対応範囲と制作の進め方を、ひとつの資料にまとめました。</p><p>収録内容：会社概要／対応するサイト／制作の進め方／実績数値</p><TextArrowLink site={site} href="assets/noxray-company.html" label="会社資料を保存する（HTML）" /><p><small>入力不要。ブラウザーで開いて印刷できます。</small></p></div></div></section><section id="web"><AxisRule /><h2>Web刷新の前に、判断軸をそろえる。</h2><ScrollReveal animation="fade" duration={820}><DesignNotes numbered notes={[{title:'目的を言葉にする',body:'問い合わせを増やしたい、事業を正しく伝えたい。今回の刷新で変えたいことを整理し、何を優先するかを社内でそろえます。'},{title:'訪問者と情報を整理する',body:'誰がサイトを訪れ、何を知って判断するのか。現在のページで不足している情報や、探しにくい情報を書き出します。'},{title:'公開後の確認方法を考える',body:'問い合わせ数だけでなく、詳細ページへの移動や入力までの行動も確認対象にします。'}]} /></ScrollReveal><TextArrowLink site={site} href="/contact/" label="整理した内容を相談する" /></section><section id="recruitment" class="dark"><AxisRule /><h2>採用サイトで、何を伝えるか。</h2><DesignNotes dark numbered notes={[{title:'仕事の姿を具体化する',body:'仕事内容と役割、事業との関係を整理します。候補者が入社後の自分を考えられる情報があるかを確認します。'},{title:'判断に必要な情報をそろえる',body:'働く環境、募集内容、応募までの流れを確認します。魅力と条件を確かめる情報の両方を用意します。'},{title:'応募までの迷いを減らす',body:'仕事紹介から募集情報、入力へ進む導線を確認します。スマートフォンでも必要な情報を見つけられるかを確かめます。'}]} /><TextArrowLink site={site} href="/contact/" label="採用サイトについて相談する" /></section><ConsultationRows site={site} downloadHref="/download/#company" /></SiteLayout><style>section{padding:80px 20px}section>*{max-width:900px;margin-left:auto;margin-right:auto}h2{font-size:clamp(28px,4vw,40px)}p{line-height:1.9}.links{display:flex;flex-wrap:wrap;gap:16px;margin-top:24px}.links a{text-decoration:underline}.pale{background:#e3e7e3}.dark{background:#142326;color:#f4f3ee}.doc{display:grid;gap:48px;align-items:center}.cover{aspect-ratio:1/1.414;background:#f4f3ee;padding:32px;display:flex;flex-direction:column;justify-content:space-between}.cover strong{font-size:32px}@media(min-width:768px){section{padding:120px 32px}.doc{grid-template-columns:35% 55%;justify-content:space-between}}</style>
