---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import PageIntro from '../../../../../components/sections/PageIntro.astro'; import SectionTitle from '../../../../../components/ui/SectionTitle.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro';
---
<SiteLayout site={site} title="無料相談・見積もり" description="Web刷新、採用強化、キャンペーン施策について現在の状況をお聞きし、依頼内容が固まっていない段階から相談できる無料相談・見積もりの入力ページです。" path="/contact/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'無料相談・見積もり'}]}>
<section id="hero"><PageIntro title="無料相談・見積もり" description="Web刷新、採用強化、キャンペーン施策について、現在の状況をお聞かせください。依頼内容が固まっていない段階でも、課題の整理からご相談いただけます。" /><div class="mx-auto max-w-6xl px-5 pb-12 lg:px-8"><div class="rounded-sm bg-base-200 p-5 leading-8">このフォームは制作サンプルです。入力内容の確認までお試しいただけます。情報は送信されません。実際の個人情報は入力しないでください。</div><AxisRule class="mt-10" /></div></section>
<section id="consultation" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto max-w-3xl"><SectionTitle title="ご相談内容" align="left" /><div id="error-summary" role="alert" tabindex="-1" class="hidden bg-error/15 p-5 text-error"></div><form id="noxray-form" class="mt-10 space-y-8" novalidate><label>会社名（必須）<input name="company" required class="input input-bordered mt-2 h-14 w-full" /></label><label>お名前（必須）<input name="name" required class="input input-bordered mt-2 h-14 w-full" /></label><label>メールアドレス（必須）<input name="email" type="email" required class="input input-bordered mt-2 h-14 w-full" /></label><fieldset><legend>相談したい内容（必須）</legend><div class="mt-3 flex flex-wrap gap-5">{['ブランドサイト','採用サイト','キャンペーンLP','改善運用・その他'].map(v => <label><input type="radio" name="kind" value={v} required class="radio radio-primary mr-2" />{v}</label>)}</div></fieldset><label>現在の状況・ご要望（必須）<span class="block text-sm">現在困っていること、検討している内容などをご記入ください。</span><textarea name="message" required class="textarea textarea-bordered mt-2 h-52 w-full"></textarea></label><label>対象サイトのURL（任意）<input name="url" type="url" class="input input-bordered mt-2 h-14 w-full" /></label><label class="flex gap-3"><input name="privacy" type="checkbox" required class="checkbox checkbox-primary" /><span><a href="/sites/corporate/a-20260920-1616/privacy/" class="underline">個人情報の取り扱い</a>を確認しました。</span></label><button class="btn btn-primary">入力内容を確認する</button></form><section id="confirmation" class="hidden"><h2 tabindex="-1" class="text-3xl">入力内容の確認</h2><p class="mt-5 leading-9">入力内容をご確認ください。このフォームは制作サンプルのため、送信は行いません。</p><dl id="confirm-values" class="mt-8 space-y-4"></dl><button id="back" class="btn btn-outline mt-8">入力に戻る</button><button id="finish" class="btn btn-primary mt-8 ml-3">確認を終了する</button></section><section id="finished" class="hidden"><h2 class="text-3xl">確認が完了しました。</h2><p class="mt-5">入力内容は送信されていません。</p><a href="/sites/corporate/a-20260920-1616/" class="btn btn-primary mt-8">トップへ戻る</a></section></div></section>
<section id="preparation" class="bg-base-200 px-5 py-20 lg:px-8"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[35%_55%]"><SectionTitle title="まとまっていなくても、大丈夫です。" align="left" /><ScrollReveal animation="fade" duration={820}><DesignNotes notes={[{title:'目的',body:'何を変えたいか。問い合わせ、採用応募、事業理解など、重視したいことをお聞かせください。'},{title:'現状',body:'現在のサイトや運用で困っていること。分かる範囲でご記入ください。'},{title:'検討状況',body:'希望する時期や社内での検討段階。未定の項目は、未定のままで構いません。'}]} /><TextArrowLink site={site} href="/download/" label="まず資料で確認する" class="mt-7" /></ScrollReveal></div></section><ConsultationRows site={site} contactHref="/contact/#consultation" />
</SiteLayout>
<script>
  const form = document.querySelector<HTMLFormElement>('#noxray-form');
  const summary = document.querySelector<HTMLElement>('#error-summary');
  const confirmation = document.querySelector<HTMLElement>('#confirmation');
  const finished = document.querySelector<HTMLElement>('#finished');
  const values = document.querySelector<HTMLElement>('#confirm-values');
  form?.addEventListener('submit', (event) => {
    event.preventDefault(); const data = new FormData(form); const errors:string[] = [];
    ['company','name','email','message'].forEach((key) => { if (!String(data.get(key) || '').trim()) errors.push('この項目を入力してください。'); });
    if (!data.get('kind')) errors.push('相談したい内容を選択してください。');
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(String(data.get('email') || ''))) errors.push('メールアドレスの形式を確認してください。');
    if (!data.get('privacy')) errors.push('個人情報の取り扱いを確認してください。');
    if (errors.length) { if (summary) { summary.textContent = [...new Set(errors)].join(' '); summary.classList.remove('hidden'); summary.focus(); } return; }
    if (values) values.innerHTML = ['company','name','email','kind','message','url'].filter(k => data.get(k)).map(k => `<div><dt>${k}</dt><dd>${String(data.get(k)).replace(/[&<>"']/g, '')}</dd></div>`).join('');
    form.classList.add('hidden'); summary?.classList.add('hidden'); confirmation?.classList.remove('hidden'); confirmation?.querySelector<HTMLElement>('h2')?.focus();
  });
  document.querySelector('#back')?.addEventListener('click', () => { confirmation?.classList.add('hidden'); form?.classList.remove('hidden'); });
  document.querySelector('#finish')?.addEventListener('click', () => { confirmation?.classList.add('hidden'); finished?.classList.remove('hidden'); form?.reset(); });
</script>
