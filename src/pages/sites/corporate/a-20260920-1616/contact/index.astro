---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import NoxrayPageIntro from '../../../../../components/sections/NoxrayPageIntro.astro'; import NoxrayConsultationForm from '../../../../../components/sections/NoxrayConsultationForm.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="無料相談・見積もり" description="Web刷新、採用強化、キャンペーン施策について、依頼内容が固まっていない段階から状況を整理してご相談いただけます。" path="/contact/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'無料相談・見積もり'}]}><NoxrayPageIntro eyebrow="無料相談・見積もり" english="CONTACT" title="現在の状況を、お聞かせください。" description="Web刷新、採用強化、キャンペーン施策について、現在の状況をお聞かせください。依頼内容が固まっていない段階でも、課題の整理からご相談いただけます。"><AxisRule /><p>このフォームは制作サンプルです。入力内容の確認までお試しいただけます。情報は送信されません。実際の個人情報は入力しないでください。</p></NoxrayPageIntro><section id="consultation"><AxisRule /><h2>ご相談内容</h2><ScrollReveal animation="fade" duration={820}><NoxrayConsultationForm /></ScrollReveal></section><section id="preparation" class="pale"><AxisRule /><h2>まとまっていなくても、大丈夫です。</h2><ScrollReveal animation="fade" duration={820}><DesignNotes notes={[{title:'目的',body:'何を変えたいか。問い合わせ、採用応募、事業理解など、重視したいことをお聞かせください。'},{title:'現状',body:'現在のサイトや運用で困っていること。分かる範囲でご記入ください。'},{title:'検討状況',body:'希望する時期や社内での検討段階。未定の項目は、未定のままで構いません。'}]} /></ScrollReveal><TextArrowLink site={site} href="/download/" label="まず資料で確認する" /></section><ConsultationRows site={site} contactHref="/contact/#consultation" /></SiteLayout><style>section{padding:80px 20px}section>*{max-width:800px;margin-left:auto;margin-right:auto}h2{font-size:clamp(28px,4vw,40px)}.pale{background:#e3e7e3}@media(min-width:768px){section{padding:120px 32px}}</style>
