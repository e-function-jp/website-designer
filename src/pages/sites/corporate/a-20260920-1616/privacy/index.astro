---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import PageIntro from '../../../../../components/sections/PageIntro.astro'; import SectionTitle from '../../../../../components/ui/SectionTitle.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro';
---
<SiteLayout site={site} title="個人情報の取り扱い" description="架空企業である株式会社ノクスレイの制作サンプルで、フォームに入力された情報を確認画面だけで扱い、送信や保存を行わないことをご案内します。" path="/privacy/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'個人情報の取り扱い'}]}>
<section id="hero"><PageIntro title="個人情報の取り扱い" description="このサイトは、架空企業である株式会社ノクスレイの制作サンプルです。フォームで入力された情報の扱いについてご案内します。" /><div class="mx-auto max-w-6xl px-5 pb-12 lg:px-8"><AxisRule /></div></section>
<section id="handling" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto max-w-3xl"><SectionTitle title="フォームの入力について" align="left" /><ScrollReveal animation="fade" duration={820}><DesignNotes notes={[{title:'フォームの入力について',body:'フォームでは、会社名、お名前、メールアドレス、相談内容、対象サイトのURLを入力できます。入力内容は同じページ内で確認するためにのみ使用します。実際の個人情報は入力しないでください。'},{title:'送信と保存について',body:'この制作サンプルには送信機能がありません。入力内容をサーバーへ送信したり、外部サービスと共有したりする処理は行いません。サイト側の処理で入力内容をブラウザーの保存領域やURLへ記録することもありません。確認を終了すると、ページ内の入力内容を消去します。'},{title:'外部サービスについて',body:'このサイトには、フォーム情報を受け取る外部サービスやアクセス解析タグを組み込みません。画像と書体はサイト内のファイルを使用します。ブラウザー自身の入力補完や、閲覧環境に関する機能は、このフォームの保存処理とは別のものです。'},{title:'資料の取得について',body:'会社資料は、連絡先の入力を必要とせずに保存できます。資料の取得を条件として個人情報を求めることはありません。'}]} /></ScrollReveal></div></section>
<section id="return" class="bg-base-200 px-5 py-20 lg:px-8"><div class="mx-auto max-w-3xl"><SectionTitle title="内容をご確認いただいた方へ。" align="left" /><p class="leading-9">このサイトのフォームは、入力内容の確認までを体験できる制作サンプルです。</p><TextArrowLink site={site} href="/contact/#consultation" label="無料相談・見積もりの入力欄へ" class="mt-7" /></div></section><ConsultationRows site={site} />
</SiteLayout>
