---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import NoxrayPageIntro from '../../../../../components/sections/NoxrayPageIntro.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="個人情報の取り扱い" description="架空企業の制作サンプルである株式会社ノクスレイのフォームに入力された情報について、送信、保存、外部連携の扱いをご案内します。" path="/privacy/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'個人情報の取り扱い'}]}><NoxrayPageIntro eyebrow="個人情報の取り扱い" english="PRIVACY" title="入力情報の扱い" description="このサイトは、架空企業である株式会社ノクスレイの制作サンプルです。フォームで入力された情報の扱いについてご案内します。"><AxisRule /></NoxrayPageIntro><section id="handling"><AxisRule /><h2>フォームの入力について</h2><ScrollReveal animation="fade" duration={820}><DesignNotes notes={[{title:'フォームの入力について',body:'フォームでは、会社名、お名前、メールアドレス、相談内容、対象サイトのURLを入力できます。入力内容は同じページ内で確認するためにのみ使用します。実際の個人情報は入力しないでください。'},{title:'送信と保存について',body:'この制作サンプルには送信機能がありません。入力内容をサーバーへ送信したり、外部サービスと共有したりする処理は行いません。サイト側の処理で入力内容をブラウザーの保存領域やURLへ記録することもありません。確認を終了すると、ページ内の入力内容を消去します。'},{title:'外部サービスについて',body:'このサイトには、フォーム情報を受け取る外部サービスやアクセス解析タグを組み込みません。画像と書体はサイト内のファイルを使用します。'},{title:'資料の取得について',body:'会社資料は、連絡先の入力を必要とせずに保存できます。資料の取得を条件として個人情報を求めることはありません。'}]} /></ScrollReveal></section><section id="return" class="pale"><AxisRule /><h2>内容をご確認いただいた方へ。</h2><p>このサイトのフォームは、入力内容の確認までを体験できる制作サンプルです。</p><TextArrowLink site={site} href="/contact/#consultation" label="無料相談・見積もりの入力欄へ" /></section><ConsultationRows site={site} /></SiteLayout><style>section{padding:80px 20px}section>*{max-width:760px;margin-left:auto;margin-right:auto}h2{font-size:clamp(28px,4vw,40px)}p{line-height:1.9}.pale{background:#e3e7e3}@media(min-width:768px){section{padding:120px 32px}}</style>
