---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { site } from './_site';
import AxisRule from '../../../../components/sections/AxisRule.astro';
import TextArrowLink from '../../../../components/sections/TextArrowLink.astro';
import WorkScreen from '../../../../components/sections/WorkScreen.astro';
import NoxrayWorkGrid from '../../../../components/sections/NoxrayWorkGrid.astro';
import ConsultationRows from '../../../../components/sections/ConsultationRows.astro';
import ScrollReveal from '../../../../components/ui/ScrollReveal.astro';
import GsapScrollSection from '../../../../components/animations/GsapScrollSection.astro';
const image = '/sites/corporate/_shared/20260920-1616/';
const works = [
  { label: '制作イメージ', title: '事業の強みを、相談の入口へ。', description: '事業理解、支援内容、問い合わせへと判断材料をつなぐ設計です。', href: '/works/brand/', image: `${image}img-a-02.jpg`, alt: '奥行きのある落ち着いた業務空間', ratio: 'landscape' as const },
  { label: '制作イメージ', title: '働く姿から、応募の判断へ。', description: '会社と仕事への理解を深め、募集情報と応募導線へつなぐ設計です。', href: '/works/recruitment/', image: `${image}img-a-03.jpg`, alt: '資料を確認しながら仕事を進める人たち', ratio: 'portrait' as const },
  { label: '制作イメージ', title: '広告の関心を、具体的な相談へ。', description: '施策の訴求とページの情報をそろえ、相談までの流れを整理する設計です。', href: '/works/campaign/', image: `${image}img-a-04.jpg`, alt: '相談内容を整理する机上の手元', ratio: 'wide' as const },
];
---
<SiteLayout site={site} title="伝わる設計で、成果を積む。" description="中堅BtoB企業のブランドサイト・採用サイト・キャンペーンLPを、企画設計から公開後の改善運用まで一貫して支援します。" path="/" isHome>
  <section id="hero" class="hero">
    <div class="hero__background" aria-hidden="true"><GsapScrollSection animation="parallax" scrub={true} start="top top" end="bottom top" x={320} y={430} fallback="none" class="hero__parallax"><div data-gsap-parallax-target class="hero__collage"><WorkScreen image={`${image}img-a-02.jpg`} alt="" title="" eager /><WorkScreen image={`${image}img-a-03.jpg`} alt="" title="" ratio="portrait" /><WorkScreen image={`${image}img-a-04.jpg`} alt="" title="" ratio="wide" /></div></GsapScrollSection></div>
    <div class="hero__copy"><p>DESIGN<br />THAT WORKS</p><h1>伝わる設計で、<br />成果を積む。</h1><span>中堅BtoB企業のブランドサイト・採用サイト・キャンペーンLPを、企画設計から公開後の改善運用まで。</span><TextArrowLink site={site} href="/service/" label="Web制作・改善運用を見る" /></div><AxisRule />
  </section>
  <section id="stance" class="dark section"><AxisRule /><ScrollReveal animation="clip-up" duration={820}><h2>伝わることから、<br />成果は始まる。</h2></ScrollReveal><div class="prose"><ScrollReveal animation="fade-up" duration={820}><p>事業の価値は、詳しく説明するだけでは届きません。誰が、何を知り、どのように判断するのか。ノクスレイは業種ごとの検討の流れを踏まえて、情報の順序と接点を設計します。</p></ScrollReveal><ScrollReveal animation="fade-up" duration={820} delay={100}><p>公開は、その設計を確かめる出発点です。問い合わせや採用応募につながる動きを計測し、改善を積み重ねます。</p></ScrollReveal><ScrollReveal animation="fade" duration={820} delay={160}><TextArrowLink site={site} href="/about/" label="私たちについて" /></ScrollReveal></div></section>
  <section id="service-summary" class="section"><AxisRule /><div class="split"><div><ScrollReveal animation="clip-up" duration={820}><h2>企画から改善まで、<br />ひとつの設計で。</h2></ScrollReveal><ScrollReveal animation="fade-up" duration={820} delay={80}><p>ブランドサイト、採用サイト、キャンペーンLP。それぞれの目的に合わせて、情報設計、UI制作、計測設計をつなぎます。</p></ScrollReveal><ScrollReveal animation="fade" duration={820} delay={160}><TextArrowLink site={site} href="/service/" label="対応範囲と制作工程を見る" /></ScrollReveal></div><ScrollReveal animation="fade" duration={820}><div class="circles"><div><b>企画設計</b><span>業種と課題を整理</span></div><div><b>UI制作</b><span>迷わず伝わる接点へ</span></div><div><b>改善運用</b><span>計測から次の一手へ</span></div></div></ScrollReveal></div></section>
  <section id="proof" class="section proof"><AxisRule /><ScrollReveal animation="clip-up" duration={820}><h2>設計と改善の積み重ね。</h2></ScrollReveal>{[['累計制作','240件超','ブランドサイト・採用サイト・キャンペーンLPの制作を積み重ねています。'],['公開後90日の問い合わせ','平均1.8倍','公開後の問い合わせの変化を、改善の判断材料にしています。'],['取引継続率','87%','公開後の改善運用まで、継続して支援します。']].map(([label, number, text], index) => <ScrollReveal animation="fade-up" duration={820} delay={index * 80}><article><div><h3>{label}</h3><p>{text}</p></div><strong>{number}</strong></article></ScrollReveal>)}<ScrollReveal animation="fade" duration={820}><small>数値は本サンプルの企業設定に基づきます。個別案件の成果を保証するものではありません。</small></ScrollReveal></section>
  <section id="works" class="dark section works"><AxisRule /><ScrollReveal animation="clip-up" duration={820}><h2>制作実績と、<br />設計の考え方。</h2></ScrollReveal><ScrollReveal animation="fade-up" duration={820} delay={80}><p>何を見せ、どこへつなぐか。対応するサイトの制作イメージから、情報設計の考え方をご紹介します。</p></ScrollReveal><ScrollReveal animation="fade-up" duration={820}><NoxrayWorkGrid site={site} works={[...works, { label: '制作イメージ', title: '公開後の動きから、次の改善へ。', description: '公開後に確認する行動を整理し、情報の見せ方や導線を改善します。', href: '/works/brand/#measurement', image: `${image}img-a-06.jpg`, alt: '画面上の動きを確認して改善を検討する手元', ratio: 'portrait' }]} dark /></ScrollReveal><ScrollReveal animation="fade" duration={820}><TextArrowLink site={site} href="/works/" label="制作実績を見る" /></ScrollReveal></section>
  <section id="guides" class="section"><AxisRule /><ScrollReveal animation="clip-up" duration={820}><h2>Web刷新の前に、判断軸をそろえる。</h2></ScrollReveal><ScrollReveal animation="fade-up" duration={820} delay={80}><p>目的、訪問者、問い合わせまでの導線。制作を始める前に整理しておきたい項目をまとめました。</p></ScrollReveal><ScrollReveal animation="fade" duration={820} delay={160}><TextArrowLink site={site} href="/download/#web" label="Web刷新の検討ガイドを読む" /></ScrollReveal><ScrollReveal animation="clip-up" duration={820}><h2>採用サイトで、何を伝えるか。</h2></ScrollReveal><ScrollReveal animation="fade-up" duration={820} delay={80}><p>仕事、働く環境、応募までの流れ。候補者の判断に必要な情報を、社内で確認するためのガイドです。</p></ScrollReveal><ScrollReveal animation="fade" duration={820} delay={160}><TextArrowLink site={site} href="/download/#recruitment" label="採用強化の検討ガイドを読む" /></ScrollReveal></section>
  <ConsultationRows site={site} />
</SiteLayout>
<style>
 .hero{min-height:100svh;background:#142326;color:#f4f3ee;position:relative;overflow:hidden}.hero__background,.hero__parallax{position:absolute;inset:0;overflow:hidden}.hero__background{opacity:.58}.hero__background::after{position:absolute;inset:0;content:"";background:linear-gradient(90deg,#142326 0%,rgb(20 35 38/.86) 38%,rgb(20 35 38/.25) 72%,rgb(20 35 38/.4) 100%);pointer-events:none;z-index:1}.hero__collage{display:grid;grid-template-columns:1.2fr .8fr;gap:24px;padding:110px 8%;min-width:100%;min-height:100%}.hero :global(.work-screen),.works :global(.work-screen){border-radius:10px}.hero__collage :global(.work-screen:nth-child(2)){margin-top:90px}.hero__collage :global(.work-screen:nth-child(3)){grid-column:1/-1;width:55%;margin-left:auto}.hero__copy{position:relative;z-index:2;box-sizing:border-box;display:flex;flex-direction:column;justify-content:flex-end;min-height:100svh;max-width:850px;padding:180px 20px 64px}.hero__copy p{margin:0 0 12px;font:700 clamp(28px,5vw,64px)/1.1 Inter,sans-serif;letter-spacing:.04em}.hero h1{margin:0 0 20px;font-size:clamp(48px,5vw,72px);line-height:1.3}.hero__copy span{display:block;max-width:650px;line-height:1.9}.hero :global(.axis-rule){position:absolute;z-index:2;left:20px;right:20px;bottom:180px;width:auto}.section{padding:80px 20px}.section>*,.split{max-width:1200px;margin-left:auto;margin-right:auto}.section h2{font-size:clamp(40px,3.5vw,56px);line-height:1.35}.dark{background:#142326;color:#f4f3ee}.dark h2{font-size:clamp(46px,8vw,112px);line-height:1.3}.prose{max-width:760px;margin:80px 0 0 auto;line-height:1.9}.prose :global(.scroll-reveal + .scroll-reveal){margin-top:1.5rem}.split{display:grid;gap:48px}.split p{max-width:42rem;line-height:1.9}.circles{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}.circles div{aspect-ratio:1;border-radius:50%;background:#203438;color:#f4f3ee;display:grid;place-content:center;text-align:center;padding:16px}.circles div:first-child{grid-column:1/-1;width:50%;justify-self:center}.circles span{font-size:14px;margin-top:8px} .proof{background:#e3e7e3}.proof article{background:#203438;color:#f4f3ee;margin:24px auto;padding:28px;max-width:840px;display:grid;gap:16px}.proof article p{line-height:1.8}.proof strong{font-size:clamp(52px,5vw,68px);white-space:nowrap}.proof small{display:block;max-width:840px;margin:24px auto}.works>p{max-width:720px;line-height:1.9}@media(min-width:768px){.section{padding:160px 32px}.hero h1{font-size:clamp(56px,5vw,72px)}.split{grid-template-columns:minmax(0,46%) minmax(0,1fr);align-items:center}.circles{grid-template-columns:repeat(2,250px);justify-content:end}.proof article{grid-template-columns:minmax(0,55%) minmax(0,45%);align-items:center;padding:40px 56px}.hero__copy{padding-left:32px}}@media(max-width:600px){.hero{min-height:760px}.hero__collage{padding:92px 20px;gap:10px}.hero :global(.work-screen),.works :global(.work-screen){border-radius:6px}.hero__copy{min-height:760px;padding-top:330px;padding-bottom:40px}.hero :global(.axis-rule){bottom:300px}.dark h2{font-size:46px}.works{padding-bottom:104px}}
</style>
