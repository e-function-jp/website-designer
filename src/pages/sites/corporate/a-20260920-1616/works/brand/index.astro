---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import NoxrayPageIntro from '../../../../../../components/sections/NoxrayPageIntro.astro'; import WorkScreen from '../../../../../../components/sections/WorkScreen.astro'; import DesignNotes from '../../../../../../components/sections/DesignNotes.astro'; import AxisRule from '../../../../../../components/sections/AxisRule.astro'; import TextArrowLink from '../../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro'; const image='/sites/corporate/_shared/20260920-1616/';
---
<SiteLayout site={site} title="ブランドサイトの制作イメージ" description="中堅BtoB企業の事業理解から問い合わせまでをつなぐ、ブランドサイトの情報設計と公開後の改善を示す制作イメージです。" path="/works/brand/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績',href:'/works/'},{label:'ブランドサイトの制作イメージ'}]}><NoxrayPageIntro eyebrow="制作実績" english="WORKS" title="事業の強みを、相談の入口へ。" description="中堅BtoB企業の事業理解から問い合わせまでをつなぐ、情報設計の例です。このページは制作イメージです。実在の顧客案件や個別の成果を示すものではありません。"><AxisRule /></NoxrayPageIntro><section id="hero"><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${image}img-a-02.jpg`} alt="奥行きのある落ち着いた業務空間" title="事業の価値を、次の可能性へ。" nav="事業紹介／強み／会社情報" cta="相談する" eager /></ScrollReveal></section><section id="information-design"><AxisRule /><h2>情報設計の考え方</h2><DesignNotes notes={[{title:'何をする会社かを、最初に。',body:'トップでは事業の説明と主な支援内容を近接させ、初めて訪れた方が自分の課題との関係をつかめる構成にします。'},{title:'主張の後に、判断材料を。',body:'強みを伝える文章の後に、対応範囲や制作の考え方への導線を置きます。抽象的な表現だけで検討が止まらないようにします。'},{title:'相談への入口を、各ページに。',body:'下層ページでも資料と相談の導線を共通化し、トップへ戻らず次の行動を選べるようにします。'}]} /><p class="flow">事業を知る → 強みを確かめる → 相談する</p></section><section id="measurement" class="dark"><AxisRule /><h2>公開後の動きから、次の改善へ。</h2><p>問い合わせ数だけでなく、どの情報が読まれ、どの導線から相談へ進んだかを確認します。訪問者の行動をもとに、情報の不足や迷いやすい箇所を見直す考え方です。</p><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${image}img-a-06.jpg`} alt="画面上の動きを確認して改善を検討する手元" title="確認すること" ratio="wide" /></ScrollReveal><p>確認すること：事業紹介から詳細への移動／資料・相談導線の利用／入力前後の離脱</p><TextArrowLink site={site} href="/service/#operate" label="改善運用の工程を見る" /></section><section id="next"><AxisRule /><h2>次の制作イメージ</h2><TextArrowLink site={site} href="/works/recruitment/" label="働く姿から、応募の判断へ。" /><TextArrowLink site={site} href="/works/" label="制作実績一覧に戻る" /></section><ConsultationRows site={site} /></SiteLayout><style>section{padding:80px 20px}section>*{max-width:1000px;margin-left:auto;margin-right:auto}h2{font-size:clamp(28px,4vw,40px)}p{line-height:1.9}.dark{background:#142326;color:#f4f3ee}.flow{padding:32px 0;border-bottom:1px solid currentColor}@media(min-width:768px){section{padding:120px 32px}}</style>
