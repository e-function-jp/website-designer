---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import NoxrayPageIntro from '../../../../../components/sections/NoxrayPageIntro.astro'; import NoxrayWorkGrid from '../../../../../components/sections/NoxrayWorkGrid.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
const image='/sites/corporate/_shared/20260920-1616/'; const works=[{label:'制作イメージ',title:'事業の強みを、相談の入口へ。',description:'事業理解、支援内容、問い合わせへと判断材料をつなぐ設計です。',href:'/works/brand/',image:`${image}img-a-02.jpg`,alt:'奥行きのある落ち着いた業務空間',ratio:'landscape' as const},{label:'制作イメージ',title:'働く姿から、応募の判断へ。',description:'会社と仕事への理解を深め、募集情報と応募導線へつなぐ設計です。',href:'/works/recruitment/',image:`${image}img-a-03.jpg`,alt:'資料を確認しながら仕事を進める人たち',ratio:'portrait' as const},{label:'制作イメージ',title:'広告の関心を、具体的な相談へ。',description:'施策の訴求とページの情報をそろえ、相談までの流れを整理する設計です。',href:'/works/campaign/',image:`${image}img-a-04.jpg`,alt:'相談内容を整理する机上の手元',ratio:'wide' as const}];
---
<SiteLayout site={site} title="制作実績" description="ノクスレイの累計制作と、ブランドサイト、採用サイト、キャンペーンLPで判断材料をつなぐ制作イメージをご紹介します。" path="/works/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績'}]}><NoxrayPageIntro eyebrow="制作実績" english="WORKS" title="累計制作240件超。目的に合わせた設計と、公開後の改善を積み重ねています。" description="以下は、対応するサイトと設計の考え方を示す制作イメージです。実在の顧客案件や個別の成果を掲載したものではありません。" dark><AxisRule /></NoxrayPageIntro><section id="gallery"><AxisRule /><ScrollReveal animation="fade-up" duration={820}><NoxrayWorkGrid site={site} works={works} dark /></ScrollReveal></section><section id="service-link"><AxisRule /><h2>どこから依頼するかも、ご相談ください。</h2><p>企画設計、UI制作、公開後の改善運用まで。各工程で何を行うかを、サービスページでご案内しています。</p><TextArrowLink site={site} href="/service/" label="対応範囲と制作工程を見る" /></section><ConsultationRows site={site} /></SiteLayout><style>section{padding:80px 20px}#gallery{background:#142326;color:#f4f3ee}section>:not(.axis-rule){max-width:1200px;margin-left:auto;margin-right:auto}h2{font-size:clamp(28px,4vw,40px)}p{line-height:1.9;max-width:700px}@media(min-width:768px){section{padding:160px 32px}}</style>
