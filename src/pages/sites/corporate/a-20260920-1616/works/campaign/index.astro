---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import NoxrayPageIntro from '../../../../../../components/sections/NoxrayPageIntro.astro'; import WorkScreen from '../../../../../../components/sections/WorkScreen.astro'; import DesignNotes from '../../../../../../components/sections/DesignNotes.astro'; import AxisRule from '../../../../../../components/sections/AxisRule.astro'; import TextArrowLink from '../../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro'; const image='/sites/corporate/_shared/20260920-1616/';
---
<SiteLayout site={site} title="キャンペーンLPの制作イメージ" description="広告で伝えた内容とページで確かめられる情報をそろえ、関心を具体的な相談へつなぐキャンペーンLPの制作イメージです。" path="/works/campaign/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績',href:'/works/'},{label:'キャンペーンLPの制作イメージ'}]}><NoxrayPageIntro eyebrow="制作実績" english="WORKS" title="広告の関心を、具体的な相談へ。" description="広告で伝えた内容と、ページで確かめられる情報をそろえる。関心を持った方が相談へ進むための設計の例です。このページは制作イメージです。"><AxisRule /></NoxrayPageIntro><section id="hero"><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${image}img-a-04.jpg`} alt="相談内容を整理する机上の手元" title="課題を整理し、次の施策へ。" nav="支援内容／進め方／ご相談" cta="相談内容を入力" ratio="wide" /></ScrollReveal></section><section id="message-flow"><AxisRule /><h2>関心が生まれた理由から、始める。</h2><DesignNotes notes={[{title:'訴求をそろえる。',body:'広告や施策で伝えた内容を冒頭で受け止め、訪問先が期待とつながっていると分かる構成にします。'},{title:'判断材料を並べる。',body:'対象となる課題、支援内容、進め方を順に整理します。説明の順序をそろえ、相談する理由を確かめられるようにします。'},{title:'次の行動を明確にする。',body:'CTAの文言と遷移先を一致させ、押すと何ができるかを明示します。'}]} /><p>関心 → 理解 → 相談</p></section><section id="measurement" class="dark"><AxisRule /><h2>流入から相談まで、ひと続きで見る。</h2><p>どこから訪れ、どの情報を読み、どこで行動したのか。入口から相談までの動きを整理し、訴求や情報の並び、入力導線を見直す判断につなげます。</p><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${image}img-a-06.jpg`} alt="画面上の動きを確認して改善を検討する手元" title="改善運用" ratio="wide" /></ScrollReveal><TextArrowLink site={site} href="/service/" label="Web制作と改善運用を見る" /></section><section id="next"><AxisRule /><h2>次の制作イメージ</h2><TextArrowLink site={site} href="/works/brand/" label="事業の強みを、相談の入口へ。" /><TextArrowLink site={site} href="/works/" label="制作実績一覧に戻る" /></section><ConsultationRows site={site} /></SiteLayout><style>section{padding:80px 20px}section>*{max-width:1000px;margin-left:auto;margin-right:auto}h2{font-size:clamp(28px,4vw,40px)}p{line-height:1.9}.dark{background:#142326;color:#f4f3ee}@media(min-width:768px){section{padding:120px 32px}}</style>
