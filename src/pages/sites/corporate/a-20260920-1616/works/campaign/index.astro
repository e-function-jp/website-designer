---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import PageIntro from '../../../../../../components/sections/PageIntro.astro'; import SectionTitle from '../../../../../../components/ui/SectionTitle.astro'; import AxisRule from '../../../../../../components/sections/AxisRule.astro'; import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro'; import TextArrowLink from '../../../../../../components/sections/TextArrowLink.astro'; import WorkScreen from '../../../../../../components/sections/WorkScreen.astro'; import DesignNotes from '../../../../../../components/sections/DesignNotes.astro'; import ConsultationRows from '../../../../../../components/sections/ConsultationRows.astro';
const base='/sites/corporate/_shared/20260920-1616/';
---
<SiteLayout site={site} title="キャンペーンLPの制作イメージ" description="広告で伝えた内容とページで確かめられる情報をそろえ、関心を持った方が具体的な相談へ進むためのキャンペーンLP制作イメージです。" path="/works/campaign/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績',href:'/works/'},{label:'キャンペーンLPの制作イメージ'}]}>
<section id="hero"><PageIntro title="広告の関心を、具体的な相談へ。" description="広告で伝えた内容と、ページで確かめられる情報をそろえる。関心を持った方が相談へ進むための設計の例です。" /><div class="mx-auto max-w-5xl px-5 pb-20 lg:px-8"><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${base}img-a-04.jpg`} alt="相談内容を整理する机上の手元" title="課題を整理し、次の施策へ。" nav="支援内容 / 進め方 / ご相談" cta="相談内容を入力" ratio="wide" /></ScrollReveal><p class="mt-6 max-w-3xl text-sm">このページは制作イメージです。実在の顧客案件や個別の成果を示すものではありません。</p></div></section>
<section id="message-flow" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[25%_65%]"><SectionTitle title="関心が生まれた理由から、始める。" align="left" /><div><AxisRule /><DesignNotes notes={[{title:'訴求をそろえる。',body:'広告や施策で伝えた内容を冒頭で受け止め、訪問先が期待とつながっていると分かる構成にします。'},{title:'判断材料を並べる。',body:'対象となる課題、支援内容、進め方を順に整理します。説明の順序をそろえ、相談する理由を確かめられるようにします。'},{title:'次の行動を明確にする。',body:'CTAの文言と遷移先を一致させ、押すと何ができるかを明示します。入力に必要な情報も、事前に分かるようにします。'}]} /><p class="mt-10 font-bold">関心 → 理解 → 相談</p></div></div></section>
<section id="measurement" class="bg-neutral px-5 py-20 text-neutral-content lg:px-8 lg:py-28"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-2"><div><SectionTitle title="流入から相談まで、ひと続きで見る。" align="left" /><p class="leading-9">どこから訪れ、どの情報を読み、どこで行動したのか。入口から相談までの動きを整理し、訴求や情報の並び、入力導線を見直す判断につなげます。</p><p class="mt-5 text-sm">制作例のため、広告実績や獲得単価は掲載していません。</p><TextArrowLink site={site} href="/service/" label="Web制作と改善運用を見る" class="mt-7" /></div><WorkScreen image={`${base}img-a-06.jpg`} alt="画面上の動きを確認して改善を検討する手元" title="" ratio="wide" /></div></section>
<section id="next" class="px-5 py-20 lg:px-8"><div class="mx-auto max-w-5xl"><SectionTitle title="次の制作イメージ" align="left" /><TextArrowLink site={site} href="/works/brand/" label="事業の強みを、相談の入口へ。" /><TextArrowLink site={site} href="/works/" label="制作実績一覧に戻る" class="ml-8" /></div></section><ConsultationRows site={site} />
</SiteLayout>
