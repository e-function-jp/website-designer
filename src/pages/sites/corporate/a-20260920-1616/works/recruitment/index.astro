---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import PageIntro from '../../../../../../components/sections/PageIntro.astro'; import SectionTitle from '../../../../../../components/ui/SectionTitle.astro'; import AxisRule from '../../../../../../components/sections/AxisRule.astro'; import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro'; import TextArrowLink from '../../../../../../components/sections/TextArrowLink.astro'; import WorkScreen from '../../../../../../components/sections/WorkScreen.astro'; import DesignNotes from '../../../../../../components/sections/DesignNotes.astro'; import ConsultationRows from '../../../../../../components/sections/ConsultationRows.astro';
const base='/sites/corporate/_shared/20260920-1616/';
---
<SiteLayout site={site} title="採用サイトの制作イメージ" description="会社、仕事、働く環境、募集情報を候補者の理解の順序に沿ってつなぎ、応募の判断を支える採用サイトの制作イメージです。" path="/works/recruitment/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績',href:'/works/'},{label:'採用サイトの制作イメージ'}]}>
<section id="hero"><PageIntro title="働く姿から、応募の判断へ。" description="会社、仕事、働く環境、募集情報。候補者が知りたいことを、理解の順序に沿ってつなぐ設計の例です。" /><div class="mx-auto grid max-w-6xl gap-10 px-5 pb-20 lg:grid-cols-[58%_28%] lg:px-8"><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${base}img-a-03.jpg`} alt="資料を確認しながら仕事を進める人たち" title="仕事を知る。その先の自分を考える。" nav="仕事を知る / 働く環境 / 募集情報" cta="募集情報を見る" ratio="portrait" /></ScrollReveal><div class="self-end"><p class="text-sm leading-8">このページは制作イメージです。実在の顧客案件や個別の成果を示すものではありません。</p><p class="mt-6 leading-9">人物の写真は、仕事の説明と近接させる。雰囲気だけで終わらせず、働く姿への理解を支える。</p></div></div></section>
<section id="candidate-journey" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto grid max-w-5xl gap-10 lg:grid-cols-[25%_65%]"><SectionTitle title="応募の前に、知りたいことを。" align="left" /><div><AxisRule /><DesignNotes notes={[{title:'会社を知る。',body:'事業の内容と仕事の関係を示し、どのような価値を届ける会社なのかを理解できるようにします。'},{title:'仕事を知る。',body:'仕事内容、役割、働く環境を分けて整理します。抽象的な魅力だけでなく、入社後の姿を考えるための情報を置きます。'},{title:'応募を考える。',body:'募集情報と応募までの手順を近くに置きます。条件を確認した後に、迷わず次の行動を選べる構成にします。'}]} /></div></div></section>
<section id="improvement" class="bg-neutral px-5 py-20 text-neutral-content lg:px-8 lg:py-28"><div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[55%_35%]"><div><SectionTitle title="応募の数と、その前の行動を。" align="left" /><p class="leading-9">募集情報にたどり着くまでの動きや、入力前の離脱を確認することで、どこに説明や導線の改善が必要かを考えます。</p><TextArrowLink site={site} href="/service/#recruitment-services" label="採用サイトの対応範囲を見る" class="mt-7" /></div><DesignNotes dark notes={[{title:'仕事紹介の閲覧',body:'候補者が仕事内容を確かめる流れを確認します。'},{title:'募集情報への移動',body:'仕事の理解から条件確認へ進めるかを確認します。'},{title:'応募入力への到達',body:'制作例のため、応募実績や改善率は掲載していません。'}]} /></div></section>
<section id="next" class="px-5 py-20 lg:px-8"><div class="mx-auto max-w-5xl"><SectionTitle title="次の制作イメージ" align="left" /><TextArrowLink site={site} href="/works/campaign/" label="広告の関心を、具体的な相談へ。" /><TextArrowLink site={site} href="/works/" label="制作実績一覧に戻る" class="ml-8" /></div></section><ConsultationRows site={site} />
</SiteLayout>
