---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import NoxrayPageIntro from '../../../../../../components/sections/NoxrayPageIntro.astro'; import WorkScreen from '../../../../../../components/sections/WorkScreen.astro'; import DesignNotes from '../../../../../../components/sections/DesignNotes.astro'; import AxisRule from '../../../../../../components/sections/AxisRule.astro'; import TextArrowLink from '../../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro'; const image='/sites/corporate/_shared/20260920-1616/';
---
<SiteLayout site={site} title="採用サイトの制作イメージ" description="会社、仕事、働く環境、募集情報を候補者の理解の順序に沿ってつなぐ、採用サイトの情報設計の制作イメージです。" path="/works/recruitment/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績',href:'/works/'},{label:'採用サイトの制作イメージ'}]}><NoxrayPageIntro eyebrow="制作実績" english="WORKS" title="働く姿から、応募の判断へ。" description="会社、仕事、働く環境、募集情報。候補者が知りたいことを、理解の順序に沿ってつなぐ設計の例です。このページは制作イメージです。"><AxisRule /></NoxrayPageIntro><section id="hero"><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${image}img-a-03.jpg`} alt="資料を確認しながら仕事を進める人たち" title="仕事を知る。その先の自分を考える。" nav="仕事を知る／働く環境／募集情報" cta="募集情報を見る" ratio="portrait" /></ScrollReveal><p>人物の写真は、仕事の説明と近接させる。雰囲気だけで終わらせず、働く姿への理解を支える。</p></section><section id="candidate-journey"><AxisRule /><h2>応募の前に、知りたいことを。</h2><DesignNotes notes={[{title:'会社を知る。',body:'事業の内容と仕事の関係を示し、どのような価値を届ける会社なのかを理解できるようにします。'},{title:'仕事を知る。',body:'仕事内容、役割、働く環境を分けて整理します。抽象的な魅力だけでなく、入社後の姿を考えるための情報を置きます。'},{title:'応募を考える。',body:'募集情報と応募までの手順を近くに置きます。条件を確認した後に、迷わず次の行動を選べる構成にします。'}]} /></section><section id="improvement" class="dark"><AxisRule /><h2>応募の数と、その前の行動を。</h2><p>募集情報にたどり着くまでの動きや、入力前の離脱を確認することで、どこに説明や導線の改善が必要かを考えます。</p><DesignNotes dark notes={[{title:'仕事紹介の閲覧',body:'仕事への理解が深まる情報を確認します。'},{title:'募集情報への移動',body:'条件を確かめる導線を確認します。'},{title:'応募入力への到達',body:'入力前の迷いを見直します。'}]} /><TextArrowLink site={site} href="/service/#recruitment-services" label="採用サイトの対応範囲を見る" /></section><section id="next"><AxisRule /><h2>次の制作イメージ</h2><TextArrowLink site={site} href="/works/campaign/" label="広告の関心を、具体的な相談へ。" /><TextArrowLink site={site} href="/works/" label="制作実績一覧に戻る" /></section><ConsultationRows site={site} /></SiteLayout><style>section{padding:80px 20px}section>*{max-width:880px;margin-left:auto;margin-right:auto}h2{font-size:clamp(28px,4vw,40px)}p{line-height:1.9}.dark{background:#142326;color:#f4f3ee}@media(min-width:768px){section{padding:120px 32px}#hero :global(.work-screen){max-width:58%;margin-left:0}}</style>
