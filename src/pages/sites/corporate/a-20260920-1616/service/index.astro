---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import NoxrayPageIntro from '../../../../../components/sections/NoxrayPageIntro.astro'; import AxisRule from '../../../../../components/sections/AxisRule.astro'; import DesignNotes from '../../../../../components/sections/DesignNotes.astro'; import WorkScreen from '../../../../../components/sections/WorkScreen.astro'; import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro'; import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
const image='/sites/corporate/_shared/20260920-1616/'; const web=[['課題整理・情報設計','事業の強みと訪問者の疑問を整理し、必要なページと情報の順序を決めます。'],['ブランドサイト制作','事業への理解を深め、サービスの検討と問い合わせにつながる構成・UIをつくります。'],['キャンペーンLP制作','広告や施策で生まれた関心を受け止め、相談までの情報と導線をまとめます。'],['UI制作・実装','文字、画像、操作の優先順位をそろえ、端末に応じた読みやすさと使いやすさを整えます。'],['計測設計・改善運用','確認する行動と指標を整理し、公開後の動きから改善の優先順位を考えます。']]; const recruitment=[['候補者の情報整理','検討する人が知りたい仕事や環境を整理し、サイトに必要な情報を明確にします。'],['採用情報の構成設計','会社、仕事、働く環境、募集情報を、理解が深まる順序に並べます。'],['仕事を伝えるページ設計','仕事内容と役割が伝わる構成を考え、入社後の姿を具体的に捉えられる情報を整えます。'],['採用サイトのUI制作','文章と写真の関係を整理し、スマートフォンでも仕事の魅力を読み取れる画面にします。'],['応募導線の設計','募集情報から入力までの流れをそろえ、応募前の確認事項を分かりやすく示します。'],['応募につながる改善','ページの閲覧や応募までの動きを確認し、情報の不足や導線の迷いを見直します。']];
---
<SiteLayout site={site} title="Web制作・改善運用" description="企画設計、UI制作、実装・公開、改善運用を一貫して支援し、ブランドサイトと採用サイトの判断材料を整えます。" path="/service/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'Web制作・改善運用'}]}><NoxrayPageIntro eyebrow="Web制作・改善運用" english="SERVICE" title="企画から改善までを、／専門チームがつなぎ、／一貫した制作を実現。" description="事業の強みを伝えるサイトから、採用応募や問い合わせにつなぐ接点まで。企画設計、UI制作、公開後の改善を一貫して支援します。"><AxisRule /></NoxrayPageIntro>
<section id="scope" class="section"><AxisRule /><h2>つくる前から、公開の先まで。</h2><p>企画の意図をUIへ、UIの意図を計測へ。各工程で判断したことを次の工程につなぎ、公開後も改善できるサイトを設計します。</p><div class="scope">{['企画・設計','UI制作','実装・公開','改善運用'].map((item,index)=><ScrollReveal animation={index ? 'fade-left':'fade'} duration={820}><div>{item}</div></ScrollReveal>)}</div></section>
<section id="web-services" class="section"><AxisRule /><h2>事業を伝え、相談につなぐWeb制作。</h2><p>ブランドサイトとキャンペーンLPを、目的と訪問者に合わせて設計します。</p><ScrollReveal animation="fade-up" duration={820}><DesignNotes notes={web.map(([title,body])=>({title,body}))} /></ScrollReveal></section>
<section id="recruitment-services" class="section pale"><AxisRule /><h2>働く姿を伝え、応募の判断を支える。</h2><p>採用サイトの企画・制作・改善を、候補者が知りたいことから組み立てます。</p><ScrollReveal animation="fade-up" duration={820}><DesignNotes notes={recruitment.map(([title,body])=>({title,body}))} /></ScrollReveal></section>
<section id="process" class="section dark"><AxisRule /><div class="workflow"><aside><h2>WORKFLOW</h2><p>制作の進め方</p><nav aria-label="制作工程"><a href="#plan">01 企画・設計</a><a href="#design">02 UI制作</a><a href="#build">03 実装・公開</a><a href="#operate">04 改善運用</a></nav></aside><div>{[{id:'plan',title:'判断の軸を、最初にそろえる。',body:'事業の目的、訪問者、現在の課題を整理します。必要な情報とページの役割、成果を確認する指標を定め、制作の判断基準を共有します。',photo:'img-a-05.jpg',alt:'ページ構成とワイヤーフレームを整理する手元'},{id:'design',title:'情報の優先順位を、画面にする。',body:'構成で定めた順序を、文字、写真、余白、操作の関係へ落とし込みます。ブランドの伝わり方と、相談・応募への進みやすさを両立させます。',photo:'img-a-02.jpg',alt:'奥行きのある落ち着いた業務空間'},{id:'build',title:'端末が変わっても、伝わるように。',body:'画面の意図を実装し、スマートフォンを含む表示と操作を確認します。情報やリンク、入力導線を点検し、公開に向けて整えます。',photo:'img-a-01.jpg',alt:'設計資料を囲んで制作について話す場面'},{id:'operate',title:'行動を確かめ、改善を積む。',body:'公開後の閲覧や問い合わせ・応募までの動きを確認します。結果から課題を整理し、情報の見せ方や導線の改善へつなげます。',photo:'img-a-06.jpg',alt:'画面上の動きを確認して改善を検討する手元'}].map((item,index)=><article id={item.id}><AxisRule /><small>0{index+1}</small><h3>{item.title}</h3><p>{item.body}</p><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${image}${item.photo}`} alt={item.alt} title={item.title} ratio={index===1?'portrait':'wide'} /></ScrollReveal></article>)}</div></div></section><ConsultationRows site={site} /></SiteLayout>
<style>.section{padding:80px 20px}.section>*{max-width:1200px;margin-left:auto;margin-right:auto}.section h2{font-size:clamp(28px,4vw,40px)}.section p{line-height:1.9;max-width:760px}.scope{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-top:48px}.scope div{border:1px solid #203438;border-radius:50%;aspect-ratio:1;display:grid;place-items:center;padding:12px;text-align:center}.pale{background:#e3e7e3}.dark{background:#142326;color:#f4f3ee}.workflow{display:grid;gap:64px}.workflow aside h2{font:700 clamp(42px,5vw,60px)/1.1 Inter,sans-serif}.workflow nav{display:grid;gap:12px}.workflow a{color:inherit;text-decoration:underline;text-underline-offset:5px}.workflow article{scroll-margin-top:120px;margin-bottom:96px}.workflow h3{font-size:clamp(28px,3vw,36px)}.workflow small{font-size:16px}@media(min-width:768px){.section{padding:120px 32px}.scope{grid-template-columns:repeat(4,1fr)}.workflow{grid-template-columns:25% 65%;justify-content:space-between}.workflow aside{position:sticky;top:110px;height:min-content}}</style>
