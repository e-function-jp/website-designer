---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import PageIntro from '../../../../../components/sections/PageIntro.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import AxisRule from '../../../../../components/sections/AxisRule.astro';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import TextArrowLink from '../../../../../components/sections/TextArrowLink.astro';
import WorkScreen from '../../../../../components/sections/WorkScreen.astro';
import DesignNotes from '../../../../../components/sections/DesignNotes.astro';
import ConsultationRows from '../../../../../components/sections/ConsultationRows.astro';
const base = '/sites/corporate/_shared/20260920-1616/';
const web = [{title:'課題整理・情報設計',body:'事業の強みと訪問者の疑問を整理し、必要なページと情報の順序を決めます。'},{title:'ブランドサイト制作',body:'事業への理解を深め、サービスの検討と問い合わせにつながる構成・UIをつくります。'},{title:'キャンペーンLP制作',body:'広告や施策で生まれた関心を受け止め、相談までの情報と導線をまとめます。'},{title:'UI制作・実装',body:'文字、画像、操作の優先順位をそろえ、端末に応じた読みやすさと使いやすさを整えます。'},{title:'計測設計・改善運用',body:'確認する行動と指標を整理し、公開後の動きから改善の優先順位を考えます。'}];
const recruitment = [{title:'候補者の情報整理',body:'検討する人が知りたい仕事や環境を整理し、サイトに必要な情報を明確にします。'},{title:'採用情報の構成設計',body:'会社、仕事、働く環境、募集情報を、理解が深まる順序に並べます。'},{title:'仕事を伝えるページ設計',body:'仕事内容と役割が伝わる構成を考え、入社後の姿を具体的に捉えられる情報を整えます。'},{title:'採用サイトのUI制作',body:'文章と写真の関係を整理し、スマートフォンでも仕事の魅力を読み取れる画面にします。'},{title:'応募導線の設計',body:'募集情報から入力までの流れをそろえ、応募前の確認事項を分かりやすく示します。'},{title:'応募につながる改善',body:'ページの閲覧や応募までの動きを確認し、情報の不足や導線の迷いを見直します。'}];
---
<SiteLayout site={site} title="Web制作・改善運用" description="事業の強みを伝えるサイトから採用応募や問い合わせにつなぐ接点まで、ノクスレイが企画設計、UI制作、公開後の改善を一貫して支援します。" path="/service/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'Web制作・改善運用'}]}>
  <section id="hero"><PageIntro title="Web制作・改善運用" description="事業の強みを伝えるサイトから、採用応募や問い合わせにつなぐ接点まで。企画設計、UI制作、公開後の改善を一貫して支援します。" /><AxisRule /></section>
  <section id="scope" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto max-w-6xl"><div class="grid gap-10 lg:grid-cols-2"><SectionTitle title="つくる前から、公開の先まで。" align="left" /><p class="leading-9">企画の意図をUIへ、UIの意図を計測へ。各工程で判断したことを次の工程につなぎ、公開後も改善できるサイトを設計します。</p></div><AxisRule class="mt-12" /><div class="mt-12 grid grid-cols-2 gap-5 lg:grid-cols-4">{['企画・設計','UI制作','実装・公開','改善運用'].map((label,i) => <ScrollReveal animation={i === 0 ? 'fade' : 'fade-left'} duration={820}><div class="stage">{label}</div></ScrollReveal>)}</div></div></section>
  <section id="web-services" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto max-w-6xl"><SectionTitle title="事業を伝え、相談につなぐWeb制作。" align="left" /><p class="max-w-2xl leading-9">ブランドサイトとキャンペーンLPを、目的と訪問者に合わせて設計します。</p><AxisRule class="mt-10" /><div class="mt-12 grid gap-8 sm:grid-cols-2 xl:grid-cols-4">{web.map(note => <ScrollReveal animation="fade-up" duration={820}><div class="border-t border-base-300 pt-6"><span class="block h-12 w-12 border border-primary"></span><h3 class="mt-6 text-xl">{note.title}</h3><p class="mt-3 leading-8">{note.body}</p></div></ScrollReveal>)}</div></div></section>
  <section id="recruitment-services" class="bg-base-200 px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto max-w-6xl"><SectionTitle title="働く姿を伝え、応募の判断を支える。" align="left" /><p class="max-w-2xl leading-9">採用サイトの企画・制作・改善を、候補者が知りたいことから組み立てます。</p><AxisRule class="mt-10" /><div class="mt-12 grid gap-8 sm:grid-cols-2 xl:grid-cols-4">{recruitment.map(note => <ScrollReveal animation="fade-up" duration={820}><div class="border-t border-base-300 pt-6"><span class="block h-12 w-12 border border-primary"></span><h3 class="mt-6 text-xl">{note.title}</h3><p class="mt-3 leading-8">{note.body}</p></div></ScrollReveal>)}</div></div></section>
  <section id="process" class="bg-neutral px-5 py-20 text-neutral-content lg:px-8 lg:py-36"><div class="mx-auto max-w-6xl"><SectionTitle title="制作の進め方" align="left" /><div class="mt-14 grid gap-20 lg:grid-cols-[25%_1fr]"><nav class="lg:sticky lg:top-28 lg:self-start"><a href="#plan">01 企画・設計</a><a href="#design">02 UI制作</a><a href="#build">03 実装・公開</a><a href="#operate">04 改善運用</a></nav><div class="space-y-24">{[['plan','01','判断の軸を、最初にそろえる。','事業の目的、訪問者、現在の課題を整理します。必要な情報とページの役割、成果を確認する指標を定め、制作の判断基準を共有します。','img-a-05.jpg'],['design','02','情報の優先順位を、画面にする。','構成で定めた順序を、文字、写真、余白、操作の関係へ落とし込みます。ブランドの伝わり方と、相談・応募への進みやすさを両立させます。','img-a-02.jpg'],['build','03','端末が変わっても、伝わるように。','画面の意図を実装し、スマートフォンを含む表示と操作を確認します。情報やリンク、入力導線を点検し、公開に向けて整えます。','img-a-01.jpg'],['operate','04','行動を確かめ、改善を積む。','公開後の閲覧や問い合わせ・応募までの動きを確認します。結果から課題を整理し、情報の見せ方や導線の改善へつなげます。','img-a-06.jpg']].map(([id,no,title,body,image]) => <article id={id}><AxisRule /><p class="mt-6 text-secondary">{no}</p><h3 class="mt-3 text-3xl">{title}</h3><p class="mt-5 max-w-2xl leading-9">{body}</p><ScrollReveal animation="fade-up" duration={820}><WorkScreen image={`${base}${image}`} alt="" title="" ratio="wide" /></ScrollReveal></article>)}</div></div></div></section>
  <section id="related-works" class="px-5 py-20 lg:px-8 lg:py-28"><div class="mx-auto max-w-6xl"><SectionTitle title="設計の考え方を、制作イメージで。" align="left" /><div class="mt-10 grid gap-7 md:grid-cols-3">{[['ブランドサイト','img-a-02.jpg','/works/brand/'],['採用サイト','img-a-03.jpg','/works/recruitment/'],['キャンペーンLP','img-a-04.jpg','/works/campaign/']].map(([title,image,href]) => <article><WorkScreen image={`${base}${image}`} alt="" title={title} /><TextArrowLink site={site} href={href} label={title} class="mt-4" /></article>)}</div></div></section>
  <ConsultationRows site={site} />
</SiteLayout>
<style>.stage{display:grid;place-items:center;aspect-ratio:1;border-radius:50%;background:var(--color-neutral);color:var(--color-neutral-content);font-weight:700}.stage+*{} nav a{display:block;min-height:44px;padding:.75rem 0;color:inherit}#process article{scroll-margin-top:120px}</style>
