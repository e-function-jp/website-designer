---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import ShirosumiHero from '../../../../../components/sections/ShirosumiHero.astro'; import ImageRevealFrame from '../../../../../components/sections/ImageRevealFrame.astro'; import TreatmentIndexGrid from '../../../../../components/sections/TreatmentIndexGrid.astro'; import CounselingBand from '../../../../../components/sections/CounselingBand.astro'; import Accordion from '../../../../../components/data-display/Accordion.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
const img='/sites/corporate/_shared/20260926-0500/'; const treatments=['皮膚再生プログラム','肌質改善ブースター','微細針再生','レーザー肌再生','注入・再生連携','ピーリングケア','光治療サポート','毛穴・質感ケア','首デコルテ再生','目元の整え','術後フォロー連携','カスタム肌設計','ホルモン調整','点滴療法','栄養・検査設計','ストレスケア','睡眠リズム相談','鉄・ビタミン補充点滴','腸内環境サポート','定期バイタル確認','肌と体調の統合コース','働く女性の定期フォロー','季節の集中整え','再来院メンテナンス'];
---
<SiteLayout site={site} title="施術とコース" description="メディカル美容、予防ウェルネス、目的別コースの位置づけと、皮膚再生から定期フォローまでの施術一覧を掲載しています。" path="/service/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'施術とコース'}]}>
<ShirosumiHero title="施術とコース" lead="メディカル美容、予防ウェルネス、目的別のコース設計。" image={`${img}img-a-07.jpg`} imageAlt="室内で穏やかに過ごす女性" actionLabel="一覧へ" actionHref="#treatments" />
<section class="service-row" id="medical"><div><h2>メディカル美容</h2><p>皮膚の状態を見立て、再生と保湿・質感の手順を組みます。効果の断定より、回復に必要な間隔を先に共有します。</p><ul><li id="skin-regen"><b>皮膚再生プログラム</b> ターンオーバーを支える外用と施術の組み合わせ。</li><li id="skin-booster"><b>肌質改善ブースター</b> 肌の状態に合わせて保湿と質感を整える提案。</li><li id="microneedle"><b>微細針再生</b> 反応と回復の期間を確認しながら進めます。</li><li id="laser"><b>レーザー肌再生</b> 日常予定を考慮して照射間隔を設計。</li><li id="inject"><b>注入・再生連携</b> 必要性を確認し、他の計画と調整します。</li></ul></div><div class="photo"><ImageRevealFrame src={`${img}img-a-05.jpg`} alt="首元の素肌" width={700} height={1000} parallax /></div></section>
<section class="service-row service-row--reverse" id="wellness"><div><h2>予防ウェルネス</h2><p>体調の波が肌に出る前に、検査と補充、生活の余白を整えます。美容施術と矛盾しない範囲で医師が設計します。</p><ul><li id="hormone"><b>ホルモン調整</b> 変化を聞き取り、検査と日程を設計。</li><li id="drip"><b>点滴療法</b> 体調と予定を確認して組み立てます。</li><li id="diagnostics"><b>栄養・検査設計</b> 数字と暮らしの両方を確認。</li><li id="stress"><b>ストレスケア</b> 睡眠と緊張の状態を共有します。</li></ul></div><div class="photo"><ImageRevealFrame src={`${img}img-a-06.jpg`} alt="並木道の女性" width={1400} height={900} parallax /></div></section>
<section class="courses" id="courses"><h2>目的別コース</h2><div><a id="course-integrate" href="/sites/corporate/a-20260926-0500/contact/"><ImageRevealFrame src={`${img}img-a-01.jpg`} alt="頬に触れる女性" width={1600} height={1000} /><span><b>肌と体調の統合コース</b><small>皮膚再生とホルモン・点滴を同一計画に載せる12週の目安。</small></span></a><a id="course-follow" href="/sites/corporate/a-20260926-0500/contact/"><ImageRevealFrame src={`${img}img-a-04.jpg`} alt="クリニックの外観" width={900} height={1200} /><span><b>働く女性の定期フォロー</b><small>再来の間隔とホームケアを固定し、変化を短く記録する。</small></span></a></div><p>コース内容はカウンセリング後に確定。料金表は本サンプルでは未掲載。</p></section>
<TreatmentIndexGrid id="treatments" title="名前から、探す。" items={treatments.map(name=>({name,href:'#medical'}))} />
<section class="faq"><div><h2>気になること</h2><Accordion name="service-faq"><span slot="title">痛みやダウンタイムは？</span>施術により異なります。初回に想定される反応と勤務への影響を説明します。</Accordion><Accordion name="service-faq"><span slot="title">保険は？</span>自由診療が中心です。詳細はカウンセリングで確認します。</Accordion><Accordion name="service-faq"><span slot="title">他院との併用は？</span>内容を共有いただける範囲で調整します。</Accordion><Accordion name="service-faq"><span slot="title">コース途中の変更は？</span>体調に合わせ計画を見直します。</Accordion></div><ScrollReveal animation="fade" duration={300}><aside><p>初回は説明から始めます。</p><a href="/sites/corporate/a-20260926-0500/contact/">カウンセリング予約 ↗</a></aside></ScrollReveal></section><CounselingBand />
</SiteLayout>
<style>section{padding:clamp(80px,10vw,144px) 20px}h2{font-size:clamp(39px,5vw,55px);line-height:1.25;font-weight:500}.service-row,.faq{display:grid;gap:48px;align-items:center;max-width:1120px;margin:auto}.service-row p,.service-row li{line-height:1.9}.service-row ul{padding:0;list-style:none}.service-row li{padding:16px 0;border-top:1px solid #e0d6cc}.photo{height:430px}.courses{background:#f7f0e6}.courses>*,.faq>*{width:min(1120px,100%);margin-left:auto;margin-right:auto}.courses>div{display:grid;gap:24px}.courses a{position:relative;display:block;height:280px;overflow:hidden;color:#fff;text-decoration:none}.courses span{position:absolute;inset:auto 0 0;padding:24px;background:rgb(61 42 34/.68)}.courses b,.courses small{display:block}.courses b{font-family:"Shippori Mincho",serif;font-size:26px;font-weight:500}.courses small{margin-top:8px}.faq{background:#fffefa}.faq aside{padding:32px;border:1px solid #a89078}.faq aside a{color:inherit}@media(min-width:768px){.service-row{grid-template-columns:1fr 400px}.service-row--reverse>div:first-child{order:2}.service-row--reverse .photo{width:320px}.courses>div{grid-template-columns:repeat(2,1fr)}.faq{grid-template-columns:1.5fr .65fr}}</style>
