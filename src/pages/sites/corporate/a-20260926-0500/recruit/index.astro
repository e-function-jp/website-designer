---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import ShirosumiHero from '../../../../../components/sections/ShirosumiHero.astro'; import ImageRevealFrame from '../../../../../components/sections/ImageRevealFrame.astro'; import CounselingBand from '../../../../../components/sections/CounselingBand.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
const img='/sites/corporate/_shared/20260926-0500/';
---
<SiteLayout site={site} title="採用情報" description="白澄メディウェルで医療と接遇のあいだを整える仕事について、職種の接点と大切にしている診療姿勢を紹介します。" path="/recruit/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'採用情報'}]}>
<ShirosumiHero title="採用情報" lead="医療と接遇のあいだで、整える仕事。" image={`${img}img-a-03.jpg`} imageAlt="穏やかに微笑む女性" actionLabel="話を聞く（予約フォーム）" actionHref="/sites/corporate/a-20260926-0500/contact/" />
<section class="roles"><h2>職種の接点</h2><ScrollReveal animation="fade" duration={300} stagger={80}><div><article><h3>臨床・施術補助</h3><p>医師の方針のもと、説明と施術準備、フォロー記録を担う。</p></article><article><h3>受付・コーディネート</h3><p>初回の不安を減らし、コースの間隔を日程に落とす。</p></article></div></ScrollReveal><p class="notice">募集要項・給与・資格要件は本サンプルでは未掲載。関心のある方はフォームより「採用について」を選択してください。</p></section>
<section class="culture"><div><p class="lead">患者と同じく、スタッフにも余白を。</p><h2>説明を急がない。<br />記録を残す。<br />判断を一人に閉じない。</h2></div><div class="culture__photo"><ImageRevealFrame src={`${img}img-a-02.jpg`} alt="横顔の女性" width={900} height={1200} /></div></section>
<section class="apply"><h2>応募の入口</h2><a class="btn btn-primary" href="/sites/corporate/a-20260926-0500/contact/">採用の話を聞く</a><a href="/sites/corporate/a-20260926-0500/company/">会社概要 ↗</a></section><CounselingBand />
</SiteLayout>
<style>section{padding:clamp(80px,10vw,144px) 20px}h2{font-size:clamp(39px,5vw,55px);line-height:1.25;font-weight:500}.roles>*{width:min(1120px,100%);margin-left:auto;margin-right:auto}.roles>div{display:grid;gap:48px}.roles article{border-top:1px solid #e0d6cc;padding-top:20px}.roles h3{font-size:29px;font-weight:500}.roles p{line-height:1.9}.notice{max-width:720px;margin-top:48px!important;font-size:14px}.culture{display:grid;gap:48px;align-items:center;background:#f7f0e6}.lead{font-family:"Shippori Mincho",serif;font-size:27px}.culture__photo{height:380px}.apply{width:min(720px,100%);margin:auto}.apply a{display:block;width:max-content;margin:20px 0;color:inherit;text-underline-offset:6px}.apply .btn{border-radius:999px;color:#fff}@media(min-width:768px){.roles>div{grid-template-columns:repeat(2,1fr)}.culture{grid-template-columns:1fr 320px}.culture__photo{height:420px}}</style>
