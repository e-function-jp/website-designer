---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import ShirosumiHero from '../../../../../components/sections/ShirosumiHero.astro'; import CounselingBand from '../../../../../components/sections/CounselingBand.astro'; import Stat from '../../../../../components/data-display/Stat.astro'; import AnimatedCounter from '../../../../../components/ui/AnimatedCounter.astro'; import CircleTextLink from '../../../../../components/ui/CircleTextLink.astro';
const img='/sites/corporate/_shared/20260926-0500/';
---
<SiteLayout site={site} title="会社概要" description="白澄メディウェル株式会社の商号、設立、所在地、事業内容と、提供データに基づく施術実績を掲載しています。" path="/company/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'会社概要'}]}>
<ShirosumiHero title="会社概要" lead="商号、設立、拠点、実績の要約。" image={`${img}img-a-04.jpg`} imageAlt="都市型クリニックの外観" actionLabel="採用情報" actionHref="/sites/corporate/a-20260926-0500/recruit/" />
<section class="profile"><h2>会社情報</h2><table><tbody><tr><th>商号</th><td>白澄メディウェル株式会社</td></tr><tr><th>よみ</th><td>しろすみめでぃうぇるかぶしきがいしゃ</td></tr><tr><th>設立</th><td>2014年</td></tr><tr><th>従業員数</th><td>48名</td></tr><tr><th>所在地</th><td>東京都港区</td></tr><tr><th>事業内容</th><td>メディカル美容および予防ウェルネスのクリニックサービス（皮膚再生・ホルモン調整・点滴療法、目的別コース、定期フォロー）</td></tr><tr><th>電話・メール</th><td>提供情報に含まれていないため、このサンプルには掲載していません。</td></tr></tbody></table></section>
<section class="figures"><h2>実績</h2><div><Stat title="累計施術"><AnimatedCounter target={126000} suffix="件" duration={600} /></Stat><Stat title="再来院率"><AnimatedCounter target={68} suffix="%" duration={600} /></Stat><Stat title="提携クリニック"><AnimatedCounter target={9} suffix="院" duration={600} /></Stat></div></section>
<section class="related"><h2>関連するページ</h2><p><CircleTextLink site={site} href="/about/" label="クリニックの考え方" /><CircleTextLink site={site} href="/recruit/" label="採用情報" /><CircleTextLink site={site} href="/contact/" label="カウンセリング予約" /></p></section><CounselingBand />
</SiteLayout>
<style>section{padding:clamp(80px,10vw,144px) 20px}h2{font-size:clamp(34px,4vw,50px);font-weight:500}.profile>*{width:min(850px,100%);margin:auto}.profile table{border-collapse:collapse}.profile th,.profile td{padding:18px 12px;border-bottom:1px solid #e0d6cc;text-align:left;vertical-align:top;line-height:1.8}.profile th{width:28%;font-weight:500}.figures{background:#fffefa;text-align:center}.figures>div{display:grid;max-width:960px;margin:auto;border-block:1px solid #e0d6cc}.related{background:#f7f0e6}.related>*{width:min(1120px,100%);margin-left:auto;margin-right:auto}.related p{display:flex;flex-wrap:wrap;gap:24px}@media(min-width:768px){.figures>div{grid-template-columns:repeat(3,1fr)}}</style>
