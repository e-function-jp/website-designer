---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { site } from './_site';
import ShirosumiHero from '../../../../components/sections/ShirosumiHero.astro';
import ImageRevealFrame from '../../../../components/sections/ImageRevealFrame.astro';
import TreatmentIndexGrid from '../../../../components/sections/TreatmentIndexGrid.astro';
import CounselingBand from '../../../../components/sections/CounselingBand.astro';
import ScrollReveal from '../../../../components/ui/ScrollReveal.astro';
import AnimatedCounter from '../../../../components/ui/AnimatedCounter.astro';
import Stat from '../../../../components/data-display/Stat.astro';

const img = '/sites/corporate/_shared/20260926-0500/';
const treatments = ['皮膚再生プログラム','肌質改善ブースター','微細針再生','レーザー肌再生','注入・再生連携','ピーリングケア','光治療サポート','毛穴・質感ケア','首デコルテ再生','目元の整え','術後フォロー連携','カスタム肌設計','ホルモン調整','点滴療法','栄養・検査設計','ストレスケア','睡眠リズム相談','鉄・ビタミン補充点滴','腸内環境サポート','定期バイタル確認'];
---
<SiteLayout site={site} title="医学と余白で、肌を整える" description="白澄メディウェルは、皮膚再生・ホルモン調整・点滴療法を目的別コースと定期フォローでつなぐ港区のメディカル美容クリニックです。" path="/" isHome>
  <ShirosumiHero home title="医学と余白で、肌を整える。" lead="皮膚再生・ホルモン調整・点滴療法を、目的別のコースと定期フォローでつなぐ。" image={`${img}img-a-01.jpg`} imageAlt="頬に手を添える女性" actionLabel="施術を見る" actionHref="/sites/corporate/a-20260926-0500/service/" note="写真はイメージです。" />
  <section class="brand"><div class="brand__photo"><ImageRevealFrame src={`${img}img-a-02.jpg`} alt="横顔の女性" width={900} height={1200} parallax /></div><ScrollReveal animation="fade" duration={300}><div class="brand__copy"><h2>白澄という整え方。</h2><p>表面の変化だけを急がせない。検査と医師の見立て、日々の余白を同じ設計に載せる。働く女性のペースに合わせ、肌と体調を一緒に整えます。</p><a href="/sites/corporate/a-20260926-0500/service/">施術とコースを見る ↗</a></div></ScrollReveal><div class="brand__photo brand__photo--second"><ImageRevealFrame src={`${img}img-a-03.jpg`} alt="穏やかに微笑む女性" width={900} height={1200} /></div></section>
  <section class="quote"><ScrollReveal animation="fade" duration={300}><p>Care with evidence,<br />room to recover,<br />skin that feels like yours.</p><strong>根拠のあるケアと、戻るための余白を。</strong></ScrollReveal></section>
  <section class="clinic"><div class="clinic__photo"><ImageRevealFrame src={`${img}img-a-04.jpg`} alt="都市型クリニックの外観" width={900} height={1200} parallax /></div><div><h2>港区のクリニックで、<br />整える。</h2><p>カウンセリングから施術、フォローまで、同じチームが担当します。急かさない説明と、回復のための間隔設計を大切にしています。</p><a href="/sites/corporate/a-20260926-0500/about/">考え方を読む ↗</a></div><p class="clinic__slogan">CRAFTED FOR<br />CALM RECOVERY.</p></section>
  <section class="gates"><h2>受けられるケア</h2><div class="gates__grid"><a href="/sites/corporate/a-20260926-0500/service/#medical"><ImageRevealFrame src={`${img}img-a-05.jpg`} alt="首元の素肌" width={700} height={1000} /><span><b>メディカル美容</b><small>皮膚再生を軸にした医療美容</small></span></a><a href="/sites/corporate/a-20260926-0500/service/#wellness"><ImageRevealFrame src={`${img}img-a-06.jpg`} alt="並木道に立つ女性" width={1400} height={900} /><span><b>予防ウェルネス</b><small>ホルモン・点滴・検査</small></span></a><a href="/sites/corporate/a-20260926-0500/service/#courses"><ImageRevealFrame src={`${img}img-a-07.jpg`} alt="穏やかな表情の女性" width={1400} height={900} /><span><b>目的別コース</b><small>単発で終わらせない設計</small></span></a></div><a class="text-link" href="/sites/corporate/a-20260926-0500/service/#treatments">すべての施術を見る ↗</a></section>
  <TreatmentIndexGrid title="施術とコースを、一覧で。" items={treatments.map((name) => ({ name, href: '/sites/corporate/a-20260926-0500/service/#treatments' }))} />
  <section class="stats"><h2>数字で見る白澄</h2><div><Stat title="累計施術"><AnimatedCounter target={126000} suffix="件" duration={600} /></Stat><Stat title="再来院率"><AnimatedCounter target={68} suffix="%" duration={600} /></Stat><Stat title="提携クリニック"><AnimatedCounter target={9} suffix="院" duration={600} /></div><p>数値は提供データに基づく（集計期間の詳細は未掲載）。</p></section>
  <section class="news"><h2>お知らせ</h2><a href="/sites/corporate/a-20260926-0500/news/first-visit/">はじめてのカウンセリングの前に ↗</a><p><a href="/sites/corporate/a-20260926-0500/service/#course-follow">定期フォローの考え方 ↗</a><a href="/sites/corporate/a-20260926-0500/company/">会社概要 ↗</a></p><a href="/sites/corporate/a-20260926-0500/news/">お知らせ一覧 ↗</a></section>
  <CounselingBand />
</SiteLayout>
<style>
  section { padding:clamp(80px,10vw,144px) 20px; } h2 { margin:0 0 30px; font-size:clamp(39px,5vw,55px); line-height:1.25; } p { line-height:1.9; } a { color:inherit; text-underline-offset:6px; } .brand { display:grid; align-items:start; gap:48px; max-width:1120px; margin:auto; background:#f7f0e6; } .brand__photo { height:390px; max-width:320px; } .brand__photo--second { width:78%; max-width:280px; justify-self:end; } .brand__copy { max-width:360px; } .quote { text-align:center; background:#f7f0e6; } .quote p { margin:0 0 24px; font-family:"Shippori Mincho",serif; font-size:clamp(30px,4vw,48px); line-height:1.35; } .clinic { display:grid; align-items:center; gap:40px; max-width:1120px; margin:auto; } .clinic__photo { height:380px; } .clinic__slogan { border-left:1px solid #a89078; padding:40px 0 40px 24px; letter-spacing:.08em; } .gates { max-width:1120px; margin:auto; } .gates__grid { display:grid; gap:20px; } .gates__grid a { position:relative; min-height:340px; overflow:hidden; color:#fff; text-decoration:none; } .gates__grid span { position:absolute; right:0; bottom:0; left:0; padding:24px; background:rgb(61 42 34 / .66); } .gates__grid b,.gates__grid small { display:block; } .gates__grid b { font-family:"Shippori Mincho",serif; font-size:25px; font-weight:500; } .gates__grid small { margin-top:8px; font-size:14px; } .text-link { display:inline-block; margin-top:24px; } .stats { background:#fffefa; text-align:center; } .stats > div { display:grid; max-width:960px; margin:auto; border-block:1px solid #e0d6cc; } .stats p { font-size:14px; } .news { max-width:1120px; margin:auto; border-top:1px solid #e0d6cc; } .news > a { display:block; padding:24px 0; border-bottom:1px solid #e0d6cc; font-family:"Shippori Mincho",serif; font-size:clamp(25px,3vw,36px); } .news p { display:flex; gap:24px; flex-wrap:wrap; }
  @media(min-width:768px) { .brand { grid-template-columns:320px 1fr 280px; min-height:620px; } .brand__copy { align-self:center; justify-self:center; } .brand__photo--second { margin-top:120px; } .clinic { grid-template-columns:360px minmax(0,1fr) 200px; } .gates__grid { grid-template-columns:1fr 3fr 3fr; } .gates__grid a:first-child { min-height:460px; } .stats > div { grid-template-columns:repeat(3,1fr); } }
</style>
