---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import ShirosumiHero from '../../../../../../components/sections/ShirosumiHero.astro'; import ImageRevealFrame from '../../../../../../components/sections/ImageRevealFrame.astro'; import CounselingBand from '../../../../../../components/sections/CounselingBand.astro'; import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro';
const img='/sites/corporate/_shared/20260926-0500/';
---
<SiteLayout site={site} title="はじめてのカウンセリングの前に" description="初回カウンセリングで気になる変化や予定を無理なく共有できるよう、持参事項と当日の流れをまとめました。" path="/news/first-visit/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'お知らせ',href:'/news/'},{label:'はじめての方へ'}]}>
<ShirosumiHero title="はじめてのカウンセリングの前に" lead="初回を、決めすぎないための準備。" image={`${img}img-a-08.jpg`} imageAlt="落ち着いた表情の女性" />
<section class="prepare"><h2>準備すること</h2><ScrollReveal animation="fade" duration={300} stagger={80}><ol><li><b>1. 気になる変化</b><p>いつから、どの部位か、季節や睡眠との関係。</p></li><li><b>2. これまでのケア</b><p>市販・他院・内服の有無をメモ。</p></li><li><b>3. 今後の予定</b><p>大事な予定の前後2週間を共有できると間隔を組みやすい。</p></li></ol></ScrollReveal></section>
<section class="flow"><div class="flow__photo"><ImageRevealFrame src={`${img}img-a-04.jpg`} alt="クリニックの外観" width={900} height={1200} /></div><div><h2>当日の流れ</h2><p>受付 → 問診 → 説明 → 方針の合意。施術は必須ではありません。コースが合う場合のみ、次回以降の間隔を仮置きします。</p></div></section>
<section class="next"><h2>次にすること</h2><a class="btn btn-primary" href="/sites/corporate/a-20260926-0500/contact/">カウンセリング予約</a><a href="/sites/corporate/a-20260926-0500/service/">施術とコース ↗</a><a href="/sites/corporate/a-20260926-0500/news/">お知らせ一覧 ↗</a></section><CounselingBand />
</SiteLayout>
<style>section{padding:clamp(80px,10vw,144px) 20px}h2{font-size:clamp(34px,4vw,50px);font-weight:500}.prepare>*{width:min(720px,100%);margin:auto}.prepare ol{padding:0;list-style:none}.prepare li{padding:28px 0;border-top:1px solid #e0d6cc}.prepare b{font-family:"Shippori Mincho",serif;font-size:28px;font-weight:500}.prepare p,.flow p{line-height:1.9}.flow{display:grid;gap:48px;align-items:center;background:#f7f0e6}.flow__photo{height:360px}.next{width:min(720px,100%);margin:auto}.next a{display:block;width:max-content;margin:20px 0;color:inherit;text-underline-offset:6px}.next .btn{color:#fff;border-radius:999px}@media(min-width:768px){.flow{grid-template-columns:380px 1fr}.flow__photo{height:380px}}</style>
