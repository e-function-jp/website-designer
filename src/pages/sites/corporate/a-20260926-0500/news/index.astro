---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import ShirosumiHero from '../../../../../components/sections/ShirosumiHero.astro'; import ImageRevealFrame from '../../../../../components/sections/ImageRevealFrame.astro'; import CounselingBand from '../../../../../components/sections/CounselingBand.astro'; import CircleTextLink from '../../../../../components/ui/CircleTextLink.astro';
const img='/sites/corporate/_shared/20260926-0500/';
---
<SiteLayout site={site} title="お知らせ" description="初回カウンセリングの準備、定期フォロー、季節ごとの整え方など、受診前に知っておきたい白澄からの案内を掲載します。" path="/news/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'お知らせ'}]}>
<ShirosumiHero title="お知らせ" lead="受診の前に知っておきたいことと、クリニックからの案内。" image={`${img}img-a-03.jpg`} imageAlt="穏やかに微笑む女性" actionLabel="はじめての方へ" actionHref="/sites/corporate/a-20260926-0500/news/first-visit/" />
<section class="featured"><div class="featured__image"><ImageRevealFrame src={`${img}img-a-02.jpg`} alt="横顔の女性" width={900} height={1200} /></div><div><time datetime="2026-09-01">2026.09.01</time><h2>はじめてのカウンセリングの前に</h2><p>持参すると話が早いもの、聞きたいことの整理、当日の流れ。</p><a href="/sites/corporate/a-20260926-0500/news/first-visit/">記事を読む ↗</a></div></section>
<section class="list"><h2>一覧</h2><a href="/sites/corporate/a-20260926-0500/service/#course-follow"><time>2026.08.20</time>定期フォローのご案内 <b>↗</b></a><a href="/sites/corporate/a-20260926-0500/service/#medical"><time>2026.07.12</time>夏の肌と体調の整え方 <b>↗</b></a><a href="/sites/corporate/a-20260926-0500/company/"><time>2026.06.01</time>会社概要ページを公開 <b>↗</b></a><p>一覧のすべてをこのページに掲載しています。</p></section>
<section class="related"><h2>関連するご案内</h2><p><CircleTextLink site={site} href="/service/" label="施術とコースを見る" /><CircleTextLink site={site} href="/contact/" label="カウンセリング予約" /></p></section><CounselingBand />
</SiteLayout>
<style>section{padding:clamp(80px,10vw,144px) 20px}h2{font-size:clamp(34px,4vw,50px);font-weight:500;line-height:1.3}.featured{display:grid;align-items:center;gap:48px;width:min(1120px,100%);margin:auto;border-bottom:1px solid #e0d6cc}.featured__image{height:340px}.featured time,.list time{font-size:14px;color:#6a5548}.featured a,.list a{color:inherit;text-underline-offset:6px}.list{width:min(1120px,100%);margin:auto}.list a{display:grid;grid-template-columns:110px 1fr auto;gap:16px;padding:24px 0;border-top:1px solid #e0d6cc;text-decoration:none}.list a:last-of-type{border-bottom:1px solid #e0d6cc}.list b{font-weight:400}.related{background:#f7f0e6}.related>*{width:min(1120px,100%);margin-left:auto;margin-right:auto}.related p{display:flex;flex-wrap:wrap;gap:24px}@media(min-width:768px){.featured{grid-template-columns:420px 1fr}.featured__image{height:280px}}</style>
