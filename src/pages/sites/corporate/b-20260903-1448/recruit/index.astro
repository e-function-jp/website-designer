---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import PageHeaderHero from '../../../../../components/sections/PageHeaderHero.astro';
import Steps from '../../../../../components/navigation/Steps.astro';
import ContactCtaBand from '../../../../../components/site/ContactCtaBand.astro';
import PageTopButton from '../../../../../components/ui/PageTopButton.astro';

const positions = [
  { number: '01', title: '配合設計スタッフ', location: '旭川本社', salary: '年収 380〜560 万円' },
  { number: '02', title: '工場ラインスタッフ', location: '旭川本社', salary: '年収 320〜440 万円' },
  { number: '03', title: '直営店舗スタッフ', location: '旭川・札幌・原宿のいずれか', salary: '年収 300〜420 万円' },
];

const contactHref = url(site, '/contact/');

const flow = [
  { label: 'エントリー', body: `お問い合わせフォーム（${contactHref}） または recruit@example.com へ履歴書・職務経歴書をご送付ください。` },
  { label: '一次面接', body: 'オンラインまたは旭川本社で実施します。' },
  { label: '二次面接・現場体験', body: '旭川本社または直営店舗で、現場の雰囲気を体感いただきます。' },
  { label: '内定', body: '応募から内定まで 3〜4 週間を予定しています。' },
];

const benefits = [
  { title: '社会保険完備', body: '健康保険・厚生年金・雇用保険・労災保険を完備しています。' },
  { title: '退職金制度あり', body: '勤続 3 年以上を対象とする退職金制度を運用しています。' },
  { title: '年間休日 120 日', body: '完全週休二日制、祝日、夏季・年末年始休暇を含みます。' },
  { title: '産前産後・育児休暇制度', body: '法定どおり。取得実績もあり、復帰後の時短勤務も相談可能です。' },
  { title: '社員割引', body: '直営店舗の製品を 30% 引でお求めいただけます。' },
  { title: '研修制度', body: '配合研修・店舗研修・外部セミナーへの参加費用を補助します。' },
];
---

<SiteLayout
  site={site}
  title="採用情報"
  description="北嶺ニュートリションの採用情報。旭川の工場と直営 3 拠点（旭川・札幌・原宿）で仲間を募集しています。"
  path="/recruit/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '採用情報' }]}
>
  <!-- ページヘッダ -->
  <PageHeaderHero
    title="採用情報"
    englishTitle="Recruit"
    lead="北嶺ニュートリションは、旭川の工場と直営 3 拠点で仲間を募集しています。動く体に向き合う栄養を、現場で作って届けたい方を募集します。"
  />

  <!-- 採用メッセージ -->
  <section class="bg-base-100">
    <div class="max-w-7xl mx-auto px-4 py-20 lg:py-32 grid gap-12 lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] items-start">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <h2
          class="text-3xl lg:text-[3rem] font-medium leading-tight"
          style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
        >
          採用メッセージ。
        </h2>
      </ScrollReveal>
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={100}>
        <div class="space-y-6 text-base lg:text-lg leading-[1.95] text-base-content/85">
          <p>
            私たちは「配合検証 480 処方、現場の声で処方を組み替える」を 11 年続けてきました。これからも、現場で作って、現場で届けることを止めません。
          </p>
          <p>
            募集するのは、原料の選定から配合、工場ライン、直営店舗、専門店の販売までを一貫して担える人材です。旭川の工場と直営 3 拠点で、動く体に向き合う栄養を一緒に作っていただける方を募集します。
          </p>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- 募集職種（3 職種） -->
  <section id="recruit-positions" class="bg-base-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 py-20 lg:py-32">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <p class="text-xs tracking-[0.18em] uppercase text-secondary font-bold mb-3">Positions</p>
        <h2
          class="text-2xl lg:text-[2rem] leading-snug mb-10"
          style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
        >
          募集職種（3 職種）
        </h2>
      </ScrollReveal>
      <ul class="grid gap-6 md:grid-cols-3">
        {positions.map((p) => (
          <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} stagger={site.motion!.staggerMs}>
            <li class="bg-base-100 border border-base-300 p-6 lg:p-8 h-full flex flex-col">
              <span
                class="inline-flex w-fit items-center justify-center px-3 py-1 mb-4 rounded-full bg-secondary text-primary-content text-sm font-bold tabular-nums"
                aria-hidden="true"
              >
                {p.number}
              </span>
              <h3
                class="text-xl lg:text-[1.5rem] leading-snug mb-3"
                style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
              >
                {p.title}
              </h3>
              <dl class="mt-auto space-y-2 text-sm">
                <div class="flex gap-2">
                  <dt class="text-secondary tracking-[0.16em] uppercase text-xs font-bold shrink-0">勤務地</dt>
                  <dd>{p.location}</dd>
                </div>
                <div class="flex gap-2">
                  <dt class="text-secondary tracking-[0.16em] uppercase text-xs font-bold shrink-0">給与</dt>
                  <dd>{p.salary}</dd>
                </div>
              </dl>
            </li>
          </ScrollReveal>
        ))}
      </ul>
    </div>
  </section>

  <!-- 選考フロー -->
  <section id="recruit-flow" class="bg-base-100 scroll-mt-20">
    <div class="max-w-3xl mx-auto px-4 py-20 lg:py-32">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <p class="text-xs tracking-[0.18em] uppercase text-secondary font-bold mb-3">Flow</p>
        <h2
          class="text-2xl lg:text-[2rem] leading-snug mb-10"
          style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
        >
          選考フロー
        </h2>
      </ScrollReveal>
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} stagger={site.motion!.staggerMs}>
        <Steps class="w-full">
          {flow.map((s, i) => (
            <li class="step step-secondary">
              <span class="block font-bold text-sm">0{i + 1} {s.label}</span>
              <span class="block text-xs text-base-content/70 mt-1">{s.body}</span>
            </li>
          ))}
        </Steps>
      </ScrollReveal>
    </div>
  </section>

  <!-- 福利厚生（3 列 × 2 行） -->
  <section id="recruit-benefits" class="bg-base-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 py-20 lg:py-32">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <p class="text-xs tracking-[0.18em] uppercase text-secondary font-bold mb-3">Benefits</p>
        <h2
          class="text-2xl lg:text-[2rem] leading-snug mb-10"
          style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
        >
          福利厚生
        </h2>
      </ScrollReveal>
      <ul class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
        {benefits.map((b) => (
          <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} stagger={site.motion!.staggerMs}>
            <li class="bg-base-100 border border-base-300 p-6 h-full">
              <h3
                class="text-base lg:text-[1.125rem] leading-snug mb-3"
                style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
              >
                {b.title}
              </h3>
              <p class="text-sm leading-[1.85] text-base-content/80">{b.body}</p>
            </li>
          </ScrollReveal>
        ))}
      </ul>
    </div>
  </section>

  <!-- エントリーボタン（採用応募口、凍土背景・藍ボタン） -->
  <ContactCtaBand
    site={site}
    heading="ご応募はこちらから。"
    ctaLabel="エントリーフォーム"
    ctaHref="/contact/"
  />

  <PageTopButton />
</SiteLayout>
