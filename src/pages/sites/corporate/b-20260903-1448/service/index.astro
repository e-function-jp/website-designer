---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import PageHeaderHero from '../../../../../components/sections/PageHeaderHero.astro';
import Steps from '../../../../../components/navigation/Steps.astro';
import Tab from '../../../../../components/navigation/Tab.astro';
import RelatedContent from '../../../../../components/sections/RelatedContent.astro';
import ContactCtaBand from '../../../../../components/site/ContactCtaBand.astro';
import PageTopButton from '../../../../../components/ui/PageTopButton.astro';

const proteinSteps = [
  { label: '原料選定', body: '北海道産ホエイと国内外の認証原料' },
  { label: '配合設計', body: '12 処方を 0.1g 単位で設計' },
  { label: '試作検証', body: '溶け・味・粒度を 80 メッシュで検証' },
  { label: '工場生産', body: '旭川本社工場で全数検査' },
];

const recoverySteps = [
  { label: '食材選定', body: '北海道産食材と認証原料を選定' },
  { label: '配合設計', body: '6 処方を 0.1g 単位で設計' },
  { label: '試作検証', body: '電解質バランスと吸収速度を検証' },
  { label: '工場生産', body: '旭川本社工場で全数検査' },
];

const snackSteps = [
  { label: '食材選定', body: '北海道産食材を 8 処方に搭配' },
  { label: '配合設計', body: 'たんぱく質を 10〜20g 含めて設計' },
  { label: '試作検証', body: '焙煎温度を 1℃ 単位で管理' },
  { label: '工場生産', body: '旭川本社工場で全数検査' },
];

const stores = [
  {
    name: '旭川本店',
    address: '〒070-0030 北海道旭川市宮下通 9-2-14',
    image: '/sites/corporate/_shared/20260903-1448/img-b-07.jpg',
    alt: '北嶺ニュートリション旭川本店の直営店舗外観（朝の光）',
    hours: '営業時間：平日 9:00〜17:30',
  },
  {
    name: '札幌店',
    address: '北海道札幌市中央区南 1 条',
    image: null,
    alt: '',
    hours: '営業時間：平日 10:00〜19:00',
  },
  {
    name: '原宿店',
    address: '東京都渋谷区神宮前',
    image: null,
    alt: '',
    hours: '営業時間：平日 11:00〜18:00',
  },
];

const relatedCards = [
  { label: '会社について', lead: '動く体に、確かな補給を。', href: '/about/', chapter: '01' },
  { label: '採用情報', lead: '旭川の工場と直営店舗で仲間を募集中。', href: '/recruit/', chapter: '04' },
  { label: 'お問い合わせ', lead: '製品ラインについて、もっと詳しく。', href: '/contact/', chapter: '05' },
];
---

<SiteLayout
  site={site}
  title="製品ライン"
  description="北嶺ニュートリションの製品ライン：トレーニング向けプロテイン、リカバリー食品、機能性スナックを旭川の自社工場で配合し、配合検証 480 処方を現場で積み直しています。"
  path="/service/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '製品ライン' }]}
>
  <!-- ページヘッダ -->
  <PageHeaderHero
    title="製品ライン"
    englishTitle="Product Lines"
    lead="北嶺ニュートリションは、トレーニング向けプロテインとリカバリー食品、機能性スナックを、自社工場で配合しています。配合検証 480 処方を現場の声で積み直し、ジムと直営店舗、専門店・EC を通じて、動く体に必要な補給を、手元に届く形に整えました。"
  />

  <!-- トレーニング向けプロテイン（章番号 01、写真左） -->
  <section id="protein" class="bg-base-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 py-20 lg:py-32 grid gap-12 lg:grid-cols-2 items-start">
      <ScrollReveal animation="clip-up" duration={site.motion!.durationMs}>
        <figure class="relative overflow-hidden bg-base-300 aspect-[4/3]">
          <img
            src="/sites/corporate/_shared/20260903-1448/img-b-06.jpg"
            alt="粉末のプロテインがスプーンですくわれ容器の縁からこぼれ落ちる接写"
            loading="lazy"
            width="1600"
            height="1200"
            class="w-full h-full object-cover"
          />
          <span
            class="absolute top-4 left-4 inline-flex items-center justify-center w-12 h-12 rounded-full bg-secondary text-primary-content text-lg font-bold tabular-nums"
            style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
            aria-hidden="true"
          >
            01
          </span>
        </figure>
      </ScrollReveal>
      <div class="space-y-6 border-l-0 lg:border-l border-secondary lg:pl-8">
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={100}>
          <p class="text-xs tracking-[0.18em] uppercase text-secondary font-bold">Training Protein</p>
          <h2
            class="text-2xl lg:text-[2.25rem] leading-snug mt-2"
            style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
          >
            トレーニング向けプロテイン。
          </h2>
        </ScrollReveal>
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={200}>
          <p class="text-base lg:text-lg leading-[1.95] text-base-content/85">
            旭川の工場で配合する 12 処方は、トレーニング前後の補給を 30 秒で溶ける形に整えました。北海道産ホエイと国内外の認証原料を採用し、配合検証は 480 処方を突破。味のばらつきを抑えるため、粉末の粒度を 80 メッシュに統一しています。
          </p>
        </ScrollReveal>
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={300}>
          <Steps class="w-full">
            {proteinSteps.map((s, i) => (
              <li class="step step-secondary">
                <span class="block font-bold text-sm">0{i + 1} {s.label}</span>
                <span class="block text-xs text-base-content/70 mt-1">{s.body}</span>
              </li>
            ))}
          </Steps>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- リカバリー食品（章番号 02、写真右、左右反転） -->
  <section id="recovery" class="bg-base-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 py-20 lg:py-32 grid gap-12 lg:grid-cols-2 items-start">
      <div class="space-y-6 order-2 lg:order-1 lg:border-l border-secondary lg:pl-8">
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={100}>
          <p class="text-xs tracking-[0.18em] uppercase text-secondary font-bold">Recovery Food</p>
          <h2
            class="text-2xl lg:text-[2.25rem] leading-snug mt-2"
            style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
          >
            リカバリー食品。
          </h2>
        </ScrollReveal>
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={200}>
          <p class="text-base lg:text-lg leading-[1.95] text-base-content/85">
            トレーニング後の 30 分に、たんぱく質と電解質を同時に摂れる 6 処方を用意しました。北海道産食材と国内外の認証原料を組み合わせ、味のばらつきを抑えるため、1 食あたりの配合を 0.1g 単位で管理しています。
          </p>
        </ScrollReveal>
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={300}>
          <Steps class="w-full">
            {recoverySteps.map((s, i) => (
              <li class="step step-secondary">
                <span class="block font-bold text-sm">0{i + 1} {s.label}</span>
                <span class="block text-xs text-base-content/70 mt-1">{s.body}</span>
              </li>
            ))}
          </Steps>
        </ScrollReveal>
      </div>
      <ScrollReveal animation="clip-up" duration={site.motion!.durationMs} class="order-1 lg:order-2">
        <figure class="relative overflow-hidden bg-base-300 aspect-[4/3]">
          <div class="w-full h-full flex items-center justify-center bg-base-300 text-base-content/50 text-sm">
            <span>リカバリー食品 写真準備中</span>
          </div>
          <span
            class="absolute top-4 right-4 inline-flex items-center justify-center w-12 h-12 rounded-full bg-secondary text-primary-content text-lg font-bold tabular-nums"
            style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
            aria-hidden="true"
          >
            02
          </span>
        </figure>
      </ScrollReveal>
    </div>
  </section>

  <!-- 機能性スナック（章番号 03、写真左） -->
  <section id="snack" class="bg-base-100 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 py-20 lg:py-32 grid gap-12 lg:grid-cols-2 items-start">
      <ScrollReveal animation="clip-up" duration={site.motion!.durationMs}>
        <figure class="relative overflow-hidden bg-base-300 aspect-[4/3]">
          <div class="w-full h-full flex items-center justify-center bg-base-300 text-base-content/50 text-sm">
            <span>機能性スナック 写真準備中</span>
          </div>
          <span
            class="absolute top-4 left-4 inline-flex items-center justify-center w-12 h-12 rounded-full bg-secondary text-primary-content text-lg font-bold tabular-nums"
            style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
            aria-hidden="true"
          >
            03
          </span>
        </figure>
      </ScrollReveal>
      <div class="space-y-6 border-l-0 lg:border-l border-secondary lg:pl-8">
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={100}>
          <p class="text-xs tracking-[0.18em] uppercase text-secondary font-bold">Functional Snack</p>
          <h2
            class="text-2xl lg:text-[2.25rem] leading-snug mt-2"
            style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
          >
            機能性スナック。
          </h2>
        </ScrollReveal>
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={200}>
          <p class="text-base lg:text-lg leading-[1.95] text-base-content/85">
            日常使いのための 8 処方は、たんぱく質を 10〜20g 含み、手軽に持ち運べる形に整えました。北海道産食材の配合比率を引き上げ、味のばらつきを抑えるため、焙煎温度を 1℃ 単位で管理しています。
          </p>
        </ScrollReveal>
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={300}>
          <Steps class="w-full">
            {snackSteps.map((s, i) => (
              <li class="step step-secondary">
                <span class="block font-bold text-sm">0{i + 1} {s.label}</span>
                <span class="block text-xs text-base-content/70 mt-1">{s.body}</span>
              </li>
            ))}
          </Steps>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- 直営店舗と EC（Tab + 3 拠点カード） -->
  <section id="store" class="bg-base-200 scroll-mt-20">
    <div class="max-w-7xl mx-auto px-4 py-20 lg:py-32">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <p class="text-xs tracking-[0.18em] uppercase text-secondary font-bold">Stores &amp; Online</p>
        <h2
          class="text-2xl lg:text-[2.25rem] leading-snug mt-2 mb-3"
          style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
        >
          直営店舗と EC
        </h2>
        <p class="text-base lg:text-lg leading-[1.85] text-base-content/85 max-w-3xl mb-10">
          全国 3 拠点の直営店舗と、公式オンラインストアでお買い求めいただけます。
        </p>
      </ScrollReveal>

      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} stagger={site.motion!.staggerMs}>
        <Tab variant="lifted" class="mb-8">
          <button type="button" role="tab" class="tab tab-active" aria-selected="true">旭川本店</button>
          <button type="button" role="tab" class="tab" aria-selected="false">札幌店</button>
          <button type="button" role="tab" class="tab" aria-selected="false">原宿店</button>
          <button type="button" role="tab" class="tab" aria-selected="false">EC</button>
        </Tab>
      </ScrollReveal>

      <div class="grid gap-6 md:grid-cols-3">
        {stores.map((s) => (
          <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} stagger={site.motion!.staggerMs}>
            <article class="bg-base-100 border border-base-300 overflow-hidden h-full">
              {s.image ? (
                <figure class="aspect-[4/3] overflow-hidden bg-base-300">
                  <img
                    src={s.image}
                    alt={s.alt}
                    loading="lazy"
                    width="1600"
                    height="1200"
                    class="w-full h-full object-cover"
                  />
                </figure>
              ) : (
                <div class="aspect-[4/3] bg-base-300 flex items-center justify-center text-base-content/50 text-sm">
                  <span>{s.name} 写真準備中</span>
                </div>
              )}
              <div class="p-5 space-y-2">
                <h3
                  class="text-lg lg:text-[1.5rem] leading-snug"
                  style="font-family: 'Shippori Mincho', 'Hiragino Mincho ProN', 'YuMincho', 'Noto Serif JP', serif;"
                >
                  {s.name}
                </h3>
                <p class="text-sm text-base-content/75">{s.address}</p>
                <p class="text-xs text-base-content/60">{s.hours}</p>
              </div>
            </article>
          </ScrollReveal>
        ))}
      </div>

      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} delay={200}>
        <p class="mt-8 text-sm text-base-content/75">
          EC：<a href="https://example.com/" class="link link-secondary" rel="nofollow external">公式オンラインストア</a>（外部リンク）
        </p>
      </ScrollReveal>
    </div>
  </section>

  <!-- 関連ページへの導線（凍土背景） -->
  <RelatedContent
    site={site}
    cards={relatedCards}
    duration={site.motion!.durationMs}
    stagger={site.motion!.staggerMs}
  />

  <!-- お問い合わせ CTA 帯（凍土背景・藍ボタン） -->
  <ContactCtaBand
    site={site}
    heading="製品ラインについて、もっと詳しく。"
    ctaLabel="お問い合わせ"
    ctaHref="/contact/"
  />

  <PageTopButton />
</SiteLayout>
