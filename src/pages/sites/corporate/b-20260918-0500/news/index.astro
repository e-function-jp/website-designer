---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import EditorialLead from '../../../../../components/sections/EditorialLead.astro'; import LabeledSection from '../../../../../components/sections/LabeledSection.astro'; import NewsRows from '../../../../../components/sections/NewsRows.astro'; import RelatedPagePair from '../../../../../components/sections/RelatedPagePair.astro';
const items=[{date:'2026.09.18',title:'目的から探す、サイトのご案内',text:'会社のこと、依頼できること、制作物のこと。知りたい内容に合わせたページの選び方を紹介します。',href:'/news/site-guide/'},{date:'2026.09.18',title:'制作例の見方について',text:'制作例と実績数値の違い、図版の分類、詳細ページで確かめられる内容を説明します。',href:'/news/work-guide/'},{date:'2026.09.18',title:'制作相談の前に整理しておきたいこと',text:'伝えたい相手、変えたいこと、必要な制作物、希望時期を整理するための読み物です。',href:'/news/consultation-guide/'}];
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="お知らせ" description="蒼紙舎の仕事や、このサイトの見方をご案内します。日付と見出しから知りたい情報を確認できます。" path="/news/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'お知らせ'}]}><ScrollReveal animation="fade-up" duration={1000}><EditorialLead title="お知らせ" /><LabeledSection label="サイトのご案内"><p>蒼紙舎の仕事や、このサイトの見方をご案内します。制作を検討している方は、事業の範囲や制作例の読み方からご覧ください。会社について確かめたい方には、理念や制作体制をまとめたページをご用意しています。</p></LabeledSection><LabeledSection wide label="更新一覧"><NewsRows site={site} items={items} /></LabeledSection><RelatedPagePair site={site} items={[{title:'蒼紙舎について',text:'理念と制作体制をご紹介します。',href:'/about/'},{title:'視覚設計の仕事',text:'依頼できる領域を確認する。',href:'/service/'}]} /></ScrollReveal></SiteLayout>
