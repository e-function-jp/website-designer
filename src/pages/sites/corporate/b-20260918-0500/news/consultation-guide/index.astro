---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import AogamiEditorialPage from '../../../../../../components/sections/AogamiEditorialPage.astro';
import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="制作相談の前に整理しておきたいこと" description="伝えたい相手、変えたいこと、必要な制作物、希望時期を整理するための蒼紙舎の相談準備ガイドです。" path="/news/consultation-guide/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'お知らせ',href:'/news/'},{label:'制作相談の前に整理しておきたいこと'}]}><ScrollReveal animation="fade" duration={1000}><AogamiEditorialPage site={site} title="制作相談の前に整理しておきたいこと" intro="制作物の形が決まる前にも、整理できることがあります。まずは、伝えたい相手と、今感じている課題を言葉にしてみてください。完成した依頼書を用意する必要はありません。" sections={[{label:'相談の出発点',heading:'四つの視点を分ける',text:'誰に伝えたいか、何を変えたいか、何が必要か、いつ使いたいかを整理します。見る人と出会う場面、検討する媒体、公開予定の時期があれば共有してください。未定の項目は、そのまま未定としてお伝えください。'}]} related={[{title:'ご相談の前に',text:'よくある疑問を確認する。',href:'/faq/'},{title:'制作のご相談',text:'検討内容を入力する。',href:'/contact/'}]} /></ScrollReveal></SiteLayout>
