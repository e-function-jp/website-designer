---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import { url } from '../../../../../lib/site';
import EditorialLead from '../../../../../components/sections/EditorialLead.astro'; import LabeledSection from '../../../../../components/sections/LabeledSection.astro'; import WorkStudyPlate from '../../../../../components/sections/WorkStudyPlate.astro'; import NumberedPrinciples from '../../../../../components/sections/NumberedPrinciples.astro'; import RelatedPagePair from '../../../../../components/sections/RelatedPagePair.astro'; import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
const fields=[['ブランドとロゴ','企業や施設が大切にする意図を、視覚表現の軸へ整理します。ロゴの形だけでなく、印刷物や空間へ展開するときの関係まで考えます。','A','企業の視覚統一','/projects/identity/'],['印刷物','読む順序と情報のまとまりを整理し、紙面に落とし込みます。文字の大きさ、余白、写真や図版の位置を、伝える内容に合わせて設計します。','C','冊子の情報設計','/projects/editorial/'],['空間グラフィック','入口、分岐、目的地で必要な情報を整理し、空間の中で読める形へ整えます。設置場所や視線の高さも、グラフィックの条件として扱います。','D','空間の案内計画','/projects/sign/'],['展示演出','展示の意図を、導入、解説、案内へつなぎます。見る人が内容に出会い、理解を深める流れを、視覚表現と空間の関係から考えます。','E','展示の体験設計','/projects/exhibition/']];
const process=[['整理する','背景、伝える相手、必要な媒体を確かめ、制作の目的を揃えます。現時点で決まっていることと、検討が必要なことを分けます。','確認する成果物：目的と必要な接点を整理したメモ。'],['方針を定める','情報の優先順位と視覚表現の方向を整理します。複数の媒体へ展開する場合も、共通する判断の軸をつくります。','確認する成果物：優先順位と表現方針。'],['形にする','ロゴ、印刷物、空間グラフィック、展示演出を制作します。実際の大きさや素材の条件を踏まえ、細部を確かめます。','確認する成果物：制作物のデータと実寸の確認。'],['現場までつなぐ','設置や使用の場面で、企画と制作の意図が伝わるかを確認します。現場監修までを社内でつなぐことが、蒼紙舎の仕事の範囲です。','確認する成果物：設置・使用場面の確認記録。']];
---
<SiteLayout site={site} title="視覚設計の仕事" description="ブランドとロゴ、印刷物、空間グラフィック、展示演出を、企画から現場監修までつなぐ蒼紙舎の仕事をご紹介します。" path="/service/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'視覚設計の仕事'}]}>
<EditorialLead title="視覚設計の仕事" /><LabeledSection label="意図から、接点まで"><p>ブランドの刷新、ロゴの設計、印刷物の制作、空間の案内、展示の演出。蒼紙舎は、中小企業や文化施設が伝えたいことを整理し、見る人に届く視覚表現をつくります。企画から制作、現場監修までを社内でつなぎ、媒体ごとの条件を一つの方針にまとめていきます。</p><ScrollReveal animation="clip-up" duration={1500} class="mt-12"><img src="/sites/corporate/_shared/20260918-0500/img-a-01.jpg" alt="紙の見本を広げた制作風景" width="2880" height="1800" loading="lazy" class="aspect-video w-full object-cover" /></ScrollReveal></LabeledSection>
<LabeledSection label="ご相談いただける領域">{fields.map(([h,p,k,project,href],i)=><ScrollReveal animation="fade-up" duration={1000} class="block border-t border-base-300 py-10"><div class="grid gap-8 md:grid-cols-[3fr_1fr]"><div><p>0{i+1}</p><h2 class="mt-3 text-xl">{h}</h2><p class="mt-5">{p}</p><a href={url(site, href)} class="mt-4 inline-block underline">制作例：{project}</a></div><WorkStudyPlate kind={k as 'A'|'C'|'D'|'E'} view="形" /></div></ScrollReveal>)}</LabeledSection>
<LabeledSection label="企画から現場監修まで"><NumberedPrinciples items={process.map(([title,text,deliverable])=>({title,text:`${text} ${deliverable}`}))} /></LabeledSection>
<LabeledSection label="相談の準備"><p>まだ形が決まっていなくても。相談内容を整理する際は「伝えたい相手」「変えたいこと」「必要な制作物」「希望する時期」をお聞かせください。すべてが決まっている必要はありません。費用や進行期間は本サイトでは一律に表示していません。</p></LabeledSection>
<RelatedPagePair site={site} items={[{title:'ご相談の前に',text:'よくある疑問を確認する。',href:'/faq/'},{title:'制作相談を申し込む',text:'相談内容を入力する。',href:'/contact/'}]} /></SiteLayout>
