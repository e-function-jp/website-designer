---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import EditorialLead from '../../../../../components/sections/EditorialLead.astro'; import LabeledSection from '../../../../../components/sections/LabeledSection.astro'; import WorkTileGrid from '../../../../../components/sections/WorkTileGrid.astro'; import RelatedPagePair from '../../../../../components/sections/RelatedPagePair.astro';
const images={A:'/sites/corporate/_shared/20260918-0500/img-a-03.jpg',B:'/sites/corporate/_shared/20260918-0500/img-a-04.jpg',C:'/sites/corporate/_shared/20260918-0500/img-a-05.jpg',D:'/sites/corporate/_shared/20260918-0500/img-a-06.jpg',E:'/sites/corporate/_shared/20260918-0500/img-a-07.jpg'} as const;
const works=[
 {kind:'A',name:'企業の視覚統一',field:'ブランディング・ロゴ・印刷物',href:'/projects/identity/',view:'制作例',image:images.A},
 {kind:'B',name:'ロゴの設計',field:'ロゴ・グラフィック',href:'/projects/mark/',view:'制作例',image:images.B},
 {kind:'C',name:'冊子の情報設計',field:'印刷物・グラフィック',href:'/projects/editorial/',view:'制作例',image:images.C},
 {kind:'D',name:'空間の案内計画',field:'空間グラフィック',href:'/projects/sign/',view:'制作例',image:images.D},
 {kind:'E',name:'展示の体験設計',field:'展示演出・印刷物',href:'/projects/exhibition/',view:'制作例',image:images.E},
] as const;
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="制作実績・制作例" description="蒼紙舎が扱う視覚設計を、五つの架空の制作例でご紹介します。各制作領域から詳細をご覧いただけます。" path="/projects/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績・制作例'}]}><ScrollReveal animation="fade-up" duration={1500}><div class="aogami-projects-intro"><EditorialLead title="制作実績・制作例" /></div><div class="aogami-projects-grid"><LabeledSection wide label="制作例一覧"><p class="mb-8 max-w-[42em]">この一覧は架空の制作例です。実在企業の受注実績ではありません。5つの領域を選ぶと、それぞれの詳細と追加図版をご覧いただけます。</p><WorkTileGrid site={site} works={works} /></LabeledSection></div><RelatedPagePair site={site} items={[{title:'視覚設計の仕事',text:'ご相談いただける領域と制作の流れをご覧ください。',href:'/service/'},{title:'制作相談を申し込む',text:'背景や検討中の内容をお聞かせください。',href:'/contact/'}]} /></ScrollReveal><style is:global>html[data-theme="aogami-corporate"] .aogami-projects-intro .lead{max-width:80rem;padding:1.5rem 1.25rem .5rem}html[data-theme="aogami-corporate"] .aogami-projects-grid .section{padding-top:0}html[data-theme="aogami-corporate"] .aogami-projects-grid .section h2{font-size:.875rem;margin-bottom:1rem}html[data-theme="aogami-corporate"] .aogami-projects-grid .space-y-8{row-gap:1rem}html[data-theme="aogami-corporate"] .aogami-projects-grid .grid{gap:1rem}html[data-theme="aogami-corporate"] .aogami-projects-grid a p{font-size:.75rem}html[data-theme="aogami-corporate"] .aogami-projects-metrics{margin-top:4rem}@media(min-width:768px){html[data-theme="aogami-corporate"] .aogami-projects-intro .lead{padding-left:5rem}html[data-theme="aogami-corporate"] .aogami-projects-grid .section{padding-top:0}}</style></SiteLayout>
