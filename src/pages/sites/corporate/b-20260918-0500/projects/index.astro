---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import EditorialLead from '../../../../../components/sections/EditorialLead.astro'; import LabeledSection from '../../../../../components/sections/LabeledSection.astro'; import WorkTileGrid from '../../../../../components/sections/WorkTileGrid.astro'; import RelatedPagePair from '../../../../../components/sections/RelatedPagePair.astro';
const images={A:'/sites/corporate/_shared/20260918-0500/img-a-03.jpg',B:'/sites/corporate/_shared/20260918-0500/img-a-04.jpg',C:'/sites/corporate/_shared/20260918-0500/img-a-05.jpg',D:'/sites/corporate/_shared/20260918-0500/img-a-06.jpg',E:'/sites/corporate/_shared/20260918-0500/img-a-07.jpg'} as const;
const defs=[['A','企業の視覚統一','ブランディング・ロゴ・印刷物','/projects/identity/'],['B','ロゴの設計','ロゴ・グラフィック','/projects/mark/'],['C','冊子の情報設計','印刷物・グラフィック','/projects/editorial/'],['D','空間の案内計画','空間グラフィック','/projects/sign/'],['E','展示の体験設計','展示演出・印刷物','/projects/exhibition/']] as const; const views=['全景','文字','形','紙への展開','余白','配置','素材の寄り','白黒','縮小','組み合わせ','運用'];
const works=views.flatMap((view,row)=>(row%2?[...defs].reverse():defs).map((d,i)=>({kind:d[0],name:d[1],field:d[2],href:d[3],view,image:(view==='全景'||view==='素材の寄り')?images[d[0]]:undefined,position:view==='素材の寄り'?`${20+i*15}% ${70-i*7}%`:undefined})));
---
<SiteLayout site={site} title="制作実績・制作例" description="蒼紙舎が扱う視覚設計を、五つの制作例と五十五の図版でご紹介します。実績数値と制作例を区別して見比べられます。" path="/projects/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績・制作例'}]}><EditorialLead title="制作実績・制作例" /><LabeledSection label="仕事を、接点から見る"><dl class="grid gap-4 sm:grid-cols-3"><div><dt class="text-[32px]">420件超</dt><dd>累計制作案件</dd></div><div><dt class="text-[32px]">68%</dt><dd>リピート発注率</dd></div><div><dt class="text-[32px]">35件</dt><dd>年間展示・空間案件</dd></div></dl><p class="mt-8">ここでは5つの制作例を、55の図版で紹介します。写真、文字、紙面、空間の案内を見比べながら、視覚設計の考え方をご覧ください。各図版は制作領域を伝えるための表現であり、55件の受注案件を示すものではありません。</p></LabeledSection><LabeledSection wide label="制作例一覧"><p class="mb-10 max-w-[42em]">5つの制作例・55の図版。担当領域から内容を見比べ、各詳細では何を整理し、どのように展開するかをご覧いただけます。</p><WorkTileGrid site={site} works={works} /></LabeledSection><RelatedPagePair site={site} items={[{title:'視覚設計の仕事',text:'ご相談いただける領域と制作の流れをご覧ください。',href:'/service/'},{title:'制作相談を申し込む',text:'背景や検討中の内容をお聞かせください。',href:'/contact/'}]} /></SiteLayout>
