---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import AogamiEditorialPage from '../../../../../../components/sections/AogamiEditorialPage.astro';
import ScrollReveal from '../../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="展示の体験設計" description="導入、解説、案内を一続きの体験として整える蒼紙舎の展示演出の制作例をご紹介します。" path="/projects/exhibition/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作実績・制作例',href:'/projects/'},{label:'展示の体験設計'}]}><ScrollReveal animation="fade-up" duration={1000}><AogamiEditorialPage site={site} title="展示の体験設計" intro="担当領域：展示演出・印刷物。展示に入る前の導入、内容を深める解説、次の場所へ進む案内。それぞれは小さな接点でも、見る人にとっては一続きの体験になります。" sections={[{label:'導入、解説、余韻',heading:'見る人の順序を考える',text:'入口では展示の主題に触れる短い言葉と余白を用います。立ち止まって読む距離や時間を踏まえ、見出しと本文を分けます。案内や印刷物にも同じ視覚の方針を通し、空間を離れた後も印象をつなぎます。'}]} related={[{title:'冊子の情報設計',text:'読む順序の設計を見る。',href:'/projects/editorial/'},{title:'制作相談を申し込む',text:'展示演出について相談する。',href:'/contact/'}]} /></ScrollReveal></SiteLayout>
