---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import EditorialLead from '../../../../../components/sections/EditorialLead.astro'; import LabeledSection from '../../../../../components/sections/LabeledSection.astro'; import ConsultationForm from '../../../../../components/ui/ConsultationForm.astro'; import RelatedPagePair from '../../../../../components/sections/RelatedPagePair.astro';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="制作のご相談" description="蒼紙舎のブランド、ロゴ、印刷物、空間グラフィック、展示演出について相談内容を入力して確認できます。" path="/contact/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'制作のご相談'}]}><ScrollReveal animation="fade-up" duration={1000}><EditorialLead title="制作のご相談" /><LabeledSection label="制作相談を申し込む"><p>ブランドの刷新、ロゴ、印刷物、空間グラフィック、展示演出について、検討している内容をお聞かせください。伝えたい相手や、変えたいことから整理していただけます。まだ決まっていない項目は、未定のままで構いません。</p><p>このサイトは架空企業の試作です。フォームでは入力と確認を試せますが、相談内容は送信されません。実際の氏名や連絡先は入力せず、サンプル情報をご使用ください。</p><ConsultationForm site={site} /></LabeledSection><RelatedPagePair site={site} items={[{title:'視覚設計の仕事',text:'ご相談いただける領域を確認する。',href:'/service/'},{title:'ご相談の前に',text:'相談準備の説明を読む。',href:'/faq/'}]} /></ScrollReveal></SiteLayout>
