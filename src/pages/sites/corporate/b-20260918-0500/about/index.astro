---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site';
import EditorialLead from '../../../../../components/sections/EditorialLead.astro'; import LabeledSection from '../../../../../components/sections/LabeledSection.astro'; import NumberedPrinciples from '../../../../../components/sections/NumberedPrinciples.astro'; import StudioPhotoStrip from '../../../../../components/sections/StudioPhotoStrip.astro'; import WorkStudyPlate from '../../../../../components/sections/WorkStudyPlate.astro'; import CompanyFacts from '../../../../../components/sections/CompanyFacts.astro'; import RelatedPagePair from '../../../../../components/sections/RelatedPagePair.astro';
const principles=[['意図を言葉にする','形を決める前に、誰に何を伝えたいのかを確かめる。判断の拠り所を言葉にして、制作の出発点を揃えます。'],['接点をつなぐ','ロゴだけ、印刷物だけで完結させず、見る人が出会う順序を考える。媒体をまたいでも同じ意図が伝わる関係をつくります。'],['読む人の側に立つ','見出し、文字の大きさ、情報の順序を検討する。見た目の印象と、必要なことが読み取れることを一緒に扱います。'],['素材を確かめる','紙の厚みや印刷の見え方、設置場所の光まで、表現に影響する条件を確かめる。画面の中だけで判断しません。'],['現場までつなぐ','企画と制作で決めた意図を、現場監修まで引き継ぐ。実際に使われる場所での見え方を、視覚設計の一部として考えます。'],['使い続ける視点を持つ','一度見せて終わる形ではなく、更新や展開の場面も考える。運用する人が判断しやすい、整理された表現を目指します。']];
---
<SiteLayout site={site} title="蒼紙舎について" description="蒼紙舎の理念、制作で大切にする六つの判断、制作体制と会社の基本情報をご紹介します。" path="/about/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'蒼紙舎について'}]}>
<EditorialLead title="蒼紙舎について" /><LabeledSection label="考え方" animation="fade"><h2 class="text-[28px]">かたちで、意図を残す</h2><p class="mt-8">伝えたいことが、見る人に届く。そのために、言葉と形の関係を整える。蒼紙舎は、ブランディングとグラフィックデザインを通して、中小企業や文化施設の視覚設計を手がけています。ロゴ、印刷物、空間グラフィック、展示演出を、別々の成果物で終わらせず、一つの意図でつなぎます。</p></LabeledSection>
<LabeledSection label="伝わる理由をつくる" animation="fade"><p>何を伝えるかと、どう見せるかを切り離さない。私たちは企画から制作、現場監修までを社内でつなぎます。紙面で読む情報も、空間で目にする案内も、受け取る場面はそれぞれ違います。媒体ごとの条件を確かめながら、企業や施設が大切にしている意図を、ぶれのない視覚表現へ整えていきます。</p></LabeledSection>
<LabeledSection label="制作で大切にすること" animation="fade"><NumberedPrinciples items={principles.map(([title,text])=>({title,text}))} /></LabeledSection>
<LabeledSection label="制作をつなぐ場所"><p>東京都台東区谷中を拠点に、14名で視覚設計に取り組む蒼紙舎。企画から制作、現場監修まで、仕事のつながりを社内で持っています。写真は制作環境を伝えるためのイメージです。</p><div class="mt-10"><StudioPhotoStrip first="/sites/corporate/_shared/20260918-0500/img-a-02.jpg" second="/sites/corporate/_shared/20260918-0500/img-a-01.jpg" /></div></LabeledSection>
<LabeledSection label="制作体制" animation="fade"><div class="grid gap-8 md:grid-cols-3"><div><h3>企画</h3><p>伝えたいことと必要な接点を整理し、視覚設計の方針を定めます。</p></div><div><h3>制作</h3><p>ロゴ、印刷物、空間グラフィック、展示演出へ、方針を具体的な形にします。</p></div><div><h3>現場監修</h3><p>制作したものが置かれる場面を確かめ、企画の意図を現場までつなぎます。</p></div></div></LabeledSection>
<LabeledSection label="視覚設計の広がり">{[['企業の輪郭を整える','ロゴや印刷物は、企業が社会と出会う接点です。伝えたいことを整理し、複数の媒体を通じて同じ意図を感じられる表現へつなぎます。','A'],['空間の中で伝える','空間グラフィックでは、設置位置や視線、移動の順序が伝わり方を変えます。情報と出会う場所を一緒に設計します。','D'],['展示の体験を支える','導入から解説、案内まで、見る人が展示に触れる流れを考えます。','E']].map(([h,p,k])=><div class="mb-16 grid gap-8 md:grid-cols-[2fr_1fr]"><div><h3>{h}</h3><p class="mt-4">{p}</p></div><WorkStudyPlate kind={k as 'A'|'D'|'E'} view="形" /></div>)}</LabeledSection>
<LabeledSection label="会社情報" animation="fade"><CompanyFacts facts={[{term:'商号',value:'蒼紙舎株式会社'},{term:'よみ',value:'あおがみしゃ'},{term:'設立',value:'2011年'},{term:'従業員数',value:'14名'},{term:'所在地',value:'東京都台東区谷中'},{term:'事業内容',value:'中小企業や文化施設向けのブランディング・グラフィックデザイン。ロゴ、印刷物、空間グラフィック、展示演出を一貫して手がけます。'}]} /></LabeledSection>
<RelatedPagePair site={site} items={[{title:'視覚設計の仕事',text:'ご相談いただける領域と、制作の進め方をご紹介します。',href:'/service/'},{title:'制作実績・制作例',text:'形にするときの考え方を、制作物からご覧いただけます。',href:'/projects/'}]} /></SiteLayout>
