---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import AogamiEditorialPage from '../../../../../components/sections/AogamiEditorialPage.astro';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="ご相談の前に" description="蒼紙舎に依頼できる範囲、相談の準備、料金や期間など未確定の条件についてお答えします。" path="/faq/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'ご相談の前に'}]}><ScrollReveal animation="fade-up" duration={1000}><AogamiEditorialPage site={site} title="ご相談の前に" intro="依頼する制作物や進め方がまだ決まっていないときは、伝えたい相手や、変えたいことから整理できます。ここでは、蒼紙舎の仕事の範囲と、相談を準備する際の考え方をまとめています。" sections={[{label:'よくあるご質問',heading:'何を依頼できますか',text:'ロゴ、印刷物、空間グラフィック、展示演出を含む、ブランディング・グラフィックデザインを手がけています。制作物が決まっていない場合も、誰に何を伝えたいか、どのような課題を感じているかから相談できます。費用や制作期間は媒体や範囲によって変わるため、一律には掲載していません。'}]} related={[{title:'視覚設計の仕事',text:'対応する領域を確認する。',href:'/service/'},{title:'制作のご相談',text:'入力と確認へ進む。',href:'/contact/'}]} /></ScrollReveal></SiteLayout>
