---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Steps from '../../../../../components/navigation/Steps.astro';
import Table from '../../../../../components/data-display/Table.astro';
import ClinicPageIntro from '../../../../../components/sections/ClinicPageIntro.astro';
import AobaConsultationBand from "../../../../../components/sections/AobaConsultationBand.astro";
import AobaClinicInfo from "../../../../../components/sections/AobaClinicInfo.astro";
import ClinicRelatedLinks from '../../../../../components/sections/ClinicRelatedLinks.astro';
import PageTopButton from '../../../../../components/ui/PageTopButton.astro';
import FloatingCta from '../../../../../components/site/FloatingCta.astro';

const SHARED = '/sites/corporate/_shared/20260915-1151';

const introImage = { src: `${SHARED}/img-b-02.jpg`, alt: '院内イメージ' };

const philosophyImage = { src: `${SHARED}/img-b-01.jpg`, alt: '相談風景のイメージ' };

const continuitySteps = [
  {
    number: '01',
    title: '初診相談',
    body: '歯並びや噛み合わせについて、気になっていることをお聞きします。治療方法が決まっていなくても、ご相談いただけます。',
  },
  {
    number: '02',
    title: '治療計画',
    body: '相談内容を踏まえ、治療の進め方を確認します。方法について知りたいこと、通院について気になることもお伝えください。',
  },
  {
    number: '03',
    title: '経過のフォロー',
    body: '治療中の経過確認から保定管理まで、継続して対応します。',
  },
];

const spaceImages = [
  { src: `${SHARED}/img-b-03.jpg`, alt: '診療室のイメージ', caption: '院内イメージ' },
  { src: `${SHARED}/img-b-05.jpg`, alt: '待合室のイメージ', caption: '院内イメージ' },
];

const overviewRows = [
  { k: '商号', v: 'あおば矯正歯科クリニック' },
  { k: 'よみ', v: 'あおばきょうせいしかくりにっく' },
  { k: '所在地', v: '静岡県藤枝市' },
  { k: '設立', v: '2011年' },
  { k: '従業員数', v: '14名' },
  { k: '業種', v: '矯正歯科医院' },
  { k: '事業内容', v: '小児から成人までの歯列矯正と噛み合わせ治療を中心に、マウスピース矯正・ワイヤー矯正・保定管理を提供する地域密着型の矯正専門医院。初診相談から治療計画・経過フォローまで一貫して行う。' },
];

const relatedLinks = [
  { label: '矯正治療について', href: '/service/', description: '子どもと大人の矯正、治療方法、保定管理をご案内します。' },
  { label: '初診相談・来院案内', href: '/contact/', description: '相談前に整理したいことと、予約入力デモを確認できます。' },
];
---
<SiteLayout
  site={site}
  title="当院について"
  description="静岡県藤枝市で小児から成人までの歯列矯正と噛み合わせ治療を行う矯正専門医院。初診相談から治療計画、経過のフォローまで一貫して対応するあおば矯正歯科クリニックの診療姿勢と医院概要をご案内します。"
  path="/about/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '当院について' }]}
>
  <!-- 01 医院紹介の導入 (animation: none) -->
  <ClinicPageIntro
    heading="当院について"
    description="静岡県藤枝市で、小児から成人までの歯列矯正と噛み合わせ治療を行う矯正専門医院です。初診相談から治療計画、経過のフォローまで、一貫して対応しています。"
    image={introImage}
  />

  <!-- 02 診療姿勢 (写真のみ fade-up) -->
  <section class="aoba-philosophy bg-base-100">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-18 py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-4">
          <SectionTitle title="歯並びと、噛み合わせを一緒に考える。" align="left" />
        </div>
        <div class="lg:col-span-7 lg:col-start-6">
          <div class="space-y-5 text-sm lg:text-base leading-[1.9] text-base-content/85 max-w-[32em]">
            <p>歯並びの見た目を整えたい。噛み合わせが気になる。子どもの歯の成長について相談したい。そうした気がかりを出発点に、初診相談から治療計画につなげます。</p>
            <p>あおば矯正歯科クリニックが中心に据えるのは、歯列矯正と噛み合わせ治療です。マウスピース矯正、ワイヤー矯正、保定管理を通じて、小児から成人までの通院を支えます。</p>
          </div>
        </div>
        <ScrollReveal animation="fade-up" duration={site.motion!.durationMs} class="lg:col-span-12">
          <figure class="mt-10 lg:mt-12 overflow-hidden">
            <img
              src={philosophyImage.src}
              alt={philosophyImage.alt}
              width="1500"
              height="1000"
              loading="lazy"
              class="w-full aspect-[3/2] object-cover"
              style="margin-right: calc(100% / 12 * -1); max-width: calc(100% + 8.33%);"
            />
            <figcaption class="mt-3 text-xs lg:text-sm text-base-content/65">
              院内イメージ
            </figcaption>
          </figure>
        </ScrollReveal>
      </div>
    </div>
  </section>

  <!-- 03 一貫した診療のつながり (青色面、右下のみ角丸) -->
  <section class="aoba-continuity bg-primary text-primary-content">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-18 py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-4">
          <SectionTitle title="相談で終わらない、診療のつながり。" align="left" />
          <div class="mt-8 hidden lg:block">
            <a href={url(site, '/service/#flow')} class="inline-flex items-center gap-2 text-sm lg:text-base font-medium border-b border-primary-content/40 pb-1 hover:border-primary-content text-primary-content">
              相談から治療までを見る
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <div class="lg:col-span-8">
          <ol class="space-y-12">
            {continuitySteps.map((s) => (
              <li class="grid lg:grid-cols-[120px_1fr] gap-6 lg:gap-12 items-start">
                <span class="text-4xl lg:text-[3rem] font-medium leading-none tracking-tight text-primary-content tabular-nums" aria-hidden="true">{s.number}</span>
                <div>
                  <h3 class="text-lg lg:text-xl font-bold mb-3 lg:mb-4">{s.title}</h3>
                  <p class="text-sm lg:text-base leading-[1.9] text-primary-content/90 max-w-[32em]">{s.body}</p>
                </div>
              </li>
            ))}
          </ol>
          <div class="lg:hidden mt-8">
            <a href={url(site, '/service/#flow')} class="inline-flex items-center gap-2 text-sm lg:text-base font-medium border-b border-primary-content/40 pb-1 hover:border-primary-content text-primary-content">
              相談から治療までを見る
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 04 診療の場面を知る (上段の写真のみ fade-left) -->
  <section class="aoba-spaces bg-base-100">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-18 py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-12">
          <SectionTitle title="相談する時間、通院する時間。" align="left" />
        </div>
        <ScrollReveal animation="fade-left" duration={site.motion!.durationMs} class="lg:col-span-8">
          <figure class="overflow-hidden">
            <img
              src={spaceImages[0].src}
              alt={spaceImages[0].alt}
              width="1500"
              height="844"
              loading="lazy"
              class="w-full aspect-[16/9] object-cover"
            />
            <figcaption class="mt-3 text-xs lg:text-sm text-base-content/65">
              {spaceImages[0].caption}
            </figcaption>
          </figure>
        </ScrollReveal>
        <div class="lg:col-span-4">
          <p class="text-sm lg:text-base leading-[1.9] text-base-content/85">
            初診相談では、歯並びや噛み合わせについて気になることをお聞かせください。子どもの矯正については、保護者の方の気がかりも相談の入口になります。
          </p>
        </div>
        <div class="lg:col-span-6 lg:col-start-7 order-3 lg:order-2">
          <p class="text-sm lg:text-base leading-[1.9] text-base-content/85">
            治療計画を確認した後も、経過を見ながら通院が続きます。当院では、治療から保定管理まで一貫して対応しています。
          </p>
        </div>
        <figure class="lg:col-span-6 order-2 lg:order-3">
          <img
            src={spaceImages[1].src}
            alt={spaceImages[1].alt}
            width="1200"
            height="900"
            loading="lazy"
            class="w-full aspect-[4/3] object-cover"
          />
          <figcaption class="mt-3 text-xs lg:text-sm text-base-content/65">
            {spaceImages[1].caption}
          </figcaption>
        </figure>
        <p class="lg:col-span-12 text-xs lg:text-sm text-base-content/65">
          写真は院内のイメージであり、実際の施設・設備を示すものではありません。
        </p>
      </div>
    </div>
  </section>

  <!-- 05 医院概要 (animation: none) -->
  <section id="overview" class="aoba-overview bg-base-100 scroll-mt-[104px]">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-18 py-16 lg:py-24">
      <div class="grid lg:grid-cols-12 gap-8 lg:gap-12 items-start">
        <div class="lg:col-span-4">
          <SectionTitle title="医院概要" align="left" />
        </div>
        <div class="lg:col-span-8">
          <Table>
            <tbody>
              {overviewRows.map((row) => (
                <tr>
                  <th class="w-28 lg:w-36 whitespace-nowrap align-top text-primary font-bold text-sm lg:text-base">{row.k}</th>
                  <td class="text-sm lg:text-base leading-relaxed">{row.v}</td>
                </tr>
              ))}
            </tbody>
          </Table>
        </div>
      </div>
    </div>
  </section>

  <!-- 06 次に確認すること (見出しのみ fade-up) -->
  <section class="aoba-related bg-base-100 border-t border-base-300">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-18 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="次に確認すること" align="left" />
      </ScrollReveal>
      <div class="mt-2">
        <ClinicRelatedLinks site={site} links={relatedLinks} />
      </div>
    </div>
  </section>

  <PageTopButton />
  <FloatingCta site={site} />
</SiteLayout>

<style>
  .aoba-continuity {
    border-bottom-right-radius: 112px;
  }
  @media (max-width: 767px) {
    .aoba-continuity {
      border-bottom-right-radius: 56px;
    }
  }
  @media (min-width: 1024px) {
    .aoba-philosophy,
    .aoba-spaces,
    .aoba-overview,
    .aoba-related,
    .aoba-continuity {
      padding-left: 72px;
      padding-right: 72px;
    }
  }

  /* 診療姿勢: 写真の右端を本文幅から1列分広げる */
  @media (min-width: 1024px) {
    .aoba-philosophy figure img {
      margin-right: calc(-100% / 12);
      width: calc(100% + 100% / 12);
    }
  }
</style>
