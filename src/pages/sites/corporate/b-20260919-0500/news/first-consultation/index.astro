---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import { images } from '../../content'; import KabukidoContentPage from '../../../../../../components/sections/KabukidoContentPage.astro';
const sections=[{heading:'1. 困っていることと、気に入っていること',body:'収納が足りない、家事の移動が長い、家族の居場所が重なる。困っていることは、いつ、どこで起きるかまで考えると伝えやすくなります。同じように、気に入っている場所も書き出してみてください。朝の光が入る窓辺や、家族が自然と集まる食卓など、残したい良さが新しい計画の軸になることがあります。',image:images.meeting,alt:'図面と素材を確認する相談の設計イメージ'},{heading:'2. 大切にしたいことを分けてみる',body:'家族それぞれが、住まいに違う希望を持っていることもあります。すぐに一つの答えにまとめず、「特に大切にしたいこと」「できれば取り入れたいこと」「まだ迷っていること」に分けてみてください。',image:images.wood,alt:'木製建具の設計イメージ'},{heading:'3. 決まっていることと、これからのこと',body:'新築では敷地の検討状況、リノベーションでは対象となる住宅の情報が、計画の前提になります。資料が揃っていない場合は、分からないことを分けておくだけでも構いません。',link:{label:'家づくりの流れを見る',href:'/flow/'}},{heading:'言葉になったことから、次の一歩へ。',body:'整理した内容は、きれいな文章にする必要はありません。短い箇条書きでも、家族の言葉のままでも、暮らしを考える手がかりになります。',link:{label:'モデルハウスを見る',href:'/model-house/'}}];
---
<SiteLayout site={site} title="家づくり相談の前に" description="間取りや素材をすべて決めておく必要はありません。今の暮らしを振り返り、相談の準備を始めるための具体的な整理の方法です。" path="/news/first-consultation/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'お知らせ',href:'/news/'},{label:'家づくり相談の前に'}]}><KabukidoContentPage site={site} title="家づくり相談の前に、整理しておきたいこと" lead="家づくりについて話そうと思っても、何から伝えればよいか迷うことがあります。間取りや素材をすべて決めておく必要はありません。今の暮らしを振り返り、これから大切にしたいことを短い言葉にするところから始めてみてください。" sections={sections} sectionAnimations={{0:{target:'heading'},1:{target:'image'},2:{target:'heading'},3:{target:'heading'}}} /></SiteLayout>
