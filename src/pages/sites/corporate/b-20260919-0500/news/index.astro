---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import { images } from '../content'; import KabukidoContentPage from '../../../../../components/sections/KabukidoContentPage.astro';
const sections=[{heading:'家づくり相談の前に、整理しておきたいこと',body:'希望がまとまっていなくても、今の暮らしで感じていることは相談の手がかりになります。困っていること、残したいこと、まだ迷っていることを分けて、住まいについて話し始める準備をしてみませんか。',image:images.meeting,alt:'相談の設計イメージ',link:{label:'相談前の案内を読む',href:'/news/first-consultation/'}},{heading:'モデルハウスで確かめたい三つのこと',body:'家族の距離、光と壁の関係、手が触れる場所。見学では、自分たちの日常を重ねてみることが大切です。',image:images.plaster,alt:'左官壁の設計イメージ',link:{label:'見学のポイントを見る',href:'/model-house/#checkpoints'}},{heading:'新築と全面リノベーションの考え方',body:'新しくつくる場合と、今ある家を生かす場合では、確認する条件が異なります。',image:images.renovation,alt:'改修の設計イメージ',link:{label:'つくり方の違いを知る',href:'/service/'}}];
---
<SiteLayout site={site} title="お知らせ" description="相談の前に整理しておきたいこと、見学で確かめたいこと、つくり方を選ぶときの考え方をまとめたご案内です。" path="/news/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'お知らせ'}]}><KabukidoContentPage site={site} title="お知らせ" lead="家づくりを考える方へ。相談の前に整理しておきたいこと、見学で確かめたいこと、つくり方を選ぶときの考え方をまとめました。" sections={sections} sectionAnimations={{0:{target:'image'},1:{target:'image'},2:{target:'image'}}} /></SiteLayout>
