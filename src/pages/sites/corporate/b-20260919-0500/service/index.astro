---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { figures, images } from '../content';
import QuietPageIntro from '../../../../../components/sections/QuietPageIntro.astro';
import EditorialPair from '../../../../../components/sections/EditorialPair.astro';
import CircleTextLink from '../../../../../components/ui/CircleTextLink.astro';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
---
<SiteLayout site={site} title="注文住宅・リノベーション" description="新しくつくる注文住宅と、今ある家を住み継ぐ全面リノベーション。二つの方法と相談前に整理したいことをご紹介します。" path="/service/" breadcrumbs={[{ label:'ホーム', href:'/' },{ label:'注文住宅・リノベーション' }]}>
  <QuietPageIntro title="注文住宅・リノベーション" lead="住まいを考えるとき、方法は一つではありません。敷地に合わせて一からつくる注文住宅と、中古住宅を暮らしに合わせて整える全面リノベーション。株木堂建築は、どちらも設計から施工まで手がけます。" />
  <figure class="wide"><img src={images.home} alt="木と左官の住まいの設計イメージ" width="2400" height="1600" loading="lazy" /><figcaption>写真は設計イメージです。</figcaption></figure>
  <nav class="anchors" aria-label="サービス内メニュー"><a href="#new-build">新築注文住宅</a><a href="#renovation">全面リノベーション</a></nav>
  <section class="comparison"><div><h2>決まっていないことも、相談の出発点です。</h2><p>どちらを選ぶか迷っている場合も、先に結論を出す必要はありません。今の住まいで困っていることと、これから大切にしたいことを分けておくと、相談の論点が見えてきます。</p></div><ScrollReveal animation="fade-up" duration={2000}><img src={images.wood} alt="木製建具の設計イメージ" width="1600" height="2400" loading="lazy" /></ScrollReveal><div class="table-wrap"><table><thead><tr><th>確認すること</th><th>新築</th><th>全面リノベーション</th></tr></thead><tbody><tr><th>住まいの場所</th><td>敷地の希望や検討状況</td><td>対象となる住宅の状況</td></tr><tr><th>暮らしの希望</th><td>平屋・2階建て、部屋の使い方</td><td>残したい部分、変えたい使い方</td></tr><tr><th>確認する条件</th><td>敷地と周辺環境</td><td>既存建物の状態と改修範囲</td></tr></tbody></table></div></section>
  <section id="new-build"><ScrollReveal animation="fade-up" duration={2000}><EditorialPair image={images.exterior} alt="平屋の設計イメージ" reverse><h2>家族の暮らしから、間取りをつくる。</h2><p>朝の支度、食卓を囲む時間、洗濯や片付け。毎日の動きを言葉にすることから、注文住宅の検討が始まります。敷地の形や周囲との関係を確かめ、光と風、家族の距離、ものの置き場所を考えます。</p><dl><div><dt>平屋を考える</dt><dd>一つの階に生活をまとめたいときは、部屋同士の距離と外とのつながりを確かめます。</dd></div><div><dt>2階建てを考える</dt><dd>階ごとの過ごし方を分けながら、階段を含む毎日の移動を整理します。</dd></div></dl><CircleTextLink site={site} href="/contact/?type=new-build" label="注文住宅について相談する" /></EditorialPair></ScrollReveal></section>
  <section id="renovation"><ScrollReveal animation="fade-up" duration={2000}><EditorialPair image={images.renovation} alt="全面リノベーションの設計イメージ"><h2>残す良さと、変える理由を見つける。</h2><p>今ある住まいには、その家ならではの光や広がりがあります。全面リノベーションでは、希望する間取りや素材の話とともに、建物の状態を確認することが大切です。残したい場所、不便に感じる場所、まだ判断できない場所を分けて考え、改修の範囲を整理します。</p><CircleTextLink site={site} href="/contact/?type=renovation" label="リノベーションについて相談する" /></EditorialPair></ScrollReveal></section>
  <section class="proof"><ScrollReveal animation="fade-up" duration={2000}><h2>家づくりを、具体的な順序へ。</h2></ScrollReveal><p>累計施工480棟、リノベ完工率92%、モデルハウス来場は年1,200組。会社の概要とともに、相談から引き渡しまでの確認事項をご覧いただけます。費用や工期は、計画の条件と合わせて相談する項目として整理しています。</p><dl>{figures.map(([label,value]) => <div><dt>{label}</dt><dd>{value}</dd><small>2026年9月時点</small></div>)}</dl><div><CircleTextLink site={site} href="/flow/" label="家づくりの流れを見る" /><CircleTextLink site={site} href="/company/" label="会社案内を見る" /></div></section>
</SiteLayout>
<style>
  .wide { width:min(1120px,100%); margin:auto; } .wide img { display:block; width:100%; height:clamp(320px,45vw,620px); object-fit:cover; } figcaption { margin-top:12px; font-size:14px; } .anchors { display:flex; gap:24px; width:min(880px,calc(100% - 48px)); margin:48px auto 0; } .anchors a { min-height:48px; color:inherit; text-underline-offset:6px; } section { width:min(960px,calc(100% - 48px)); margin:auto; padding:72px 0; } h2 { font-size:clamp(26px,3vw,32px); font-weight:500; line-height:1.55; } p,td,dd { font-size:16px; line-height:1.9; } .comparison { display:grid; gap:32px; } .comparison > :global(.scroll-reveal) img { display:block; width:160px; height:140px; object-fit:cover; } .table-wrap { overflow-x:auto; } table { width:100%; border-collapse:collapse; min-width:640px; } th,td { text-align:left; vertical-align:top; padding:16px; border-bottom:1px solid var(--color-base-300); } th { color:var(--color-primary); font-weight:500; } dl { margin:24px 0; } dl div { padding:16px 0; border-top:1px solid var(--color-base-300); } dd { margin:8px 0 0; } .proof { width:min(880px,calc(100% - 48px)); } .proof > dl { display:grid; gap:0; margin-top:32px; border-top:1px solid var(--color-base-300); } .proof dd { font-size:28px; } small { color:color-mix(in srgb,var(--color-base-content) 70%,transparent); } .proof > div:last-child { display:grid; gap:16px; margin-top:32px; } @media(min-width:768px) { .comparison { grid-template-columns:1fr 200px; } .comparison .table-wrap { grid-column:1/-1; } .proof > dl { grid-template-columns:repeat(3,1fr); gap:24px; } .proof > dl div { border-top:0; border-left:1px solid var(--color-base-300); padding-left:24px; } .proof > div:last-child { grid-template-columns:1fr 1fr; } }
</style>
