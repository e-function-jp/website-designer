---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import { photos } from '../content'; import QuietPageIntro from '../../../../../components/sections/QuietPageIntro.astro'; import HousePhotoCollage from '../../../../../components/sections/HousePhotoCollage.astro'; import CircleTextLink from '../../../../../components/ui/CircleTextLink.astro';
---
<SiteLayout site={site} title="住まいの写真" description="木と左官を使った住まいの設計イメージを、窓辺の光、壁の陰影、木の手触り、改修の空間という四つの視点でご紹介します。" path="/works/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'住まいの写真'}]}><QuietPageIntro title="住まいの写真" lead="一つの住まいを、四つの視点から。家全体の雰囲気だけでなく、窓辺の光、壁の陰影、木の手触りにも目を向けてみてください。" /><p class="notice">掲載写真は設計イメージです。実際の施工物件を紹介するものではありません。</p><section><HousePhotoCollage site={site} photos={photos} revealAll /></section><section class="guide"><h2>好きな雰囲気から、暮らしの希望へ。</h2><p>写真のどこに惹かれたのかを、短い言葉にしてみてください。理由が分かると、ご家族の暮らしに合う取り入れ方を考えやすくなります。</p><CircleTextLink site={site} href="/about/" label="家づくりの考え方を読む" /><CircleTextLink site={site} href="/service/" label="注文住宅・リノベーションを知る" /></section></SiteLayout>
<style>.notice,.guide { width:min(680px,calc(100% - 48px)); margin:auto; line-height:1.9; }.notice { padding:24px; background:var(--color-base-200); }section { padding:96px 0; }.guide :global(.circle-text-link) { display:flex; margin-top:16px; }h2 { font-size:clamp(26px,3vw,32px); font-weight:500; }</style>
