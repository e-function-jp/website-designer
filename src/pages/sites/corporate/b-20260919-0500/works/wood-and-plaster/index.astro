---
import SiteLayout from '../../../../../../layouts/SiteLayout.astro'; import { site } from '../../_site'; import { images } from '../../content'; import KabukidoContentPage from '../../../../../../components/sections/KabukidoContentPage.astro';
const sections=[{id:'light',heading:'家族が集まる場所から考える。',body:'食卓は、食事だけをする場所とは限りません。どんな時間を過ごすかによって、欲しい明るさや周囲との距離も変わります。窓の位置だけでなく、座ったときに見えるものや、隣の部屋とのつながりにも目を向けてみてください。',image:images.home,alt:'食卓に届く光の設計イメージ'},{id:'plaster',heading:'壁は、暮らしの背景になる。',body:'左官の壁は、距離や光によって表情の見え方が変わります。木や家具と並んだときの落ち着きも大切にしたいところです。',image:images.plaster,alt:'左官の陰影の設計イメージ'},{id:'wood',heading:'毎日、手が届くところに。',body:'建具を開く、床を歩く、窓辺に腰をかける。木のある住まいを考えるときは、どんな動作で触れるかを想像してみてください。',image:images.wood,alt:'木の手触りの設計イメージ'},{id:'renewal',heading:'変えるところを、暮らしから見つける。',body:'今ある家を見直すときは、不便な部分だけでなく、気に入っている場所にも目を向けてみてください。',image:images.renovation,alt:'リノベーションの設計イメージ',link:{label:'全面リノベーションを知る',href:'/service/#renovation'}}];
---
<SiteLayout site={site} title="木と左官の住まい" description="木の床と左官の壁がある住まいを、光、壁、木部、改修後の空間という四つの視点から読む設計イメージの記事です。" path="/works/wood-and-plaster/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'住まいの写真',href:'/works/'},{label:'木と左官の住まい'}]}><KabukidoContentPage site={site} title="木と左官の住まい" lead="光と素材から、暮らしを思い描く。写真は設計イメージです。実際の施工実績・モデルハウスの写真ではありません。" sections={sections} sectionAnimations={{0:{target:'image'},1:{target:'image'},2:{target:'image'},3:{target:'image'}}} /></SiteLayout>
