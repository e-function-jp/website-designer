---
import SiteLayout from '../../../../../layouts/SiteLayout.astro'; import { site } from '../_site'; import KabukidoContentPage from '../../../../../components/sections/KabukidoContentPage.astro';
const sections=[{heading:'1. 入力する情報',body:'相談フォームには、相談種別、お名前、メールアドレス、電話番号、希望日、見学人数、相談内容の入力欄があります。必須と表示された項目は確認画面を表示するために使用し、任意の項目は空欄のまま進められます。'},{heading:'2. 外部への送信',body:'本サンプルのフォームには送信機能がありません。入力した内容をメールや問い合わせ管理システムへ送信せず、第三者への提供や営業連絡にも使用しません。確認画面が表示されても、家づくり相談、モデルハウス見学、採用応募の受付や予約は成立しません。'},{heading:'3. 画面内での保持',body:'入力内容は、同じ画面で確認や修正を行う間だけ一時的に保持します。フォームが入力内容をCookie、localStorage、URLに保存することはありません。画面を閉じるか再読み込みすると、フォーム内で保持している内容は失われます。'},{heading:'4. この説明が対象とするもの',body:'このページは、本サンプルに実装された相談フォームの動作について説明しています。サイトへのアクセスに伴う通信や、ご利用の端末・ブラウザーの機能全体について説明するものではありません。',link:{label:'家づくり相談に戻る',href:'/contact/'}}];
---
<SiteLayout site={site} title="個人情報の取り扱い" description="架空の企業である株木堂建築株式会社のサンプルサイトにおける、相談フォームの入力内容の取り扱いと動作範囲を説明します。" path="/privacy/" breadcrumbs={[{label:'ホーム',href:'/'},{label:'個人情報の取り扱い'}]}><KabukidoContentPage site={site} title="個人情報の取り扱い" lead="このページは、架空の企業である株木堂建築株式会社のサンプルサイトにおける、相談フォームの入力内容の取り扱いを説明するものです。相談フォームは入力と内容確認のために設けており、予約、問い合わせ、採用応募の送信は行いません。" sections={sections} sectionAnimations={{0:{target:'heading'},1:{target:'heading'},2:{target:'heading'},3:{target:'heading'}}} /></SiteLayout>
