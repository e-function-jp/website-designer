---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Alert from '../../../../../components/data-display/Alert.astro';
import Table from '../../../../../components/data-display/Table.astro';
import ClinicPageIntro from '../../../../../components/sections/ClinicPageIntro.astro';
import ClinicRelatedLinks from '../../../../../components/sections/ClinicRelatedLinks.astro';
import ClinicPageEnd from '../../../../../components/sections/ClinicPageEnd.astro';
import PageTopButton from '../../../../../components/ui/PageTopButton.astro';

const SHARED = '/sites/corporate/_shared/20260915-1151';

const intro = {
  heading: '個人情報の取り扱い',
  description: 'このページでは、あおば矯正歯科クリニックのサンプルサイトにおける、情報入力と送信の扱いについてご案内します。実在する医療機関の個人情報保護方針を示すものではありません。',
  image: { src: `${SHARED}/img-a-08.jpg`, alt: '矯正歯科クリニックの入口' },
};

const inputRows = [
  ['予約の送信', '受け付けていません'],
  ['相談内容の入力', '入力欄を設けていません'],
  ['予約の確定', 'このサイト上では行いません'],
];

const relatedLinks = [
  { label: '初診相談', href: '/contact/', description: '予約受付状況と相談前の確認事項をご案内します。' },
  { label: '当院について', href: '/about/', description: '架空の医院設定と診療姿勢をご確認いただけます。' },
];
---
<SiteLayout
  site={site}
  title="個人情報の取り扱い"
  description="あおば矯正歯科クリニックのサンプルサイトにおける、情報入力と送信の扱いについてご案内します。実在する医療機関の個人情報保護方針ではありません。"
  path="/privacy/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '個人情報の取り扱い' }]}
>
  <ClinicPageIntro heading={intro.heading} description={intro.description} image={intro.image} />

  <!-- 1. このサイトの位置づけ -->
  <section class="bg-base-100">
    <div class="max-w-[760px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="架空の医院を紹介するサンプルです" align="left" />
      </ScrollReveal>
      <Alert variant="info">
        <div class="space-y-3 text-sm lg:text-base leading-loose">
          <p>このサイトに掲載する医院情報は、架空の企業設定に基づいています。診療内容や初診相談の流れを紹介してためのためのもので、実際の医療相談や予約を受け付ける窓口ではありません。</p>
          <p>掲載写真はイメージであり、実際の医師・患者・設備を示すものではありません。サイト上の情報を通じて、特定の医療機関への受診や予約が確定することはありません。</p>
        </div>
      </Alert>
    </div>
  </section>

  <!-- 2. 入力と送信の扱い -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[760px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="個人情報を入力・送信する機能はありません" align="left" />
      </ScrollReveal>
      <div class="space-y-4 text-sm lg:text-base leading-loose text-base-content/85 mt-4">
        <p>このサンプルサイトには、氏名、連絡先、症状などを入力して医院へ送信するフォームを設けていません。初診相談ページにも、予約日時の選択や予約内容の送信機能はありません。</p>
        <p>診療に関する個人的な情報を、このサイトへ送る必要はありません。</p>
      </div>
      <div class="mt-8">
        <Table>
          <tbody>
            {inputRows.map(([k, v]) => (
              <tr>
                <th class="w-[35%] whitespace-nowrap align-top text-primary font-bold text-sm">{k}</th>
                <td class="text-sm lg:text-base">{v}</td>
              </tr>
            ))}
          </tbody>
        </Table>
      </div>
    </div>
  </section>

  <!-- 3. 外部サービスと閲覧環境 -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[760px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="外部予約サービスへの接続について" align="left" />
      <div class="space-y-5 text-sm lg:text-base leading-loose text-base-content/85">
        <p>このサンプルサイトには、外部予約サービス、相談用チャット、地図、診療カレンダーの埋め込みを設けていません。医院への電話やメールの送信先も掲載していません。</p>
        <p>このサイトのページには、広告・アクセス解析を目的としたタグやCookieを設定していません。配信基盤やご利用のブラウザーによる通信情報の取り扱いは、このページで説明する入力・送信機能とは別の範囲です。</p>
      </div>
      <Alert variant="info" class="mt-8">
        <p class="text-sm lg:text-base leading-loose">
          予約受付状況は『初診相談』ページから確認できます。
        </p>
      </Alert>
      <div class="mt-8">
        <a
          href={url(site, '/contact/#reservation')}
          class="inline-flex items-center gap-2 text-sm lg:text-base font-medium border-b border-base-content/40 pb-1 hover:border-base-content"
        >
          予約受付状況を確認する
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. 関連するご案内 -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="関連するご案内" align="left" />
      <ClinicRelatedLinks site={site} links={relatedLinks} />
    </div>
  </section>

  <ClinicPageEnd site={site} />
  <PageTopButton />
</SiteLayout>