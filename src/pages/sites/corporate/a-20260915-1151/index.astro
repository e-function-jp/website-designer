---
import SiteLayout from '../../../../layouts/SiteLayout.astro';
import { site } from './_site';
import { url } from '../../../../lib/site';
import ScrollReveal from '../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../components/ui/SectionTitle.astro';
import Card from '../../../../components/data-display/Card.astro';
import Stat from '../../../../components/data-display/Stat.astro';
import Badge from '../../../../components/data-display/Badge.astro';
import ClinicFeatureRows from '../../../../components/sections/ClinicFeatureRows.astro';
import ClinicRelatedLinks from '../../../../components/sections/ClinicRelatedLinks.astro';
import ClinicPageEnd from '../../../../components/sections/ClinicPageEnd.astro';
import PageTopButton from '../../../../components/ui/PageTopButton.astro';

const SHARED = '/sites/corporate/_shared/20260915-1151';

const heroImage = { src: `${SHARED}/img-a-01.jpg`, alt: '矯正歯科クリニックの受付。明るいオーク材のカウンターと窓からの自然光' };

const newsRows = [
  { label: '初診相談をお考えの方へ', href: '/news/#first-visit' },
  { label: '矯正治療のご案内', href: '/news/#treatment' },
  { label: '予約受付状況について', href: '/news/#reservation-info' },
];

const consultationImage = { src: `${SHARED}/img-a-02.jpg`, alt: '初診相談でスタッフと相談者が机を挟んで対話している' };

const features = [
  {
    number: '01',
    title: '子どもから大人まで',
    body: '成長期のお子さまの歯並びから、成人の見た目や噛み合わせの悩みまで。矯正を考えるきっかけに合わせて、相談の入口を用意しています。',
    image: { src: `${SHARED}/img-a-07.jpg`, alt: '子どもと保護者、スタッフが穏やかに話している相談場面' },
  },
  {
    number: '02',
    title: '噛み合わせを見据えた治療',
    body: '歯並びと噛み合わせを中心に、マウスピース矯正・ワイヤー矯正をご案内します。',
    image: { src: `${SHARED}/img-a-05.jpg`, alt: 'マウスピース矯正の装置を白いトレーの上に置いた説明用イメージ' },
  },
  {
    number: '03',
    title: '治療後も続くフォロー',
    body: '治療計画や治療中の経過確認に加え、保定管理まで一貫して行います。',
    image: { src: `${SHARED}/img-a-03.jpg`, alt: '矯正歯科クリニックのスタッフ3人が診療準備について話している' },
  },
];

const treatmentsBand = { src: `${SHARED}/img-a-04.jpg`, alt: '矯正歯科クリニックの診療室。淡いグレーの診療チェアと明るいオーク材の収納' };
const treatmentCards = [
  { title: '大人の矯正', desc: '見た目と噛み合わせの悩みを相談する', href: '/service/#adult', image: { src: `${SHARED}/img-a-02.jpg`, alt: '大人の矯正のイメージ写真' } },
  { title: '子どもの矯正', desc: 'お子さまの歯並びを相談する', href: '/service/#child', image: { src: `${SHARED}/img-a-07.jpg`, alt: '子どもの矯正のイメージ写真' } },
  { title: 'マウスピース矯正', desc: '取り扱う治療を知る', href: '/service/#aligner', image: { src: `${SHARED}/img-a-05.jpg`, alt: 'マウスピース矯正のイメージ写真' } },
  { title: 'ワイヤー矯正・保定管理', desc: '治療とその後を知る', href: '/service/#wire', image: { src: `${SHARED}/img-a-06.jpg`, alt: 'ワイヤー矯正のイメージ写真' } },
];

const stats = [
  { title: '矯正相談 累計', value: '4,800件' },
  { title: '小児矯正 年間', value: '320症例' },
  { title: '通院継続率', value: '92%' },
];

const peoplePhotos = [
  { src: `${SHARED}/img-a-03.jpg`, alt: '医院のスタッフ', caption: '相談の入口' },
  { src: `${SHARED}/img-a-01.jpg`, alt: '受付と診療空間', caption: '診療の空間' },
  { src: `${SHARED}/img-a-08.jpg`, alt: 'クリニックの入口', caption: '医院の入口' },
];

const relatedLinks = [
  {
    label: 'はじめての方へ',
    href: '/new-patients/',
    description: '初診相談から治療までの進み方をご案内します。',
  },
  {
    label: '矯正治療のご案内',
    href: '/service/',
    description: '大人・子どもの矯正と治療方法を確認できます。',
  },
];
---
<SiteLayout
  site={site}
  title="噛み合わせから整える矯正"
  description="あおば矯正歯科クリニックは静岡県藤枝市の矯正専門医院です。お子さまから大人まで、歯並びと噛み合わせの相談に向き合い、治療計画から経過のフォローまで一貫して支えます。"
  path="/"
  isHome
>
  <!-- 1. ヒーロー（PC 上部に左寄せキャッチ、下に受付写真。モバイルは縦積み） -->
  <section class="top-hero bg-base-100">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-10 pt-12 lg:pt-20 pb-12 lg:pb-24">
      <div class="grid lg:grid-cols-[600px_minmax(0,1fr)] lg:gap-12 items-end">
        <div>
          <p class="text-xs lg:text-sm tracking-[0.18em] text-primary font-bold mb-4 lg:mb-6">静岡県藤枝市の矯正歯科</p>
          <h1 class="text-[1.875rem] lg:text-[2.875rem] font-medium leading-snug tracking-[0.06em] mb-5 lg:mb-6">
            噛み合わせから整える矯正
          </h1>
          <p class="text-base lg:text-lg leading-loose text-base-content/85 mb-4 max-w-[36em]">
            あおば矯正歯科クリニックは、静岡県藤枝市の矯正専門医院です。お子さまから大人まで、歯並びと噛み合わせの相談に向き合い、治療計画から経過のフォローまで一貫して支えます。
          </p>
          <p class="text-sm lg:text-base leading-loose text-base-content/75 mb-8 max-w-[36em]">
            気になることを、初診相談でお聞かせください。
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={url(site, '/contact/')} class="btn btn-primary btn-lg">{site.primaryCta?.label}</a>
            <a
              href={url(site, '/new-patients/')}
              class="inline-flex items-center gap-2 text-sm lg:text-base font-medium border-b border-base-content/40 pb-1 hover:border-base-content self-center"
            >
              はじめての方へ
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
        <figure class="top-hero__photo order-first lg:order-last">
          <img
            src={heroImage.src}
            alt={heroImage.alt}
            width="1500"
            height="1000"
            fetchpriority="high"
            loading="eager"
            class="w-full aspect-[16/9] object-cover rounded-lg"
          />
        </figure>
      </div>
    </div>
  </section>

  <!-- 2. お知らせへの入口 -->
  <section class="top-news bg-base-200">
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <div class="grid lg:grid-cols-[20%_80%] gap-8 lg:gap-12">
        <SectionTitle title="医院からのご案内" align="left" />
        <div>
          <p class="text-sm lg:text-base leading-loose text-base-content/85 mb-8">
            初診相談や診療内容について、来院前に確認したい情報をまとめています。
          </p>
          <ul class="border-t border-base-300">
            {newsRows.map((row) => (
              <li class="border-b border-base-300">
                <a
                  href={url(site, row.href)}
                  class="news-row group flex items-center justify-between py-5 lg:py-7 hover:text-primary"
                >
                  <span class="flex items-center gap-3 lg:gap-4">
                    <Badge variant="outline">常設案内</Badge>
                    <span class="text-sm lg:text-base font-medium">{row.label}</span>
                  </span>
                  <span aria-hidden="true" class="text-base-content/50 group-hover:text-primary transition-colors">→</span>
                </a>
              </li>
            ))}
          </ul>
          <div class="mt-8 text-right">
            <a
              href={url(site, '/news/')}
              class="inline-flex items-center gap-2 text-sm lg:text-base font-medium border-b border-base-content/40 pb-1 hover:border-base-content"
            >
              お知らせ一覧を見る
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3. はじめての相談（写真＋本文を fade-up） -->
  <section class="top-consultation bg-base-100">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24 grid lg:grid-cols-[45%_55%] gap-8 lg:gap-20 items-center">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <figure>
          <img
            src={consultationImage.src}
            alt={consultationImage.alt}
            width="1200"
            height="900"
            loading="lazy"
            class="w-full aspect-[4/5] object-cover rounded-lg"
          />
        </figure>
      </ScrollReveal>
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="気になる歯並びを、話すところから。" align="left" />
        <div class="space-y-5 text-sm lg:text-base leading-loose text-base-content/85">
          <p>子どもの歯並びが気になっている。大人になってから、見た目や噛み合わせを整えたい。きっかけは、一人ひとり違います。</p>
          <p>初診相談では、まず気になっていることや治療へのご希望をお聞かせください。治療方法を決めてからしてする必要はありません。相談から治療計画、経過の確認までの道筋をご案内します。</p>
        </div>
        <a
          href={url(site, '/new-patients/')}
          class="inline-flex items-center gap-2 mt-8 text-sm lg:text-base font-medium border-b border-base-content/40 pb-1 hover:border-base-content"
        >
          初診相談の流れを見る
          <span aria-hidden="true">→</span>
        </a>
      </ScrollReveal>
    </div>
  </section>

  <!-- 4. 青い面で示す医院の特徴 -->
  <ClinicFeatureRows
    site={site}
    rows={features}
    totalHeading="相談から、その先の通院まで。"
    trailingLink={{ label: '当院の診療姿勢を読む', href: '/about/' }}
  />

  <!-- 5. 診療案内と実績 -->
  <section class="top-treatments bg-base-100">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-10 pt-16 lg:pt-24 pb-20 lg:pb-32">
      <div class="relative">
        <figure class="top-treatments__band">
          <img
            src={treatmentsBand.src}
            alt={treatmentsBand.alt}
            width="1500"
            height="750"
            loading="lazy"
            class="w-full aspect-[16/6] object-cover rounded-lg"
          />
        </figure>
        <div class="max-w-[1100px] mx-auto px-5 lg:px-0 lg:-mt-20 relative">
          <div class="grid lg:grid-cols-[35%_65%] gap-8 lg:gap-12">
            <SectionTitle title="矯正治療のご案内" align="left" />
            <div>
              <p class="text-sm lg:text-base leading-loose text-base-content/85 mb-8">
                年齢や気になることに応じた入口から、当院で行う治療を確認できます。具体的な治療方法は、相談と治療計画の中で検討します。
              </p>
              <ul class="grid gap-5 sm:grid-cols-2">
                {treatmentCards.map((card) => (
                  <li>
                    <a
                      href={url(site, card.href)}
                      class="treatment-card group block bg-base-100 border border-base-300 hover:border-primary transition-colors overflow-hidden h-full"
                    >
                      <figure class="aspect-[4/3] overflow-hidden bg-base-200">
                        <img
                          src={card.image.src}
                          alt={card.image.alt}
                          width="800"
                          height="600"
                          loading="lazy"
                          class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.02]"
                        />
                      </figure>
                      <div class="p-5">
                        <p class="text-base lg:text-lg font-bold mb-1">{card.title}</p>
                        <p class="text-sm text-base-content/75">{card.desc}</p>
                      </div>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>

      <dl class="max-w-[1100px] mx-auto mt-16 lg:mt-24 grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8 border-t border-base-300 pt-12">
        {stats.map((s) => (
          <Stat title={s.title} value={s.value} desc="" class="text-center sm:text-left" />
        ))}
      </dl>
      <p class="max-w-[900px] mx-auto mt-6 text-xs lg:text-sm leading-loose text-base-content/65">
        数値は架空の医院設定です。集計期間・算出条件は設定されていません。治療結果を保証するものではありません。
      </p>
    </div>
  </section>

  <!-- 6. 医院を知る入口 -->
  <section class="top-people bg-base-200">
    <div class="max-w-[1400px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <SectionTitle title="一人ひとりの相談を、医院全体で支える。" align="left" />
          <div class="space-y-5 text-sm lg:text-base leading-loose text-base-content/85">
            <p>2011年に設立したあおば矯正歯科クリニックは、14名の体制で、地域の矯正相談と継続的な通院を支えています。初診相談から治療計画、治療中のフォロー、保定管理まで、矯正専門医院として一貫して取り組みます。</p>
          </div>
          <a
            href={url(site, '/about/')}
            class="inline-flex items-center gap-2 mt-8 text-sm lg:text-base font-medium border-b border-base-content/40 pb-1 hover:border-base-content"
          >
            診療姿勢と医院概要を見る
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <figure>
          <img
            src={`${SHARED}/img-a-03.jpg`}
            alt="矯正歯科クリニックのスタッフの様子"
            width="1200"
            height="800"
            loading="lazy"
            class="w-full aspect-[3/2] object-cover rounded-lg"
          />
        </figure>
      </div>
      <ul class="mt-10 lg:mt-14 grid grid-cols-1 sm:grid-cols-3 gap-6 lg:gap-8">
        {peoplePhotos.map((p) => (
          <li>
            <figure>
              <img
                src={p.src}
                alt={p.alt}
                width="800"
                height="600"
                loading="lazy"
                class="w-full aspect-[3/2] object-cover rounded-lg"
              />
              <figcaption class="mt-3 text-sm font-medium text-base-content/85">{p.caption}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-xs text-base-content/65">院内・スタッフの写真はイメージです。</p>
    </div>
  </section>

  <!-- 7. 次に確認すること -->
  <section class="top-related bg-base-100">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="次に確認すること" align="left" />
      <ClinicRelatedLinks site={site} links={relatedLinks} />
    </div>
  </section>

  <!-- 共通末尾 -->
  <ClinicPageEnd site={site} />

  <PageTopButton />
</SiteLayout>

<style>
  /* ページ内 <style> を使う場合、prefers-reduced-motion の打ち消しを入れる。
     ただしこのページ内のアニメーションは ScrollReveal 経由（コンポーネント側が対応済み）
     なので、ページ独自 CSS にアニメーションは無い。打ち消しも不要。 */
</style>