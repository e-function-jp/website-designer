---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Card from '../../../../../components/data-display/Card.astro';
import Steps from '../../../../../components/navigation/Steps.astro';
import Accordion from '../../../../../components/data-display/Accordion.astro';
import ClinicPageIntro from '../../../../../components/sections/ClinicPageIntro.astro';
import ClinicRelatedLinks from '../../../../../components/sections/ClinicRelatedLinks.astro';
import ClinicPageEnd from '../../../../../components/sections/ClinicPageEnd.astro';
import PageTopButton from '../../../../../components/ui/PageTopButton.astro';

const SHARED = '/sites/corporate/_shared/20260915-1151';

const intro = {
  heading: 'はじめての方へ',
  description: '矯正を考え始めたばかりの方へ。相談したいことの整理から、治療計画、経過のフォローまで、初診相談を入口にした進み方をご案内します。治療方法が決まっていなくても、相談から始められます。',
  image: { src: `${SHARED}/img-a-01.jpg`, alt: '矯正歯科クリニックの受付カウンター' },
};

const concernsImage = { src: `${SHARED}/img-a-02.jpg`, alt: '初診相談でスタッフが相談者の話を聞いている' };

const concernCards = [
  {
    title: '気になっていること',
    body: '見た目、噛み合わせ、お子さまの歯並びなど、相談のきっかけをお聞かせください。',
  },
  {
    title: '治療で確認したいこと',
    body: '装置のこと、通院のこと、費用や期間のこと。疑問をメモしておくと、相談時に確認しやすくなります。',
  },
  {
    title: '生活との関わり',
    body: '学校や仕事など、通院を考えるうえで気になる事情も、相談したい内容として整理しておきましょう。',
  },
];

const qa = [
  {
    q: '治療方法を決めてから相談する必要がありますか。',
    a: '治療方法が決まっていなくても、相談から始められます。気になっていることや、確認したいことをお聞かせください。',
  },
  {
    q: '費用や治療期間は、このサイトで確認できますか。',
    a: 'このサンプルサイトには、具体的な料金や治療期間の設定がありません。金額や期間を推測せず、相談時に確認したい項目として整理してください。',
  },
  {
    q: 'このサイトから予約できますか。',
    a: 'このサイトは架空の医院を紹介するサンプルです。実際の予約は受け付けていません。『初診相談』ページで、受付状況と相談前の確認事項をご覧いただけます。',
  },
];

const relatedLinks = [
  { label: '大人の矯正', href: '/service/#adult', description: '見た目や噛み合わせを改善したい方へ。' },
  { label: '子どもの矯正', href: '/service/#child', description: 'お子さまの歯並びが気になる保護者の方へ。' },
];
---
<SiteLayout
  site={site}
  title="はじめての方へ"
  description="矯正を考え始めたばかりの方へ。相談内容の整理から治療計画、経過のフォローまで、初診相談を入口にした進み方をご案内します。"
  path="/new-patients/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: 'はじめての方へ' }]}
>
  <ClinicPageIntro heading={intro.heading} description={intro.description} image={intro.image} />

  <!-- 1. 相談前に整理したい3つのこと -->
  <section class="bg-base-100">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24 grid lg:grid-cols-[35%_65%] gap-8 lg:gap-16 items-start">
      <figure class="lg:sticky lg:top-24">
        <img
          src={concernsImage.src}
          alt={concernsImage.alt}
          width="1000"
          height="1250"
          loading="lazy"
          class="w-full aspect-[4/5] object-cover rounded-lg"
        />
      </figure>
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="うまく説明できなくても、大丈夫です。" align="left" />
        <div class="space-y-5 text-sm lg:text-base leading-loose text-base-content/85 mb-8">
          <p>歯並びや噛み合わせのどこが気になるのか、治療について何を知りたいのか。思いつくことから整理してみてください。すべての項目に答えを用意する必要はありません。</p>
        </div>
        <div class="space-y-5">
          <Card class="border border-base-300 p-6 lg:p-8">
            <p class="text-base lg:text-lg font-bold mb-2 text-primary">{concernCards[0].title}</p>
            <p class="text-sm lg:text-base leading-relaxed text-base-content/85">{concernCards[0].body}</p>
          </Card>
          <div class="grid sm:grid-cols-2 gap-5">
            <Card class="border border-base-300 p-6">
              <p class="text-base font-bold mb-2 text-primary">{concernCards[1].title}</p>
              <p class="text-sm leading-relaxed text-base-content/85">{concernCards[1].body}</p>
            </Card>
            <Card class="border border-base-300 p-6">
              <p class="text-base font-bold mb-2 text-primary">{concernCards[2].title}</p>
              <p class="text-sm leading-relaxed text-base-content/85">{concernCards[2].body}</p>
            </Card>
          </div>
        </div>
      </ScrollReveal>
    </div>
  </section>

  <!-- 2. 相談から治療後までの流れ -->
  <section class="bg-secondary">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="相談から、継続したフォローへ" align="left" />
      <div class="bg-base-100 rounded-lg p-6 lg:p-10 mb-10 lg:mb-14">
        <Steps>
          <li class="step step-primary" data-content="01">初診相談</li>
          <li class="step step-primary" data-content="02">治療計画の確認</li>
          <li class="step step-primary" data-content="03">治療と経過フォロー</li>
          <li class="step step-primary" data-content="04">保定管理</li>
        </Steps>
        <ol class="mt-8 space-y-5 text-sm lg:text-base leading-loose text-base-content/85">
          <li class="grid lg:grid-cols-[120px_1fr] gap-3 lg:gap-6 border-b border-base-300 pb-4">
            <span class="font-bold text-primary">01 初診相談</span>
            <span>気になっている歯並びや噛み合わせ、治療への希望をお聞かせください。</span>
          </li>
          <li class="grid lg:grid-cols-[120px_1fr] gap-3 lg:gap-6 border-b border-base-300 pb-4">
            <span class="font-bold text-primary">02 治療計画の確認</span>
            <span>相談した内容を踏まえ、治療について説明を受け、疑問を確認する段階です。</span>
          </li>
          <li class="grid lg:grid-cols-[120px_1fr] gap-3 lg:gap-6 border-b border-base-300 pb-4">
            <span class="font-bold text-primary">03 治療と経過フォロー</span>
            <span>治療計画に沿って進めながら、経過を確認していきます。</span>
          </li>
          <li class="grid lg:grid-cols-[120px_1fr] gap-3 lg:gap-6">
            <span class="font-bold text-primary">04 保定管理</span>
            <span>治療後も管理を継続します。当院は初診相談から保定管理まで一貫して行います。</span>
          </li>
        </ol>
      </div>

      <div class="grid lg:grid-cols-2 gap-6 lg:gap-8 mb-10">
        <Card class="border border-base-300 p-6 lg:p-8 bg-base-100">
          <p class="text-base lg:text-lg font-bold mb-3 text-primary">大人の矯正を相談する方</p>
          <p class="text-sm lg:text-base leading-relaxed text-base-content/85">
            見た目や噛み合わせで改善したいこと、治療と日常生活について気になることを整理します。
          </p>
        </Card>
        <Card class="border border-base-300 p-6 lg:p-8 bg-base-100">
          <p class="text-base lg:text-lg font-bold mb-3 text-primary">お子さまの矯正を相談する方</p>
          <p class="text-sm lg:text-base leading-relaxed text-base-content/85">
            保護者の方が気になっている歯並びや噛み合わせについて、相談内容を整理します。
          </p>
        </Card>
      </div>

      <p class="text-xs lg:text-sm text-base-content/70 leading-loose">
        ここでは診療の大きな流れを紹介しています。具体的な内容や進み方は、相談と治療計画の中で確認します。
      </p>
    </div>
  </section>

  <!-- 3. 相談前によく確認したいこと -->
  <section class="bg-base-100">
    <div class="max-w-[850px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="相談前の確認事項" align="left" />
      </ScrollReveal>
      <div class="space-y-3 mt-4">
        {qa.map((item, i) => (
          <Accordion name="new-patients-qa">
            <span slot="title">{item.q}</span>
            <p class="text-sm lg:text-base leading-loose">{item.a}</p>
          </Accordion>
        ))}
      </div>
    </div>
  </section>

  <!-- 4. 対象に合わせて詳しく見る -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="対象に合わせて詳しく見る" align="left" />
      <ClinicRelatedLinks site={site} links={relatedLinks} />
    </div>
  </section>

  <ClinicPageEnd site={site} />
  <PageTopButton />
</SiteLayout>