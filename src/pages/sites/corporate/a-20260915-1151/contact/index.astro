---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Card from '../../../../../components/data-display/Card.astro';
import Alert from '../../../../../components/data-display/Alert.astro';
import Badge from '../../../../../components/data-display/Badge.astro';
import ClinicPageIntro from '../../../../../components/sections/ClinicPageIntro.astro';
import ClinicRelatedLinks from '../../../../../components/sections/ClinicRelatedLinks.astro';
import ClinicPageEnd from '../../../../../components/sections/ClinicPageEnd.astro';
import PageTopButton from '../../../../../components/ui/PageTopButton.astro';

const SHARED = '/sites/corporate/_shared/20260915-1151';

const intro = {
  heading: '初診相談',
  description: '歯並びや噛み合わせで気になっていることを、初診相談の入口で整理します。お子さまのことを、ご自身のことも、まずは確認したい内容から。',
  image: { src: `${SHARED}/img-a-02.jpg`, alt: '初診相談でスタッフが相談者の話を聞いている' },
};

const prepareCards = [
  { title: '誰の相談についてか', body: 'ご自身の歯並びや噛み合わせについてか、お子さまの歯並びについてかを整理します。' },
  { title: '何が気になるか', body: '見た目や噛み合わせなど、相談のきっかけになったことを振り返ります。' },
  { title: '何を知りたいか', body: '治療方法、費用や期間、通院についてなど、確認したいことをまとめます。' },
];

const relatedLinks = [
  { label: 'はじめての方へ', href: '/new-patients/', description: '相談から治療までの流れを確認できます。' },
  { label: '矯正治療のご案内', href: '/service/', description: '大人・子どもの矯正と保定管理をご紹介します。' },
];
---
<SiteLayout
  site={site}
  title="初診相談"
  description="あおば矯正歯科クリニックの初診相談。歯並びや噛み合わせの相談の入口として、受付状況と相談前の確認事項をご案内します。"
  path="/contact/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: '初診相談' }]}
>
  <ClinicPageIntro heading={intro.heading} description={intro.description} image={intro.image} />

  <section class="bg-base-100">
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 pt-8 lg:pt-12 pb-4">
      <Alert variant="info">
        <p class="text-sm lg:text-base leading-loose">
          このサイトは架空の医院のサンプルです。実際の予約は受け付けていません。
        </p>
      </Alert>
    </div>
  </section>

  <!-- 1. 予約受付状況 -->
  <section id="reservation" class="bg-base-100 scroll-mt-[100px]">
    <div class="max-w-[760px] mx-auto px-5 lg:px-10 py-12 lg:py-20">
      <div class="bg-base-100 border border-base-300 rounded-lg p-6 lg:p-10 shadow-sm">
        <div class="flex items-center gap-3 mb-5">
          <Badge variant="warning">サンプルサイト</Badge>
        </div>
        <SectionTitle title="実際の予約は受け付けていません" align="left" />
        <div class="space-y-4 text-sm lg:text-base leading-loose text-base-content/85">
          <p>このページは、初診相談の入口を紹介するサンプルです。予約システムには接続しておらず、日時の選択や予約の送信はできません。氏名・電話番号・メールアドレスなどの個人情報を入力する必要はありません。</p>
          <p>相談から治療までの進み方は、『はじめての方へ』でご確認いただけます。</p>
        </div>
        <div class="mt-8 flex flex-col gap-3">
          <button
            type="button"
            class="btn btn-disabled btn-lg w-full lg:w-[240px]"
            aria-describedby="reservation-disabled-reason"
            disabled
          >
            予約受付は行っていません
          </button>
          <p id="reservation-disabled-reason" class="text-xs lg:text-sm text-base-content/65">
            ※ 架空サイトのためフォーム送信や予約処理は無効化されています。
          </p>
          <a
            href={url(site, '/new-patients/')}
            class="btn btn-primary btn-lg w-full lg:w-[240px]"
          >
            初診相談の流れを見る
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. 相談内容の整理 -->
  <section class="bg-base-200">
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="相談前に、確認したいことを整理する" align="left" />
      <p class="text-sm lg:text-base leading-loose text-base-content/85 mb-10">
        すべてを決めてから相談する必要はありません。気になっていることを短い言葉で整理しておくと、初診相談で聞きたい内容が見つけやすくなります。
      </p>
      <ul class="grid grid-cols-1 sm:grid-cols-3 gap-5 lg:gap-6">
        {prepareCards.map((c) => (
          <li>
            <Card class="border border-base-300 bg-base-100 p-6 lg:p-8 h-full">
              <p class="text-base lg:text-lg font-bold mb-3 text-primary">{c.title}</p>
              <p class="text-sm lg:text-base leading-relaxed text-base-content/85">{c.body}</p>
            </Card>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. 来院情報と情報入力について -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[760px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="来院前の情報について" align="left" />
      </ScrollReveal>
      <div class="space-y-5 text-sm lg:text-base leading-loose text-base-content/85 mt-4">
        <p>医院の所在地設定は静岡県藤枝市です。このサンプルサイトには、番地・電話番号・診療時間・休診日の設定がないため、来院用の地図や電話予約のボタンを掲載していません。</p>
        <p>予約や相談内容を送信する機能はありません。このページを閲覧しても、医院への相談受付や予約の確定にはなりません。入力・送信の扱いについては、『個人情報の取り扱い』をご確認ください。</p>
      </div>
      <div class="mt-8">
        <a
          href={url(site, '/privacy/')}
          class="inline-flex items-center gap-2 text-sm lg:text-base font-medium border-b border-base-content/40 pb-1 hover:border-base-content"
        >
          個人情報の取り扱いを読む
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- 4. 相談前に詳しく読む -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="相談前に詳しく読む" align="left" />
      <ClinicRelatedLinks site={site} links={relatedLinks} />
    </div>
  </section>

  <ClinicPageEnd site={site} isContactPage />
  <PageTopButton />
</SiteLayout>