---
import SiteLayout from '../../../../../layouts/SiteLayout.astro';
import { site } from '../_site';
import { url } from '../../../../../lib/site';
import ScrollReveal from '../../../../../components/ui/ScrollReveal.astro';
import SectionTitle from '../../../../../components/ui/SectionTitle.astro';
import Badge from '../../../../../components/data-display/Badge.astro';
import Alert from '../../../../../components/data-display/Alert.astro';
import ClinicPageIntro from '../../../../../components/sections/ClinicPageIntro.astro';
import ClinicRelatedLinks from '../../../../../components/sections/ClinicRelatedLinks.astro';
import ClinicPageEnd from '../../../../../components/sections/ClinicPageEnd.astro';
import PageTopButton from '../../../../../components/ui/PageTopButton.astro';

const SHARED = '/sites/corporate/_shared/20260915-1151';

const intro = {
  heading: 'お知らせ',
  description: '初診相談、矯正治療、予約情報に関する案内をまとめています。更新のお知らせと、いつでも確認できる常設の案内を分けて掲載し、必要な情報へ進めるようにしています。',
  image: { src: `${SHARED}/img-a-01.jpg`, alt: '矯正歯科クリニックの受付' },
};

const guides = [
  {
    id: 'first-visit',
    title: '初診相談をお考えの方へ',
    body: '歯並びや噛み合わせで気になっていることを、初診相談の入口で整理します。治療方法を決めてから相談する必要はありません。成人の方も、お子さまの歯並びが気になる保護者の方も、確認したい内容を思いつくところからまとめてみてください。',
    link: { label: '初診相談の流れを見る', href: '/new-patients/' },
  },
  {
    id: 'treatment',
    title: '矯正治療のご案内',
    body: '当院は小児から成人までの歯列矯正と噛み合わせ治療を中心に、マウスピース矯正・ワイヤー矯正・保定管理を提供しています。診療案内では、対象別の相談内容と取り扱う治療を確認できます。',
    link: { label: '矯正治療のご案内を見る', href: '/service/' },
  },
  {
    id: 'reservation-info',
    title: '予約情報について',
    body: 'このサイトは架空の医院を紹介するサンプルであり、実際の初診相談は予約できません。『初診相談』ページに受付状況と相談前の確認事項を掲載しています。個人情報を入力・送信する必要はありません。',
    link: { label: '予約受付状況を確認する', href: '/contact/#reservation' },
  },
];

const relatedLinks = [
  { label: '当院について', href: '/about/', description: '医院の診療姿勢と概要をご確認いただけます。' },
  { label: 'はじめての方へ', href: '/new-patients/', description: '初診相談の前に確認したいことをまとめています。' },
];
---
<SiteLayout
  site={site}
  title="お知らせ"
  description="あおば矯正歯科クリニックのお知らせ。初診相談、矯正治療、予約受付に関する常設の案内と更新情報をお伝えします。"
  path="/news/"
  breadcrumbs={[{ label: 'ホーム', href: '/' }, { label: 'お知らせ' }]}
>
  <ClinicPageIntro heading={intro.heading} description={intro.description} image={intro.image} />

  <!-- 1. 更新情報の状態 -->
  <section class="bg-base-100">
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="更新のお知らせ" align="left" />
        <Alert variant="info">
          <div class="space-y-3 text-sm lg:text-base leading-loose">
            <p>現在、日付付きのお知らせは掲載していません。下の『常設のご案内』から、初診相談の流れや診療内容、予約受付状況をご確認いただけます。</p>
            <p class="text-xs lg:text-sm">このサンプルサイトでは、診療日や休診日、臨時の予定変更は案内していません。診療カレンダーや予約の空き状況を確認するためのページではありません。</p>
          </div>
        </Alert>
      </ScrollReveal>
    </div>
  </section>

  <!-- 2. 常設のご案内3件 -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[900px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <ScrollReveal animation="fade-up" duration={site.motion!.durationMs}>
        <SectionTitle title="常設のご案内" align="left" />
      </ScrollReveal>
      <ul class="mt-4 space-y-12">
        {guides.map((g) => (
          <li id={g.id} class="scroll-mt-[100px] border-t border-base-300 pt-10">
            <div class="flex items-center gap-3 mb-4">
              <Badge variant="outline">常設案内</Badge>
              <h3 class="text-lg lg:text-xl font-bold">{g.title}</h3>
            </div>
            <p class="text-sm lg:text-base leading-loose text-base-content/85 mb-5">{g.body}</p>
            <a
              href={url(site, g.link.href)}
              class="inline-flex items-center gap-2 text-sm lg:text-base font-medium border-b border-base-content/40 pb-1 hover:border-base-content"
            >
              {g.link.label}
              <span aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- 3. 必要な情報へ進む -->
  <section class="bg-base-100 border-t border-base-300">
    <div class="max-w-[1100px] mx-auto px-5 lg:px-10 py-16 lg:py-24">
      <SectionTitle title="必要な情報へ進む" align="left" />
      <ClinicRelatedLinks site={site} links={relatedLinks} />
    </div>
  </section>

  <ClinicPageEnd site={site} />
  <PageTopButton />
</SiteLayout>