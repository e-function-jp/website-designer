---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  collectSamples,
  SITE_TYPES,
  type SampleEntry,
  type SiteTypeMeta,
} from '../lib/sample-index';

/**
 * サンプルサイトの索引トップ。
 *
 * サイト種別ごとに1枚のカードを出す。クリック先は `/sites/{type}/`
 * （個別サンプル一覧）。`src/pages/sites/[type]/index.astro` を新設した
 * のでカードから直接サンプルへ飛ばない。
 *
 * 種別ラベル / 説明は docs/site-types.json（正本: scripts/site_categories.py）
 * から取る。ハードコードしない。
 *
 * 1 サイト = 複数ページ。種別カードのメタには合計ページ数も添える。
 */
const samples = collectSamples();

interface TypeGroup {
  meta: SiteTypeMeta;
  entries: SampleEntry[];
  /** 種別内の総ページ数（参考値） */
  totalPages: number;
}

const typeGroups: TypeGroup[] = SITE_TYPES
  .map((t) => {
    const entries = samples.filter((s) => s.type === t.id);
    return {
      meta: t,
      entries,
      totalPages: entries.reduce((sum, s) => sum + s.pageCount, 0),
    };
  })
  .filter((g) => g.entries.length > 0)
  .sort((a, b) => b.entries.length - a.entries.length);

const totalSamples = samples.length;
const totalPages = samples.reduce((sum, s) => sum + s.pageCount, 0);

/** 種別の「代表サムネイル」は最も新しいサンプル（stamp 降順で先頭） */
const repThumbFor = (g: TypeGroup) => {
  const head = g.entries[0];
  return `/thumbs/${head.type}/${head.slug}.jpg`;
};
---
<BaseLayout
  title="Website Designer"
  description="website（多ページサイト）のデザインを参照学習で取り込み、静的品質チェックと独立採点の二系統で単調改善していくプロジェクト。サンプルサイト一覧とコンポーネントカタログ。"
  theme="corporate"
>
  <header class="border-b border-base-300 bg-base-100">
    <div class="max-w-6xl mx-auto px-4 h-16 flex items-center gap-6">
      <span class="text-lg font-bold">Website Designer</span>
      <nav class="ml-auto flex gap-4 text-sm" aria-label="サイト内ナビゲーション">
        <a href="/" class="link link-hover font-bold" aria-current="page">サンプル</a>
        <a href="/components/" class="link link-hover">コンポーネント</a>
      </nav>
    </div>
  </header>

  <main id="main" class="max-w-6xl mx-auto px-4 py-12 md:py-16 space-y-16">
    <section class="space-y-4">
      <h1 class="text-3xl md:text-4xl font-bold">Website Designer</h1>
      <p class="text-base-content/80 leading-relaxed max-w-3xl">
        website（多ページサイト）のデザインを参照学習で取り込み、静的品質チェックと独立採点の
        二系統で単調改善していくプロジェクトです。LP に特化した
        <code class="text-sm">lp-designer</code> の姉妹プロジェクトで、
        評価の主語が「1ページのコンバージョン」ではなく「サイト全体の情報設計」である点が異なります。
      </p>
      <p class="text-sm text-base-content/60 tabular-nums">
        現在 {totalSamples} サイト / {totalPages} ページ / {typeGroups.length} 種別 /
        コンポーネントカタログは <a href="/components/" class="link">/components</a>
      </p>
    </section>

    <section class="space-y-6">
      <h2 class="sr-only">サイト種別</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {typeGroups.map((g) => (
          <a
            href={`/sites/${g.meta.id}/`}
            class="card bg-base-100 border border-base-300 shadow-sm hover:shadow-md hover:border-primary/50 transition-all"
          >
            <figure class="aspect-[16/10] overflow-hidden bg-base-200">
              <img
                src={repThumbFor(g)}
                alt={`${g.meta.label}の最新サンプルのファーストビュー`}
                width="1280"
                height="800"
                loading="lazy"
                class="h-full w-full object-cover object-top"
              />
            </figure>
            <div class="card-body p-5 space-y-2">
              <h3 class="card-title text-base leading-snug">{g.meta.label}</h3>
              <p class="text-sm text-base-content/70 line-clamp-3">{g.meta.description}</p>
              <p class="text-xs text-base-content/50 tabular-nums pt-1">
                {g.entries.length} サイト / {g.totalPages} ページ
              </p>
            </div>
          </a>
        ))}
      </div>

      {typeGroups.length === 0 && (
        <p class="text-base-content/60">
          サンプルサイトがまだありません。<code class="text-sm">docs/learning-pipeline.md</code> の手順でランを作成してください。
        </p>
      )}
    </section>
  </main>

  <footer class="border-t border-base-300 mt-8">
    <div class="max-w-6xl mx-auto px-4 py-6 text-sm text-base-content/60 flex flex-wrap gap-4">
      <span>計 {totalSamples} サイト</span>
      <span aria-hidden="true">/</span>
      <span>計 {totalPages} ページ</span>
      <span aria-hidden="true">/</span>
      <a href="/components/" class="link link-hover">コンポーネントカタログ</a>
      <span class="ml-auto">種別: {typeGroups.map((g) => `${g.meta.label}(${g.entries.length})`).join(' / ')}</span>
    </div>
  </footer>
</BaseLayout>